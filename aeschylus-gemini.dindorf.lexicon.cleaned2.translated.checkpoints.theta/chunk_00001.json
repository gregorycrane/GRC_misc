{"units": [{"id": "thalpo-quote3", "translation": "For Zeus has been warmed by the arrow of desire for you"}, {"id": "thalpo-word1", "translation": "they warm secretly"}, {"id": "thambeos-orth1", "translation": "to be astounded"}, {"id": "thambeos-def1", "translation": "to be astounded"}, {"id": "thambeos-quote1", "translation": "I was astounded at the portent"}, {"id": "thamnos-orth1", "translation": "thicket"}, {"id": "thamnos-def1", "translation": "thicket"}, {"id": "thamnos-quote1", "translation": "I do not lament, like a bird in a thicket, out of fear"}, {"id": "thanasimos-orth1", "translation": "deadly, bringing death"}, {"id": "thanasimos-def1", "translation": "deadly, bringing death"}, {"id": "thanasimos-quote1", "translation": "deadly – the black blood of a man"}, {"id": "thanasimos-quote2", "translation": "deadly fortunes"}, {"id": "thanasimos-quote3", "translation": "deadly lament"}, {"id": "thanatephoros-orth1", "translation": "death-bringing"}, {"id": "thanatephoros-def1", "translation": "death-bringing"}, {"id": "thanatephoros-quote1", "translation": "death-bringing fate"}, {"id": "thanatos-orth1", "translation": "Death (personified); death"}, {"id": "thanatos-def1", "translation": "Death (the god)"}, {"id": "thanatos-def2", "translation": "death"}, {"id": "thanatos-def3", "translation": "in the plural"}, {"id": "thanatos-note1", "translation": "in a verse added from elsewhere: ἄτης ἄρουρα θάνατον ἐκκαρπίζεται [the field of ruin harvests death]."}, {"id": "thanatos-note2", "translation": "ἐπῇ [may come upon] Weilius"}, {"id": "thanatos-quote1", "translation": "For alone of the gods Death does not desire gifts"}, {"id": "thanatos-quote2", "translation": "O Death, Healer, do not dishonor me by coming"}, {"id": "thanatos-quote3", "translation": "And for two brothers of the same blood, death thus self-inflicted"}, {"id": "thanatos-quote4", "translation": "the end of death"}, {"id": "thanatos-quote5", "translation": "he chose death in the city"}, {"id": "thanatos-quote6", "translation": "Would that, Zeus, he had covered me too by the fate of death"}, {"id": "thanatos-quote7", "translation": "do not pray for any share of death"}, {"id": "thanatos-quote8", "translation": "breathing out his life in impious death"}, {"id": "thanatos-quote9", "translation": "I think that death for him was not ignoble"}, {"id": "thanatos-quote10", "translation": "having paid with sword-destroying death for what he did"}, {"id": "thanatos-quote11", "translation": "they conspired for death against the wretched father"}, {"id": "thanatos-quote12", "translation": "you were done to death by a hateful death"}, {"id": "thanatos-quote13", "translation": "where death is absent"}, {"id": "thanatos-quote14", "translation": "death is more glorious than a wretched life"}, {"id": "thanatos-quote15", "translation": "that mortals do not justly hate death"}, {"id": "thanatos-quote16", "translation": "death is preferable to a wretched life"}, {"id": "thanatos-quote17", "translation": "they found wretched deaths"}, {"id": "thanatos-quote18", "translation": "curses of deaths in requital"}, {"id": "thanatos-quote19", "translation": "penalties for other deaths"}, {"id": "thanatos-quote20", "translation": "by deaths of murderers"}, {"id": "thanatos-quote21", "translation": "by the deaths of masters"}, {"id": "thanatos-word1", "translation": "death"}, {"id": "thanatos-word2", "translation": "the field of ruin harvests death"}, {"id": "thanatos-word3", "translation": "may come upon"}, {"id": "thanatophoros-orth1", "translation": "death-bringing"}, {"id": "thanatophoros-def1", "translation": "death-bringing"}, {"id": "thanatophoros-quote1", "translation": "woeful death-bringing sufferings"}, {"id": "thanatoo-orth1", "translation": "to put to death"}, {"id": "thanatoo-def1", "translation": "to put to death"}, {"id": "thanatoo-quote1", "translation": "he will not put me to death at any rate"}, {"id": "thapto-orth1", "translation": "to bury"}, {"id": "thapto-def1", "translation": "to bury"}, {"id": "thapto-note1", "translation": "thus Ahrensius for τέθαψαι [you have been buried]"}, {"id": "thapto-quote1", "translation": "Eteocles – it seemed good to bury him in the dear earth of his land"}, {"id": "thapto-quote2", "translation": "I will bury him, and I will cast myself into danger, having buried my brother"}, {"id": "thapto-quote3", "translation": "I will bury this man"}, {"id": "thapto-quote4", "translation": "who will bury him?"}, {"id": "thapto-quote5", "translation": "you dared to bury a man without lamentation"}, {"id": "thapto-quote6", "translation": "thus he buries"}, {"id": "thapto-quote7", "translation": "whether the opinion of friends will prevail to bring him back, or to bury him"}, {"id": "thapto-quote8", "translation": "to have been buried by the stream of Scamander"}, {"id": "thapto-quote9", "translation": "this man, buried dishonorably by birds, seems to receive his honor"}, {"id": "thapto-word1", "translation": "you have been buried"}, {"id": "tharsaleos-orth1", "translation": "bold, confident"}, {"id": "tharsaleos-def1", "translation": "bold, confident"}, {"id": "tharsaleos-quote1", "translation": "it is sweet to stretch out a long life with bold hopes"}, {"id": "tharseo-orth1", "translation": "to be confident, to be of good courage"}, {"id": "tharseo-def1", "translation": "to be confident, to be of good courage"}, {"id": "tharseo-quote1", "translation": "in the face of this, let him now sit confident"}, {"id": "tharseo-quote2", "translation": "take courage, children raised by mothers"}, {"id": "tharseo-quote3", "translation": "boast confidently"}, {"id": "tharseo-quote4", "translation": "the man spoke confidently to the man"}, {"id": "tharseo-quote5", "translation": "but you, be confident"}, {"id": "tharseo-quote6", "translation": "take courage, children"}, {"id": "tharseo-quote7", "translation": "take courage"}, {"id": "tharseo-quote8", "translation": "nor in anchorages do the shepherds of ships take courage immediately"}, {"id": "tharseo-quote9", "translation": "take courage"}, {"id": "tharseo-quote10", "translation": "and because of my fruit, take good courage"}, {"id": "tharseo-quote11", "translation": "take courage, for time does not have the peak of toil"}, {"id": "tharsos-orth1", "translation": "courage, confidence"}, {"id": "tharsos-def1", "translation": "courage, confidence"}, {"id": "tharsos-def2", "translation": "that which gives courage"}, {"id": "tharsos-quote1", "translation": "take courage, a working device will be at hand"}, {"id": "tharsos-quote2", "translation": "persuasive courage sits on the dear throne of the mind"}, {"id": "tharsos-quote3", "translation": "there is no courage in these things"}, {"id": "tharsos-quote4", "translation": "she who knows these things best and what is saving for the city, and courage for this army being fortified"}, {"id": "tharsos-quote5", "translation": "raise a holy, kindly cry of triumph – courage for friends"}, {"id": "tharsyno-orth1", "translation": "to encourage, to give courage"}, {"id": "tharsyno-def1", "translation": "to encourage, to give courage"}, {"id": "tharsyno-quote1", "translation": "we do not wish, mother, either to frighten you too much with words or to encourage you"}, {"id": "tharybis-orth1", "translation": "Tharybis"}, {"id": "tharybis-def1", "translation": "a Persian proper name"}, {"id": "thateron-orth1", "translation": "the other (of two)"}, {"id": "thateron-def1", "translation": "See ἕτερος."}, {"id": "thateron-word1", "translation": "the other (of two)"}, {"id": "thauma-orth1", "translation": "wonder, marvel"}, {"id": "thauma-def1", "translation": "wonder"}, {"id": "thauma-def2", "translation": "marvel"}, {"id": "thauma-note1", "translation": "Thus Triclinius for θραύματ᾽ [fragments]."}, {"id": "thauma-note2", "translation": "correctly σε [you] Auratus"}, {"id": "thauma-quote1", "translation": "I fear nothing; it is no wonder to be distressed by fear in my mind"}, {"id": "thauma-quote2", "translation": "wonders for me to hear"}]}