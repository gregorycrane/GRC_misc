{"units": [{"id": "theos-quote189", "translation": "It is said that the gods abandon the captured city"}, {"id": "theos-quote190", "translation": "calling upon the gods"}, {"id": "theos-quote191", "translation": "that the gods are allies"}, {"id": "theos-quote192", "translation": "dishonoring the gods"}, {"id": "theos-quote193", "translation": "and they will bring together hostile gods upon their shields"}, {"id": "theos-quote194", "translation": "the native gods"}, {"id": "theos-quote195", "translation": "fearful is he who reveres the gods"}, {"id": "theos-quote196", "translation": "he calls upon the gods of his race"}, {"id": "theos-quote197", "translation": "supplicating the gods with prayers"}, {"id": "theos-quote198", "translation": "but someone who previously thought the gods were nowhere"}, {"id": "theos-quote199", "translation": "I prayed to the gods to accomplish these things"}, {"id": "theos-quote200", "translation": "I ask the gods for release from these toils"}, {"id": "theos-quote201", "translation": "I am preparing to address the gods well"}, {"id": "theos-quote202", "translation": "someone said that the gods do not deign to care for mortals"}, {"id": "theos-quote203", "translation": "to the city and the gods"}, {"id": "theos-quote204", "translation": "indeed, it is necessary to honor the gods with these"}, {"id": "theos-quote205", "translation": "the gods from above watch over the sorrows of the earth"}, {"id": "theos-quote206", "translation": "I begin my prayers with these gods"}, {"id": "theos-quote207", "translation": "entreat the gods of the land with prayers"}, {"id": "theos-quote208", "translation": "they will appease the gods"}, {"id": "theos-quote209", "translation": "may they always honor the gods"}, {"id": "theos-quote210", "translation": "call upon the gods"}, {"id": "theos-quote211", "translation": "blessed gods"}, {"id": "theos-quote212", "translation": "O Zeus and Earth and gods who protect the city"}, {"id": "theos-quote213", "translation": "O gods!"}, {"id": "theos-quote214", "translation": "O, O gods who protect the land"}, {"id": "theos-quote215", "translation": "O all-powerful gods"}, {"id": "theos-quote216", "translation": "gods of the city"}, {"id": "theos-quote217", "translation": "gods born of Zeus"}, {"id": "theos-quote218", "translation": "gods born of Zeus, hear me"}, {"id": "theos-quote219", "translation": "O gods who protect the city"}, {"id": "theos-quote220", "translation": "gods who hear just prayers"}, {"id": "theos-quote221", "translation": "hear, gods of one mind"}, {"id": "theos-quote222", "translation": "both the highest gods and the heavily honored gods below"}, {"id": "theos-quote223", "translation": "gods of our race, hear"}, {"id": "theos-quote224", "translation": "the gods beneath the earth"}, {"id": "theos-quote225", "translation": "the younger gods"}, {"id": "theos-quote226", "translation": "the tyrant of the gods"}, {"id": "theos-quote227", "translation": "consider all enemies of the gods as more"}, {"id": "theos-quote228", "translation": "the altars of the city-protecting gods"}, {"id": "theos-quote229", "translation": "to the city-protecting gods"}, {"id": "theos-quote230", "translation": "announcing to the gods prayers that bring fulfillment"}, {"id": "theos-quote231", "translation": "both among the younger and the older gods"}, {"id": "theos-quote232", "translation": "the younger gods"}, {"id": "theos-quote233", "translation": "I hate all the gods"}, {"id": "theos-quote234", "translation": "the city-protecting gods"}, {"id": "theos-quote235", "translation": "I address all the gods of the assembly"}, {"id": "theos-quote236", "translation": "we call upon the gods who know"}, {"id": "theos-quote237", "translation": "he does not revere the gods at all"}, {"id": "theos-quote238", "translation": "the goddess who destroys the house"}, {"id": "theos-quote239", "translation": "and a god hears even from afar"}, {"id": "theos-quote240", "translation": "such a shoot as no god could produce"}, {"id": "theos-quote241", "translation": "ancient goddess"}, {"id": "theos-quote242", "translation": "Argive goddess"}, {"id": "theos-quote243", "translation": "wily-minded goddess"}, {"id": "theos-quote244", "translation": "slaying bulls for the gods"}, {"id": "theos-quote245", "translation": "you were the consort of a god, and of a god you were also the mother"}, {"id": "theos-quote246", "translation": "when the gods receive sacrifice from their hands"}, {"id": "theos-quote247", "translation": "deception of a god"}, {"id": "theos-quote248", "translation": "blessed gods"}, {"id": "theos-quote249", "translation": "from the gods"}, {"id": "theos-word1", "translation": "god (M)"}, {"id": "theos-word2", "translation": "god"}, {"id": "theos-word3", "translation": "to the gods"}, {"id": "theos-word4", "translation": "gods"}, {"id": "theos-word5", "translation": "the seats of the gods"}, {"id": "theos-word6", "translation": "or goddess"}, {"id": "theos-word7", "translation": "being a god"}, {"id": "theos-word8", "translation": "being a goddess"}, {"id": "theos-word9", "translation": "god"}, {"id": "theos-word10", "translation": "gods"}, {"id": "theos-word11", "translation": "Io"}, {"id": "theossytos-orth1", "translation": "sent by a god"}, {"id": "theossytos-def1", "translation": "See θεόσυτος."}, {"id": "theossytos-word1", "translation": "sent by a god"}, {"id": "theostygetos-orth1", "translation": "hated by the gods"}, {"id": "theostygetos-def1", "translation": "hated by the gods"}, {"id": "theostygetos-quote1", "translation": "and the race of mortals, dishonored by god-hated grief, is gone"}, {"id": "theosytos-orth1", "translation": "sent by a god"}, {"id": "theosytos-def1", "translation": "sent by a god"}, {"id": "theosytos-def2", "translation": "θεόσσυτος"}, {"id": "theosytos-quote1", "translation": "sent by a god, or mortal, or mixed"}, {"id": "theosytos-quote2", "translation": "and you named a god-sent disease"}, {"id": "theosytos-quote3", "translation": "a god-sent storm"}, {"id": "theosytos-word1", "translation": "sent by a god"}, {"id": "theotimetos-orth1", "translation": "honored by the gods"}, {"id": "theotimetos-def1", "translation": "honored by the gods"}, {"id": "theotimetos-quote1", "translation": "and honored by the gods he comes home"}, {"id": "theotreptos-orth1", "translation": "turned by the gods"}, {"id": "theotreptos-def1", "translation": "turned by the gods"}, {"id": "theotreptos-quote1", "translation": "these things, turned by the gods, we bring"}, {"id": "theophiles-orth1", "translation": "dear to the gods"}, {"id": "theophiles-def1", "translation": "dear to the gods"}, {"id": "theophiles-quote1", "translation": "my fortunes dear to the gods"}, {"id": "theophiles-quote2", "translation": "to share in this land most dear to the gods"}, {"id": "theophoretos-orth1", "translation": "inspired by divine will"}, {"id": "theophoretos-def1", "translation": "inspired by divine will"}, {"id": "theophoretos-quote1", "translation": "you are mad in mind, or god-inspired"}, {"id": "theophoros-orth1", "translation": "bearing a god"}, {"id": "theophoros-def1", "translation": "bearing a god"}, {"id": "theophoros-def2", "translation": "who is moved by divine impulse, inspired by the deity"}, {"id": "theophoros-note1", "translation": "Hermann deletes τ᾽ [and]. Unless here too θεοφόρος [bearing a god] means 'bearing a god within oneself'."}, {"id": "theophoros-quote1", "translation": "and indeed it is necessary to bring water for washing the feet of the god-bearing"}, {"id": "theophoros-quote2", "translation": "whence do you have rushing and god-borne vain miseries"}, {"id": "theophoros-word1", "translation": "and"}, {"id": "theophoros-word2", "translation": "bearing a god"}, {"id": "therapontis-orth1", "translation": "of a servant"}, {"id": "therapontis-def1", "translation": "of a servant"}, {"id": "therapontis-quote1", "translation": "a servant's dowry"}, {"id": "therizo-orth1", "translation": "to reap"}, {"id": "therizo-def1", "translation": "to reap"}, {"id": "therizo-quote1", "translation": "the one who reaps mortals with plows among others"}, {"id": "thermaino-orth1", "translation": "to warm"}, {"id": "thermaino-def1", "translation": "to warm"}]}