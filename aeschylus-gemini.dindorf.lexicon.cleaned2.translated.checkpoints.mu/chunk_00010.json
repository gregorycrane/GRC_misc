{"units": [{"id": "megas-quote63", "translation": "I will take away a great care."}, {"id": "megas-quote64", "translation": "I will tell you a great proof of these things."}, {"id": "megas-quote65", "translation": "a great ordinance"}, {"id": "megas-quote66", "translation": "I will build a great army."}, {"id": "megas-quote67", "translation": "a great calamity arises"}, {"id": "megas-quote68", "translation": "great and ill-tempered divinities"}, {"id": "megas-quote69", "translation": "a great gain"}, {"id": "megas-quote70", "translation": "great, ambitious children of Night"}, {"id": "megas-quote71", "translation": "the great seed of a revered mother"}, {"id": "megas-quote72", "translation": "to raise a great war"}, {"id": "megas-quote73", "translation": "a great craftsman"}, {"id": "megas-quote74", "translation": "great wrath"}, {"id": "megas-quote75", "translation": "great Zeus"}, {"id": "megas-quote76", "translation": "the great Nile"}, {"id": "megas-quote77", "translation": "the great mind of Zeus is not to be transgressed"}, {"id": "megas-quote78", "translation": "great Zeus"}, {"id": "megas-quote79", "translation": "the great quickly swallows the lesser"}, {"id": "megas-quote80", "translation": "the great boundary of Europe and Asia, the Phasis"}, {"id": "megas-quote81", "translation": "a great avenger"}, {"id": "megas-quote82", "translation": "there is no time when I might allot a greater portion"}, {"id": "megas-quote83", "translation": "greater than what was said before"}, {"id": "megas-quote84", "translation": "a joy greater than hope"}, {"id": "megas-quote85", "translation": "so that, like a wave, it surges (thus Auratus for κλύειν [to hear]) toward the light (ἀκτάς [shores] Auratus) of this (πῆμα [calamity] Engerus) calamity, much greater."}, {"id": "megas-quote86", "translation": "you speak of things greater than great fortune and beyond the north wind"}, {"id": "megas-quote87", "translation": "it is greater than an oath"}, {"id": "megas-quote88", "translation": "the matter is greater"}, {"id": "megas-quote89", "translation": "thus strength, greater, increases for mortals"}, {"id": "megas-quote90", "translation": "γε μείζω [at least greater] corrupt from γεμίζων [loading], which see"}, {"id": "megas-quote91", "translation": "if there is any greater favor"}, {"id": "megas-quote92", "translation": "for I will suffer nothing greater than this. The comparative form μειζονώτερος [more greater] is recorded from Aeschylus and compared with similar comparatives by the grammarians cited at fr. 351."}, {"id": "megas-quote93", "translation": "successors of the greatest toils"}, {"id": "megas-quote94", "translation": "the greatest thing"}, {"id": "megas-quote95", "translation": "to obtain the greatest marriage"}, {"id": "megas-quote96", "translation": "the greatest assault, the Achaean"}, {"id": "megas-quote97", "translation": "the greatest teacher of evils to Argos"}, {"id": "megas-quote98", "translation": "a very great deed has been accomplished"}, {"id": "megas-quote99", "translation": "the greatest gift of a god"}, {"id": "megas-quote100", "translation": "greatest herald"}, {"id": "megas-quote101", "translation": "the greatest witness of all to Zeus"}, {"id": "megas-quote102", "translation": "and the attendant of the greatest chthonic rulers there"}, {"id": "megas-quote103", "translation": "with the greatest winepress"}, {"id": "megas-quote104", "translation": "I have the greatest blame"}, {"id": "megas-quote105", "translation": "Libya, enjoying the name of the greatest land"}, {"id": "megas-quote106", "translation": "to Hermes, the greatest patron and tracker"}, {"id": "megas-quote107", "translation": "death, which is the greatest deliverance from many evils"}, {"id": "megas-quote108", "translation": "the greatest prize"}, {"id": "megas-quote109", "translation": "from the greatest purifications easily"}, {"id": "megas-quote110", "translation": "O greatly blessed maiden"}, {"id": "megas-quote111", "translation": "the greatly hated one"}, {"id": "megas-quote112", "translation": "he groans greatly, I think"}, {"id": "megas-quote113", "translation": "he is greatly strong"}, {"id": "megas-quote114", "translation": "greatly mocked (thus Herm. for μετά [with]) by enemies instead of friends"}, {"id": "megas-quote115", "translation": "they luxuriate greatly"}, {"id": "megas-quote116", "translation": "greatly honoring you"}, {"id": "megas-quote117", "translation": "Justice cries out greatly"}, {"id": "megas-quote118", "translation": "they greatly revere"}, {"id": "megas-quote119", "translation": "having greatly winked at you"}, {"id": "megas-quote120", "translation": "speaking loudly"}, {"id": "megas-quote121", "translation": "for he is greatly powerful"}, {"id": "megas-quote122", "translation": "greatly honoring"}, {"id": "megas-quote123", "translation": "having greatly filled with cargo"}, {"id": "megas-quote124", "translation": "breathing Ares more than is just"}, {"id": "megas-quote125", "translation": "Alas, great and unfortunate maidens"}, {"id": "megas-word1", "translation": "greater"}, {"id": "megas-word2", "translation": "greatest"}, {"id": "megas-word3", "translation": "greater"}, {"id": "megas-word4", "translation": "greatest"}, {"id": "megas-word5", "translation": "greatly"}, {"id": "megastenes-orth1", "translation": "mighty"}, {"id": "megastenes-def1", "translation": "mighty"}, {"id": "megastenes-quote1", "translation": "the mighty Erinys of my father"}, {"id": "megastenes-quote2", "translation": "black Erinys, you are a mighty one"}, {"id": "megastenes-quote3", "translation": "the mighty oracle of Loxias"}, {"id": "megastenes-quote4", "translation": "let it be a care to mighty Loxias"}, {"id": "megauches-orth1", "translation": "boastful"}, {"id": "megauches-def1", "translation": "boastful"}, {"id": "megauches-quote1", "translation": "about the dead Darius, a boastful divinity"}, {"id": "megethos-orth1", "translation": "greatness"}, {"id": "megethos-def1", "translation": "greatness"}, {"id": "megethos-quote1", "translation": "and in size far the most outstanding of those now"}, {"id": "megistos-orth1", "translation": "greatest"}, {"id": "megistos-def1", "translation": "See μέγας."}, {"id": "megistos-word1", "translation": "great"}, {"id": "megistotimos-orth1", "translation": "most honored"}, {"id": "megistotimos-def1", "translation": "most honored"}, {"id": "megistotimos-quote1", "translation": "in the ordinances of Justice it is written as most honored"}, {"id": "medon-orth1", "translation": "ruler"}, {"id": "medon-def1", "translation": "ruler. Of the leader of an army"}, {"id": "medon-quote1", "translation": "and seven valiant rulers of the army, with spear-shaking array, stand before the gates, each at his gate, having obtained by lot. Thus Heimsoethius for ἀγήνορες πρέποντες στρατοῦ πύλαις ἑβδόμαις π . π . λ ."}, {"id": "metharmozo-orth1", "translation": "to change, alter"}]}