{"units": [{"id": "megairo-quote1", "translation": "But I do not begrudge you this gift."}, {"id": "megalaucheo-orth1", "translation": "to boast greatly"}, {"id": "megalaucheo-def1", "translation": "to boast greatly, to glory"}, {"id": "megalaucheo-quote1", "translation": "Let no one boast greatly in Hades."}, {"id": "megalauchos-orth1", "translation": "boasting greatly"}, {"id": "megalauchos-def1", "translation": "boasting greatly"}, {"id": "megalauchos-quote1", "translation": "The great-boasting and death-bringing Keres."}, {"id": "megalauchos-quote2", "translation": "Of the Persians, great-boasting and with many men."}, {"id": "megalegoros-orth1", "translation": "boastful, vaunting"}, {"id": "megalegoros-def1", "translation": "boastful, vaunting"}, {"id": "megalegoros-quote1", "translation": "Hearing great things from great-talking impious men."}, {"id": "megalometis-orth1", "translation": "of great counsel"}, {"id": "megalometis-def1", "translation": "of great counsel"}, {"id": "megalometis-quote1", "translation": "You are of great counsel."}, {"id": "megalostonos-orth1", "translation": "greatly lamentable"}, {"id": "megalostonos-def1", "translation": "greatly lamentable"}, {"id": "megalostonos-quote1", "translation": "With your greatly lamentable sufferings."}, {"id": "megaloschemon-orth1", "translation": "magnificent"}, {"id": "megaloschemon-def1", "translation": "magnificent"}, {"id": "megaloschemon-quote1", "translation": "Magnificent and ancient-looking honor."}, {"id": "megalynomai-orth1", "translation": "to be exalted"}, {"id": "megalynomai-def1", "translation": "to be exalted"}, {"id": "megalynomai-quote1", "translation": "Of those who are exalted by their birth."}, {"id": "megalos_adv-orth1", "translation": "greatly"}, {"id": "megalos_adv-def1", "translation": "greatly"}, {"id": "megalos_adv-quote1", "translation": "Subdued greatly by sea-borne blows."}, {"id": "megalos_adv-quote2", "translation": "The Persian empire has perished greatly. Thus Hermannus for μεγάλατε."}, {"id": "megareus-orth1", "translation": "Megareus"}, {"id": "megareus-def1", "translation": "Megareus, leader of the Thebans"}, {"id": "megareus-quote1", "translation": "Megareus, offspring of Creon."}, {"id": "megas-orth1", "translation": "great"}, {"id": "megas-def1", "translation": "with comparative μείζων and superlative μέγιστος) great."}, {"id": "megas-def2", "translation": "Comparative μείζων"}, {"id": "megas-def3", "translation": "Superlative μέγιστος"}, {"id": "megas-def4", "translation": "μέγα adverbially, greatly."}, {"id": "megas-def5", "translation": "Comparative Pr. 1013"}, {"id": "megas-def6", "translation": "In the plural number"}, {"id": "megas-quote1", "translation": "A great passage."}, {"id": "megas-quote2", "translation": "A great benefit."}, {"id": "megas-quote3", "translation": "A great word."}, {"id": "megas-quote4", "translation": "To the great bosom of Rhea."}, {"id": "megas-quote5", "translation": "A great rag of a body."}, {"id": "megas-quote6", "translation": "Great griefs."}, {"id": "megas-quote7", "translation": "The great manner."}, {"id": "megas-quote8", "translation": "Who boasts great things for the city."}, {"id": "megas-quote9", "translation": "A great figure."}, {"id": "megas-quote10", "translation": "Hearing great things from great-talking men."}, {"id": "megas-quote11", "translation": "A great prophet."}, {"id": "megas-quote12", "translation": "A great abomination of the gods."}, {"id": "megas-quote13", "translation": "Deprived of the great plains."}, {"id": "megas-quote14", "translation": "O great Zeus."}, {"id": "megas-quote15", "translation": "Subjects of the great king, of the king of the Persians, who was called thus by excellence."}, {"id": "megas-quote16", "translation": "The great and many-nurturing Nile."}, {"id": "megas-quote17", "translation": "Great Arsames."}, {"id": "megas-quote18", "translation": "With a great stream of men."}, {"id": "megas-quote19", "translation": "The great city of Susa."}, {"id": "megas-quote20", "translation": "Great wealth."}, {"id": "megas-quote21", "translation": "A great light."}, {"id": "megas-quote22", "translation": "The great sea has broken."}, {"id": "megas-quote23", "translation": "To close the great Bosporus."}, {"id": "megas-quote24", "translation": "A great deity came."}, {"id": "megas-quote25", "translation": "You acquired great wealth for your children."}, {"id": "megas-quote26", "translation": "May he pour out great prosperity."}, {"id": "megas-quote27", "translation": "Of great and good city-ruling life."}, {"id": "megas-quote28", "translation": "Of great honor."}, {"id": "megas-quote29", "translation": "And great Oebares."}, {"id": "megas-quote30", "translation": "A great ox has stepped on my tongue."}, {"id": "megas-quote31", "translation": "The great adversary of Priam."}, {"id": "megas-quote32", "translation": "Shouting great Ares from their hearts."}, {"id": "megas-quote33", "translation": "The great mouth of Troy."}, {"id": "megas-quote34", "translation": "With great blessings."}, {"id": "megas-quote35", "translation": "Whoever was great before."}, {"id": "megas-quote36", "translation": "And a great torch."}, {"id": "megas-quote37", "translation": "The great beard of flame."}, {"id": "megas-quote38", "translation": "Possessor of great ornaments."}, {"id": "megas-quote39", "translation": "Neither a great one nor one of the young."}, {"id": "megas-quote40", "translation": "A great net of slavery."}, {"id": "megas-quote41", "translation": "I revere Zeus, the great god of strangers."}, {"id": "megas-quote42", "translation": "The great altar of Justice."}, {"id": "megas-quote43", "translation": "A great, many-slaying destruction."}, {"id": "megas-quote44", "translation": "The great prosperity of a man that has been accomplished."}, {"id": "megas-quote45", "translation": "A new great grief, a great evil, is being devised in this house."}, {"id": "megas-quote46", "translation": "For a great oath from the gods has been fulfilled."}, {"id": "megas-quote47", "translation": "You praise a great and heavy-wrathed deity for this house."}, {"id": "megas-quote48", "translation": "In return for great deeds."}, {"id": "megas-quote49", "translation": "From a small seed a great trunk might come."}, {"id": "megas-quote50", "translation": "From a small one you might raise a great house."}, {"id": "megas-quote51", "translation": "Great grief."}, {"id": "megas-quote52", "translation": "The great Fates."}, {"id": "megas-quote53", "translation": "Of great fortune."}, {"id": "megas-quote54", "translation": "Having brought a great doom upon Aegisthus, where μέγαν μόρον is suspect, for which you would expect μέγαν πόνον or μέγαν μόθον or something similar."}, {"id": "megas-quote55", "translation": "When he had lifted him greatly."}, {"id": "megas-quote56", "translation": "O you who dwell in the great mouth."}, {"id": "megas-quote57", "translation": "The great prosperity of their fathers."}, {"id": "megas-quote58", "translation": "Having the great recess of the earth."}, {"id": "megas-quote59", "translation": "And I was deprived of the great curb of servants."}, {"id": "megas-quote60", "translation": "For he speaks greatly, seated by the throne of Zeus."}, {"id": "megas-quote61", "translation": "For great Hades is the judge of mortals."}, {"id": "megas-quote62", "translation": "A great portion."}]}