{"units": [{"id": "lego_desino-orth1", "translation": "to cease"}, {"id": "lego_desino-def1", "translation": "to cease"}, {"id": "lego_desino-quote1", "translation": "having ceased from these lamentations"}, {"id": "lego_desino-quote2", "translation": "nor will he cease"}, {"id": "lego_desino-quote3", "translation": "and I will never cease"}, {"id": "lego_desino-quote4", "translation": "the god, having prevailed over two, ceased"}, {"id": "lego_desino-quote5", "translation": "and the drizzle ceases"}, {"id": "lego_desino-quote6", "translation": "when the blazing sun with its rays ceases upon the earth"}, {"id": "lego_desino-quote7", "translation": "to cease from god-harming, with overweening boldness"}, {"id": "leda-orth1", "translation": "Leda"}, {"id": "leda-def1", "translation": "Leda"}, {"id": "leda-quote1", "translation": "offspring of Leda (Clytaemnestra)"}, {"id": "lethomai-orth1", "translation": "to forget"}, {"id": "lethomai-def1", "translation": "to forget"}, {"id": "lethomai-quote1", "translation": "I speak to those who understand, and I forget those who do not"}, {"id": "lema-orth1", "translation": "will, spirit, disposition"}, {"id": "lema-def1", "translation": "will, spirit, disposition"}, {"id": "lema-quote1", "translation": "and a fiery man is set over it, in spirit"}, {"id": "lema-quote2", "translation": "not as one without spirit, nor with baseness of will"}, {"id": "lema-quote3", "translation": "a god of spirit, changeable in long-lasting turning of fortune"}, {"id": "lema-quote4", "translation": "trusty in bow-drawing spirit"}, {"id": "lema-quote5", "translation": "warlike spirit"}, {"id": "lema-quote6", "translation": "seeing the two Atreidae equal in spirit (thus I emended for λήμασι δισσοὺς)"}, {"id": "lemma-orth1", "translation": "thing received"}, {"id": "lemma-def1", "translation": "thing received"}, {"id": "lemma-note1", "translation": "Thus Turnebus for λήματ'."}, {"id": "lemma-quote1", "translation": "receiving sacred gifts from a holy man"}, {"id": "lemma-word1", "translation": "gifts"}, {"id": "lemnios-orth1", "translation": "Lemnian"}, {"id": "lemnios-def1", "translation": "Lemnian"}, {"id": "lemnios-def2", "translation": "Λήμνιοι was the title of a play of Aeschylus recorded in the old Catalogue"}, {"id": "lemnios-note1", "translation": "Lemnian evils are spoken of proverbially because the Pelasgians in Lemnos killed the abducted Attic women along with the offspring born from them: on this see Herodotus 6, 138 and other writers cited in Thes. vol. 5 p. 255."}, {"id": "lemnios-note2", "translation": "But it was undoubtedly Λήμνιαι, as I said in the note on fr. 242."}, {"id": "lemnios-quote1", "translation": "and of evils the Lemnian takes precedence"}, {"id": "lemnios-quote2", "translation": "with Lemnian woes"}, {"id": "lemnios-word1", "translation": "Lemnians"}, {"id": "lemnios-word2", "translation": "Lemnian women"}, {"id": "lemnos-orth1", "translation": "Lemnos"}, {"id": "lemnos-def1", "translation": "Lemnos"}, {"id": "lemnos-quote1", "translation": "Lemnos and the seat of Icarus"}, {"id": "lemnos-quote2", "translation": "to the Hermaean crag of Lemnos"}, {"id": "lenos-orth1", "translation": "wool"}, {"id": "lenos-def1", "translation": "wool"}, {"id": "lenos-quote1", "translation": "a branch crowned with wool"}, {"id": "lexis-orth1", "translation": "cessation"}, {"id": "lexis-def1", "translation": "cessation"}, {"id": "lexis-quote1", "translation": "cessation and remission of toils"}, {"id": "latogenes_pr-orth1", "translation": "born of Leto (Diana)"}, {"id": "latogenes_pr-def1", "translation": "born of Leto (Diana)"}, {"id": "latogenes_pr-def2", "translation": "Doric form"}, {"id": "latogenes_pr-note1", "translation": "Thus I corrected for σύ τ᾽ ὦ Λατογένεια κούρα τόξον πτυκάζου ῎Αρτεμι φίλα."}, {"id": "latogenes_pr-quote1", "translation": "and you, dearest daughter of Zeus, born of Leto, gird up your bow"}, {"id": "latogenes_pr-word1", "translation": "and you, O Leto-born maiden, gird up your bow, dear Artemis"}, {"id": "leto-orth1", "translation": "Leto (Latona)"}, {"id": "leto-def1", "translation": "Leto (Latona)"}, {"id": "leto-note1", "translation": "In Doric Λατώ."}, {"id": "leto-quote1", "translation": "for the son of Leto (Apollo) dishonors me"}, {"id": "leto-word1", "translation": "Leto (Doric form)"}, {"id": "letoios-orth1", "translation": "of Leto, Letoian"}, {"id": "letoios-def1", "translation": "of Leto, Letoian"}, {"id": "letoios-quote1", "translation": "the starry eye of the daughter of Leto"}, {"id": "lian-orth1", "translation": "very, exceedingly"}, {"id": "lian-def1", "translation": "very, exceedingly"}, {"id": "lian-quote1", "translation": "the boast is not fabricated, but spoken all too truly"}, {"id": "lian-quote2", "translation": "because of the excessive love of mortals"}, {"id": "lian-quote3", "translation": "one should not wear one's character too swiftly"}, {"id": "libas-orth1", "translation": "drop"}, {"id": "libas-def1", "translation": "drop"}, {"id": "libas-note1", "translation": "On the genitive and accusative λι-βός and λίβα see under λίψ."}, {"id": "libas-quote1", "translation": "with watery drops from the maiden's spring"}, {"id": "libas-word1", "translation": "of a drop"}, {"id": "libas-word2", "translation": "a drop; see under λίψ"}, {"id": "libos-orth1", "translation": "drop"}, {"id": "libos-def1", "translation": "drop"}, {"id": "libos-note1", "translation": "Of tears. Compare λίπος."}, {"id": "libos-quote1", "translation": "they brought forth drops more ready than laughter"}, {"id": "libos-word1", "translation": "fat, grease"}, {"id": "libye-orth1", "translation": "Libya"}, {"id": "libye-def1", "translation": "Libya"}, {"id": "libye-quote1", "translation": "Libya, reaping the name of a very great land"}, {"id": "libyrnikos-orth1", "translation": "Liburnian"}, {"id": "libyrnikos-def1", "translation": "Liburnian"}, {"id": "libyrnikos-note1", "translation": "On the Liburnians see Thes. vol. 5 p. 276."}, {"id": "libyrnikos-quote1", "translation": "a tunic imitating a Liburnian cloak"}, {"id": "libystikos-orth1", "translation": "Libyan"}, {"id": "libystikos-def1", "translation": "Libyan"}, {"id": "libystikos-note1", "translation": "where Λιβυστικοῖς M, Λιβυστίοις in Tzetzes on Lycophron 592. Auratus corrected it."}, {"id": "libystikos-quote1", "translation": "in the regions of the Libyan land"}, {"id": "libystikos-quote2", "translation": "for you are more like Libyan women, and not at all like native ones"}, {"id": "libystikos-quote3", "translation": "the fame of Libyan tales"}, {"id": "libystikos-word1", "translation": "Libyan (dative plural) M, Libyan (dative plural)"}, {"id": "ligaino-orth1", "translation": "to sing shrilly"}, {"id": "ligaino-def1", "translation": "to sing shrilly"}, {"id": "ligaino-note1", "translation": "Of laments. Scholium: ὅτι οὐκ ἐκ ψυχῆς θρηνώ [that I do not lament from the heart]."}, {"id": "ligaino-quote1", "translation": "let no deceit make me sing shrilly not from a true heart"}, {"id": "ligaino-word1", "translation": "that I do not lament from the heart"}, {"id": "lignys-orth1", "translation": "soot, smoke"}, {"id": "lignys-def1", "translation": "soot, smoke"}, {"id": "lignys-quote1", "translation": "sending black smoke through its fire-breathing mouth"}, {"id": "ligys-orth1", "translation": "Ligurian; plural Λίγυες Ligurians"}, {"id": "ligys-def1", "translation": "Ligurian; plural Λίγυες Ligurians"}, {"id": "ligys-quote1", "translation": "you will come to the fearless army of the Ligurians"}, {"id": "ligys-quote2", "translation": "then you, having struck, will easily pursue the Ligurian army"}, {"id": "ligys-word1", "translation": "Ligurians"}, {"id": "ligys_stridulus-orth1", "translation": "shrill, clear"}]}