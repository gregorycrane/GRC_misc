{"units": [{"id": "louo-quote1", "translation": "Who could wash him?"}, {"id": "louo-quote2", "translation": "He washes himself with the second bath. On this see under λουτήριον."}, {"id": "lophos-orth1", "translation": "crest"}, {"id": "lophos-def1", "translation": "crest"}, {"id": "lophos-quote1", "translation": "He shakes three shadowy crests."}, {"id": "lophos-quote2", "translation": "Crests and bells do not bite without a spear."}, {"id": "lochagetes-orth1", "translation": "leader of a company"}, {"id": "lochagetes-def1", "translation": "leader of a company"}, {"id": "lochagetes-quote1", "translation": "impetuous leaders of companies"}, {"id": "locheomai-orth1", "translation": "to bring forth, give birth"}, {"id": "locheomai-def1", "translation": "to bring forth, give birth"}, {"id": "locheomai-note1", "translation": "In Eustathius p. 1665, 38 μνηστεύεται [is wooed], by an error of memory."}, {"id": "locheomai-quote1", "translation": "The Ister brings forth such maidens."}, {"id": "locheomai-word1", "translation": "is wooed"}, {"id": "locheuma-orth1", "translation": "birth, act of giving birth"}, {"id": "locheuma-def1", "translation": "birth, act of giving birth"}, {"id": "locheuma-quote1", "translation": "rejoicing no less than in the Zeus-sent brightness of the seed in the birth of the bud."}, {"id": "lochites-orth1", "translation": "soldier of a company"}, {"id": "lochites-def1", "translation": "soldier of a company"}, {"id": "lochites-def2", "translation": "fellow soldier, comrade"}, {"id": "lochites-quote1", "translation": "whether with fellow soldiers or alone."}, {"id": "lochites-quote2", "translation": "Come now, dear fellow soldiers."}, {"id": "lochos-orth1", "translation": "company, band"}, {"id": "lochos-def1", "translation": "company, band"}, {"id": "lochos-def2", "translation": "Improperly used of any crowd or gathering."}, {"id": "lochos-def3", "translation": "birth"}, {"id": "lochos-quote1", "translation": "so that each of them, having obtained by lot, might lead a company to the gates."}, {"id": "lochos-quote2", "translation": "to attack the Neistan gates with a company."}, {"id": "lochos-quote3", "translation": "Behold the suppliant band of maidens."}, {"id": "lochos-quote4", "translation": "A wondrous band of women sleeps."}, {"id": "lochos-quote5", "translation": "a glorious band of children and women."}, {"id": "lochos-quote6", "translation": "and in the boundless throng pray."}, {"id": "lochos-quote7", "translation": "the self-born, wretched, timid creature before birth for those sacrificing."}, {"id": "lochos-quote8", "translation": "and Artemis of the crossways to watch over the births of women."}, {"id": "lygros-orth1", "translation": "baneful, mournful, wretched"}, {"id": "lygros-def1", "translation": "baneful, mournful, wretched"}, {"id": "lygros-note1", "translation": "λυγρόν [baneful] is corrupt in M at line 47 for λύτρον [ransom]."}, {"id": "lygros-quote1", "translation": "conspicuous in mournful grief."}, {"id": "lygros-quote2", "translation": "from a loins-aching, pain-wrenching, wretched old man."}, {"id": "lygros-quote3", "translation": "favors of a baneful temper. Thus Blomfield for λυπρᾶς [wretched]."}, {"id": "lygros-word1", "translation": "baneful"}, {"id": "lygros-word2", "translation": "ransom"}, {"id": "lydios-orth1", "translation": "Lydian"}, {"id": "lydios-def1", "translation": "Lydian"}, {"id": "lydios-quote1", "translation": "Lydian hollows."}, {"id": "lydos-orth1", "translation": "Lydian"}, {"id": "lydos-def1", "translation": "Lydian"}, {"id": "lydos-quote1", "translation": "the crowd of Lydians."}, {"id": "lydos-quote2", "translation": "He acquired the people of the Lydians and Phrygians."}, {"id": "lyzo-orth1", "translation": "to hiccup"}, {"id": "lyzo-def1", "translation": "to hiccup"}]}