{"units": [{"id": "kakos-quote36", "translation": "For the wicked, when they prosper, are unbearable."}, {"id": "kakos-quote37", "translation": "There is nothing worse than bad company."}, {"id": "kakos-quote38", "translation": "Another woe worse than a woe."}, {"id": "kakos-quote39", "translation": "The burden of the present evil."}, {"id": "kakos-quote40", "translation": "Having stumbled upon this evil."}, {"id": "kakos-quote41", "translation": "Avoid the evil that is coming."}, {"id": "kakos-quote42", "translation": "A greater evil for house and city."}, {"id": "kakos-quote43", "translation": "If one should bear evil without shame."}, {"id": "kakos-quote44", "translation": "He began—the whole evil."}, {"id": "kakos-quote45", "translation": "Know that the evil is not yet at its midpoint."}, {"id": "kakos-quote46", "translation": "Lest he add some evil to evils."}, {"id": "kakos-quote47", "translation": "A new, heavy evil."}, {"id": "kakos-quote48", "translation": "What an evil he accomplished."}, {"id": "kakos-quote49", "translation": "They did not bring so great an evil upon the city."}, {"id": "kakos-quote50", "translation": "Then I became an evil to my fatherland."}, {"id": "kakos-quote51", "translation": "You made an unexpected evil."}, {"id": "kakos-quote52", "translation": "Upon the misfortune of evil."}, {"id": "kakos-quote53", "translation": "A terrible evil."}, {"id": "kakos-quote54", "translation": "An unbearable evil to friends."}, {"id": "kakos-quote55", "translation": "I liken these things to some evil."}, {"id": "kakos-quote56", "translation": "What evil—having tasted earth-nurtured food or drink?"}, {"id": "kakos-quote57", "translation": "The stranger seems to be devising evil."}, {"id": "kakos-quote58", "translation": "For here I have come to this evil."}, {"id": "kakos-quote59", "translation": "Unbearable."}, {"id": "kakos-quote60", "translation": "The better. I praise the share of evil too."}, {"id": "kakos-quote61", "translation": "Evil comes swift-footed to mortals."}, {"id": "kakos-quote62", "translation": "Who does not grieve with your evils?"}, {"id": "kakos-quote63", "translation": "And nowhere does it slacken from evils."}, {"id": "kakos-quote64", "translation": "Grieving with evils."}, {"id": "kakos-quote65", "translation": "Nor do you yield to evils."}, {"id": "kakos-quote66", "translation": "When you learn the remaining evils."}, {"id": "kakos-quote67", "translation": "Will my son deliver you from evils?"}, {"id": "kakos-quote68", "translation": "A wave of evils."}, {"id": "kakos-quote69", "translation": "You will speak of no good repute from evils and shameful deeds."}, {"id": "kakos-quote70", "translation": "In evils."}, {"id": "kakos-quote71", "translation": "To foster evils."}, {"id": "kakos-quote72", "translation": "He speaks with evils."}, {"id": "kakos-quote73", "translation": "The teacher of evils."}, {"id": "kakos-quote74", "translation": "The council chamber of these evils."}, {"id": "kakos-quote75", "translation": "Evils wrought by the spear."}, {"id": "kakos-quote76", "translation": "They could not escape evils."}, {"id": "kakos-quote77", "translation": "New toils of the house mingled with old evils."}, {"id": "kakos-quote78", "translation": "A sea of evils."}, {"id": "kakos-quote79", "translation": "He accomplished twin evils."}, {"id": "kakos-quote80", "translation": "I am a prophet of evils."}, {"id": "kakos-quote81", "translation": "Self-wrought evils."}, {"id": "kakos-quote82", "translation": "Fearless of evils."}, {"id": "kakos-quote83", "translation": "Alas, evils!"}, {"id": "kakos-quote84", "translation": "Of grievous evils."}, {"id": "kakos-quote85", "translation": "He shares in evils."}, {"id": "kakos-quote86", "translation": "Having escaped evils."}, {"id": "kakos-quote87", "translation": "Having suffered badly, he repaid with evils."}, {"id": "kakos-quote88", "translation": "Having done many evils to the Medes."}, {"id": "kakos-quote89", "translation": "It is an evil first to announce evils."}, {"id": "kakos-quote90", "translation": "Grievous evils."}, {"id": "kakos-quote91", "translation": "What evils were stirred up."}, {"id": "kakos-quote92", "translation": "Struck with terror by evils."}, {"id": "kakos-quote93", "translation": "Even if you groan at evils, nevertheless."}, {"id": "kakos-quote94", "translation": "I report few evils."}, {"id": "kakos-quote95", "translation": "The highest of evils."}, {"id": "kakos-quote96", "translation": "A multitude of evils."}, {"id": "kakos-quote97", "translation": "A sea of evils."}, {"id": "kakos-quote98", "translation": "A calamity of evils."}, {"id": "kakos-quote99", "translation": "Seeing the depth of evils."}, {"id": "kakos-quote100", "translation": "I omit many evils in speaking."}, {"id": "kakos-quote101", "translation": "You revealed evils."}, {"id": "kakos-quote102", "translation": "In addition to evils."}, {"id": "kakos-quote103", "translation": "Whoever is experienced in evils."}, {"id": "kakos-quote104", "translation": "A wave of evils."}, {"id": "kakos-quote105", "translation": "A terror of evils."}, {"id": "kakos-quote106", "translation": "A remedy for evils."}, {"id": "kakos-quote107", "translation": "Many evils come from the land."}, {"id": "kakos-quote108", "translation": "Before seeing the depth of evils."}, {"id": "kakos-quote109", "translation": "A source of evils."}, {"id": "kakos-quote110", "translation": "A foundation of evils."}, {"id": "kakos-quote111", "translation": "Under the pain of evils."}, {"id": "kakos-quote112", "translation": "In evils."}, {"id": "kakos-quote113", "translation": "You speak evils before evils."}, {"id": "kakos-quote114", "translation": "What of these things without evils?"}, {"id": "kakos-quote115", "translation": "If sudden evils should not happen."}, {"id": "kakos-quote116", "translation": "How shall I mix good things with evils?"}, {"id": "kakos-quote117", "translation": "Evils surged with heavy waves."}, {"id": "kakos-quote118", "translation": "We endured many evils."}, {"id": "kakos-quote119", "translation": "About her own evils."}, {"id": "kakos-quote120", "translation": "Self-wrought evils."}, {"id": "kakos-quote121", "translation": "Through evils."}, {"id": "kakos-quote122", "translation": "A life flourishing with evils."}, {"id": "kakos-quote123", "translation": "Wailing piteous evils."}, {"id": "kakos-quote124", "translation": "A trace of evils."}, {"id": "kakos-quote125", "translation": "O evils!"}, {"id": "kakos-quote126", "translation": "Having filled a bowl of accursed evils."}, {"id": "kakos-quote127", "translation": "By no means—let us do other evils."}, {"id": "kakos-quote128", "translation": "Averter of evils."}, {"id": "kakos-quote129", "translation": "A gift worthy of the evils."}, {"id": "kakos-quote130", "translation": "Averting pollution of evils and good things."}, {"id": "kakos-quote131", "translation": "Many joyless evils."}, {"id": "kakos-quote132", "translation": "What without evils?"}, {"id": "kakos-quote133", "translation": "The house is maddened by evils."}, {"id": "kakos-quote134", "translation": "The Lemnian evil is preeminent among evils."}, {"id": "kakos-quote135", "translation": "For the other evils I endured patiently."}, {"id": "kakos-quote136", "translation": "Zeus will make a turning point of evils."}, {"id": "kakos-quote137", "translation": "Innocent of these evils."}, {"id": "kakos-quote138", "translation": "Escapes from evils."}, {"id": "kakos-quote139", "translation": "Not to serve evils."}, {"id": "kakos-quote140", "translation": "Listeners to these evils."}, {"id": "kakos-quote141", "translation": "Evils were stirred up."}, {"id": "kakos-quote142", "translation": "Let me not speak evils."}, {"id": "kakos-quote143", "translation": "They were born for the sake of evils."}, {"id": "kakos-quote144", "translation": "Except to do evils."}, {"id": "kakos-quote145", "translation": "Mindful of evils."}, {"id": "kakos-quote146", "translation": "The evils of neighbors."}, {"id": "kakos-quote147", "translation": "Insatiable of evils."}, {"id": "kakos-quote148", "translation": "The varied evils of mortals."}, {"id": "kakos-quote149", "translation": "Ignorant rather than wise in evils."}, {"id": "kakos-quote150", "translation": "A multitude of evils."}, {"id": "kakos-quote151", "translation": "A harbor of evils."}, {"id": "kakos-quote152", "translation": "I am freed from evils that love lamentation."}, {"id": "kakos-quote153", "translation": "A healer of incurable evils."}]}