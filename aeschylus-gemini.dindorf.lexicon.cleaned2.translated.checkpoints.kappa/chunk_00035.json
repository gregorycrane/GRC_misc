{"units": [{"id": "klyo_v-quote39", "translation": "I proclaim to my father to hear, to listen"}, {"id": "klyo_v-quote40", "translation": "to hear my prayers"}, {"id": "klyo_v-quote41", "translation": "and you, hear me"}, {"id": "klyo_v-quote42", "translation": "hear me, hear, from my dim mind"}, {"id": "klyo_v-quote43", "translation": "hear now, father, in turn my many-teared griefs"}, {"id": "klyo_v-quote44", "translation": "hear, Earth and honors of the underworld gods"}, {"id": "klyo_v-quote45", "translation": "hearing this lament"}, {"id": "klyo_v-quote46", "translation": "my heart darkens at the word as I hear"}, {"id": "klyo_v-quote47", "translation": "you hear the dishonored woes of my father"}, {"id": "klyo_v-quote48", "translation": "a course creeps upon me as I hear prayers"}, {"id": "klyo_v-quote49", "translation": "hearing this prayer"}, {"id": "klyo_v-quote50", "translation": "surely hearing that will delight his mind"}, {"id": "klyo_v-quote51", "translation": "so that he may hear without fear"}, {"id": "klyo_v-quote52", "translation": "hear, gods of one mind"}, {"id": "klyo_v-quote53", "translation": "a god hears even from afar"}, {"id": "klyo_v-quote54", "translation": "O mother – hear"}, {"id": "klyo_v-quote55", "translation": "hearing my ordinance"}, {"id": "klyo_v-quote56", "translation": "you would now hear the ordinance"}, {"id": "klyo_v-quote57", "translation": "hear well, you who have seen justice"}, {"id": "klyo_v-quote58", "translation": "and from on high may he hear well when called"}, {"id": "klyo_v-quote59", "translation": "you speak things incredible for me to hear, strangers"}, {"id": "klyo_v-quote60", "translation": "hear me with a willing heart"}, {"id": "klyo_v-quote61", "translation": "gods born of Zeus, may you hear the prayers we pour for our race"}, {"id": "klyo_v-quote62", "translation": "as I hear from you"}, {"id": "klyo_v-quote63", "translation": "he hears of evils in his mind"}, {"id": "klyo_v-quote64", "translation": "hearing very well the helm of the last steersman of the ship"}, {"id": "klyo_v-quote65", "translation": "to hear well beyond measure"}, {"id": "klyo_v-quote66", "translation": "you wish to be just in hearing (thus I wrote for δικαίως) rather than to act (sc. justly)"}, {"id": "klyo_v-quote67", "translation": "a coward will wish to hear rather than be a murderer"}, {"id": "klyo_v-word1", "translation": "I hear"}, {"id": "klyo_v-word2", "translation": "I heard, u"}, {"id": "klyo_v-word3", "translation": "hear (sg.)"}, {"id": "klyo_v-word4", "translation": "hear (pl.)"}, {"id": "klyo_v-word5", "translation": "hear (sg.), hear (pl.)"}, {"id": "klyo_v-word6", "translation": "hear (sg.)"}, {"id": "klyo_v-word7", "translation": "hear (pl.)"}, {"id": "klyo_v-word8", "translation": "hear (sg.)"}, {"id": "klyo_v-word9", "translation": "hear (pl.)"}, {"id": "klyo_v-word10", "translation": "I hear"}, {"id": "klyo_v-word11", "translation": "to hear, to listen"}, {"id": "klyo_v-word12", "translation": "he says this second thing, to hear, to listen, being the same thing most clearly"}, {"id": "klyo_v-word13", "translation": "I hear"}, {"id": "klyo_v-word14", "translation": "from, away from, out of"}, {"id": "klyo_v-word15", "translation": "as, that"}, {"id": "klyo_v-word16", "translation": "because"}, {"id": "klyo_v-word17", "translation": "hear (pl.)"}, {"id": "klyo_v-word18", "translation": "wishing a favorable action"}, {"id": "klyo_v-word19", "translation": "hearing"}, {"id": "klyo_v-word20", "translation": "remaining"}, {"id": "klyo_v-word21", "translation": "I hear"}, {"id": "kloster-orth1", "translation": "thread"}, {"id": "kloster-def1", "translation": "thread"}, {"id": "kloster-quote1", "translation": "saving the thread of flax from the deep"}, {"id": "knapto-orth1", "translation": "to card wool"}, {"id": "knapto-note1", "translation": "See γνάπτω."}, {"id": "knapto-word1", "translation": "to card wool"}, {"id": "knafeus-orth1", "translation": "fuller"}, {"id": "knafeus-note1", "translation": "See γναφεύς."}, {"id": "knafeus-word1", "translation": "fuller"}, {"id": "knephazo-orth1", "translation": "to darken"}, {"id": "knephazo-def1", "translation": "to darken"}, {"id": "knephazo-quote1", "translation": "lest some divine envy darken the great mouth of Troy struck beforehand"}, {"id": "knephaios-orth1", "translation": "dark, gloomy"}, {"id": "knephaios-def1", "translation": "dark, gloomy"}, {"id": "knephaios-quote1", "translation": "and the dark depths around Tartarus"}, {"id": "knephas-orth1", "translation": "darkness, gloom"}, {"id": "knephas-def1", "translation": "darkness, gloom"}, {"id": "knephas-quote1", "translation": "if the darkness of black night comes"}, {"id": "knephas-quote2", "translation": "and darkness seizes the precinct of the upper air"}, {"id": "knephas-quote3", "translation": "such darkness of pollution hovers over the man"}, {"id": "knephas-quote4", "translation": "sunless darkness"}, {"id": "knemis-orth1", "translation": "greave"}, {"id": "knemis-def1", "translation": "greave"}, {"id": "knemis-quote1", "translation": "bring the greaves quickly"}, {"id": "knidos-orth1", "translation": "Cnidus"}, {"id": "knidos-def1", "translation": "Cnidus, city of Caria"}, {"id": "knisa-orth1", "translation": "savor, steam of burnt sacrifice"}, {"id": "knisa-def1", "translation": "savor, steam of burnt fat or grease"}, {"id": "knisa-quote1", "translation": "and the savor and the limbs wrapped in fat"}, {"id": "knisotos-orth1", "translation": "filled with the savor of burnt sacrifice"}, {"id": "knisotos-def1", "translation": "filled with the savor of burnt sacrifice"}, {"id": "knisotos-quote1", "translation": "with burnt offerings full of savor"}, {"id": "knous-orth1", "translation": "noise of wheels or feet"}, {"id": "knous-def1", "translation": "noise of wheels or feet"}, {"id": "knous-note1", "translation": "χνοῦς [down, nap] and κνοῦς [noise] in Herodian, On Monosyllabic Words p. 14, 36. With the gloss of Hesychius are to be compared two examples of the word χνόη [hub], which see under that word."}, {"id": "knous-quote1", "translation": "κνοῦς: the sound from the axle. It is also called κνόη. And the noise of feet"}, {"id": "knous-quote2", "translation": "κνοῦς: the thing at the end of the axle of the wheel"}, {"id": "knous-word1", "translation": "down, nap"}, {"id": "knous-word2", "translation": "noise"}, {"id": "knous-word3", "translation": "On Monosyllabic Words"}, {"id": "knous-word4", "translation": "hub"}, {"id": "knodalôn-orth1", "translation": "wild beast, monster"}, {"id": "knodalôn-def1", "translation": "wild beast, monster"}, {"id": "knodalôn-quote1", "translation": "and I first yoked beasts in pairs"}, {"id": "knodalôn-quote2", "translation": "and the sea's embraces are full of hostile beasts for mortals"}, {"id": "knodalôn-quote3", "translation": "of beasts and mortals"}, {"id": "knodalôn-quote4", "translation": "O beasts hated by all"}, {"id": "knodalôn-quote5", "translation": "cleanses this land of man-destroying beasts"}, {"id": "knodalôn-quote6", "translation": "having the passions of vain and unholy beasts"}, {"id": "knodalôn-quote7", "translation": "winged beasts and those that walk the earth"}, {"id": "konchos-orth1", "translation": "shellfish, mussel"}, {"id": "konchos-def1", "translation": "shellfish, mussel"}, {"id": "konchos-quote1", "translation": "shellfish, mussels, oysters"}, {"id": "koilogastor-orth1", "translation": "hollow-bellied"}, {"id": "koilogastor-def1", "translation": "hollow-bellied"}, {"id": "koilogastor-def2", "translation": "improperly"}, {"id": "koilogastor-note1", "translation": "which the scholiast explains by μεγαλογάστορες [big-bellied], i.e. voracious. Thus κοίλη γαστρὶ χρῆσθαι [to have a hollow belly] Philostr. p. 615."}, {"id": "koilogastor-quote1", "translation": "hollow-bellied wolves"}, {"id": "koilogastor-quote2", "translation": "the hollow of a hollow-bellied circle"}, {"id": "koilogastor-word1", "translation": "big-bellied"}, {"id": "koilogastor-word2", "translation": "to have a hollow belly"}, {"id": "koilos-orth1", "translation": "hollow"}, {"id": "koilos-def1", "translation": "hollow"}, {"id": "koilos-quote1", "translation": "the hollow Corycian rock"}, {"id": "koimao-orth1", "translation": "to put to sleep"}, {"id": "koimao-def1", "translation": "to put to sleep"}, {"id": "koimao-def2", "translation": "improperly to soothe"}, {"id": "koimao-def3", "translation": "to restrain"}, {"id": "koimao-def4", "translation": "to extinguish"}]}