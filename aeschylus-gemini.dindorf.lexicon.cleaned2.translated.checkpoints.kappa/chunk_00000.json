{"units": [{"id": "kabeiroi-orth1", "translation": "Cabeiri"}, {"id": "kabeiroi-def1", "translation": "was the title of a play of Aeschylus (fr. 93-96)."}, {"id": "kadmeios-orth1", "translation": "Cadmean, i.e. Theban"}, {"id": "kadmeios-def1", "translation": "Cadmean, i.e. Theban"}, {"id": "kadmeios-quote1", "translation": "for the city of the Cadmeans"}, {"id": "kadmeios-quote2", "translation": "bravest lord of the Cadmeans"}, {"id": "kadmeios-quote3", "translation": "the city of the Cadmeans"}, {"id": "kadmeios-quote4", "translation": "one man of the Cadmeans"}, {"id": "kadmeios-quote5", "translation": "Cadmean men"}, {"id": "kadmeios-quote6", "translation": "to the counselors of this Cadmean city"}, {"id": "kadmeios-quote7", "translation": "a destroyer of the Cadmean land"}, {"id": "kadmeios-quote8", "translation": "to this Cadmean host"}, {"id": "kadmeios-quote9", "translation": "to the champions of the Cadmeans"}, {"id": "kadmeios-quote10", "translation": "he sacked the city of the Cadmeans"}, {"id": "kadmogenes-orth1", "translation": "descended from Cadmus"}, {"id": "kadmogenes-def1", "translation": "descended from Cadmus"}, {"id": "kadmogenes-quote1", "translation": "protect the Cadmus-born army"}, {"id": "kadmos-orth1", "translation": "Cadmus"}, {"id": "kadmos-def1", "translation": "Cadmus, son of Agenor, founder of Thebes."}, {"id": "kadmos-quote1", "translation": "citizens of Cadmus"}, {"id": "kadmos-quote2", "translation": "the city of Cadmus"}, {"id": "kadmos-quote3", "translation": "the citadel of Cadmus"}, {"id": "kadmos-quote4", "translation": "the city named after Cadmus"}, {"id": "kadmos-quote5", "translation": "the towers of Cadmus"}, {"id": "kathaimasso-orth1", "translation": "to stain with blood"}, {"id": "kathaimasso-def1", "translation": "to stain with blood"}, {"id": "kathaimasso-quote1", "translation": "until the slaughter of a newly born animal, as purification for a man's blood, stains with blood"}, {"id": "kathaireo-orth1", "translation": "to take down, destroy"}, {"id": "kathaireo-def1", "translation": "to take down, destroy"}, {"id": "kathaireo-quote1", "translation": "he destroys the unjust man"}, {"id": "kathaireo-quote2", "translation": "time destroys all things"}, {"id": "kathairo-orth1", "translation": "to purify, cleanse"}, {"id": "kathairo-def1", "translation": "to purify, cleanse"}, {"id": "kathairo-note1", "translation": "which Hesychius explains by ἐκδύομαι [I strip off]."}, {"id": "kathairo-quote1", "translation": "purifying the hand-defiling murder"}, {"id": "kathairo-quote2", "translation": "one must spit out and cleanse the mouth"}, {"id": "kathairo-quote3", "translation": "I am cleansed of old age"}, {"id": "kathairo-word1", "translation": "I strip off"}, {"id": "katharma-orth1", "translation": "offscouring, refuse"}, {"id": "katharma-def1", "translation": "offscouring, refuse"}, {"id": "katharma-quote1", "translation": "as someone who has sent away offscourings"}, {"id": "katharmos-orth1", "translation": "purification, expiation"}, {"id": "katharmos-def1", "translation": "purification, expiation"}, {"id": "katharmos-note1", "translation": "πᾶν ἐλαθῇ μύσος [all pollution be driven away] Weilius"}, {"id": "katharmos-note2", "translation": "thus Schuetzius for ἅπαν [all]"}, {"id": "katharmos-note3", "translation": "Thus Erfurdtius. εἴσω [within] first hand M, εἰσσ᾽ ὁ [into the] by a corrector. εἰσὶν καθαρμοὶ [there are purifications] Schuetzius."}, {"id": "katharmos-quote1", "translation": "who could provide purifications?"}, {"id": "katharmos-quote2", "translation": "when from the hearth, all pollution is driven away by purifications that avert ruin"}, {"id": "katharmos-quote3", "translation": "one purification for you"}, {"id": "katharmos-quote4", "translation": "I know many purifications"}, {"id": "katharmos-quote5", "translation": "he was driven away by purifications with slain pigs"}, {"id": "katharmos-word1", "translation": "all pollution be driven away"}, {"id": "katharmos-word2", "translation": "all"}, {"id": "katharmos-word3", "translation": "within"}, {"id": "katharmos-word4", "translation": "M, into the"}, {"id": "katharmos-word5", "translation": "there are purifications"}, {"id": "katharos-orth1", "translation": "pure"}, {"id": "katharos-def1", "translation": "pure"}, {"id": "katharos-quote1", "translation": "the one who holds out clean hands"}, {"id": "katharos-quote2", "translation": "you came as a suppliant, pure and harmless, to the house"}, {"id": "katharos-quote3", "translation": "they will please the gods with pure altars"}, {"id": "katharsios-orth1", "translation": "purifying, expiatory"}, {"id": "katharsios-def1", "translation": "purifying, expiatory"}, {"id": "katharsios-quote1", "translation": "for the blood is purifying"}, {"id": "katharsios-quote2", "translation": "slaughter of purifying blood"}, {"id": "katharsios-quote3", "translation": "purifier of the house"}, {"id": "katharsios-quote4", "translation": "I am the purifier of this murder"}, {"id": "kathezesthai-orth1", "translation": "to sit down"}, {"id": "kathezesthai-def1", "translation": "to sit down"}, {"id": "kathezesthai-note1", "translation": "It is an aorist."}, {"id": "kathezesthai-quote1", "translation": "he sat down on his father's throne"}, {"id": "kathezesthai-quote2", "translation": "another Titaness, child of the earth, sat down"}, {"id": "katheudo-orth1", "translation": "to sleep"}, {"id": "katheudo-def1", "translation": "to sleep"}, {"id": "katheudo-def2", "translation": "Improperly"}, {"id": "katheudo-quote1", "translation": "they sleep; in vain I speak unfulfilled words"}, {"id": "katheudo-quote2", "translation": "what need is there of sleeping women?"}, {"id": "katheudo-quote3", "translation": "but those who trample underfoot the glory of the future do not sleep with their hand"}, {"id": "katheko-orth1", "translation": "to come down to the contest"}, {"id": "katheko-def1", "translation": "to come down to the contest"}, {"id": "katheko-quote1", "translation": "it is fitting to come down with unbending might"}, {"id": "kathemai-orth1", "translation": "to sit"}, {"id": "kathemai-def1", "translation": "to sit"}, {"id": "kathemai-quote1", "translation": "let him sit with confidence"}, {"id": "kathemai-quote2", "translation": "do not reproach the one who toils while sitting inside"}, {"id": "kathemai-quote3", "translation": "the terrible thing must remain seated"}, {"id": "kathemai-quote4", "translation": "you are not sitting as suppliants at the hearth of my house"}, {"id": "kathemai-quote5", "translation": "to one sleeping, walking, and sitting"}, {"id": "kathemai-quote6", "translation": "the things – he crumbled – to those sitting"}, {"id": "kathieroo-orth1", "translation": "to consecrate"}, {"id": "kathieroo-def1", "translation": "to consecrate"}, {"id": "kathieroo-quote1", "translation": "reared and consecrated for me"}, {"id": "kathizano-orth1", "translation": "to sit down"}, {"id": "kathizano-def1", "translation": "to sit down"}, {"id": "kathizano-quote1", "translation": "then as a seer I sit down on the throne"}, {"id": "kathiema-orth1", "translation": "to let down, lower"}, {"id": "kathiema-def1", "translation": "to let down"}, {"id": "kathiema-def2", "translation": "to lower"}]}