{"units": [{"id": "proton-quote24", "translation": "For first my father will rend this rugged ravine."}, {"id": "proton-quote25", "translation": "First we displayed our glorious armies."}, {"id": "proton-quote26", "translation": "First I will greet the gods."}, {"id": "proton-quote27", "translation": "And let the first thing that follows my voice be not boldness."}, {"id": "proton-quote28", "translation": "First for the city and for ourselves."}, {"id": "proton-quote29", "translation": "At first the stream of the Persian army held out."}, {"id": "proton-word1", "translation": "the first"}, {"id": "proton-word2", "translation": "I fawn upon"}, {"id": "proton-word3", "translation": "first"}, {"id": "proton-word4", "translation": "the first things"}, {"id": "ptaio-orth1", "translation": "to stumble"}, {"id": "ptaio-def1", "translation": "I stumble."}, {"id": "ptaio-note1", "translation": "Thus Butler for πήσας. παίσας is in the scholia on Pindar Pyth. 2 at the end."}, {"id": "ptaio-quote1", "translation": "Having stumbled upon this misfortune."}, {"id": "ptaio-quote2", "translation": "Lest you stumble in your toil."}, {"id": "ptaio-word1", "translation": "πήσας [having stumbled] παίσας [having struck]"}, {"id": "ptanos-orth1", "translation": "winged"}, {"id": "ptanos-def1", "translation": "Doric for πτηνός, which see."}, {"id": "ptanos-word1", "translation": "winged"}, {"id": "ptax-orth1", "translation": "timid, fearful"}, {"id": "ptax-def1", "translation": "timid, fearful."}, {"id": "ptax-note1", "translation": "Of a timid animal (the hare) see Thes. vol. 6 p. 2160."}, {"id": "ptax-quote1", "translation": "The self-born, wretched hare before the birth, to those sacrificing."}, {"id": "pterna-orth1", "translation": "heel"}, {"id": "pterna-def1", "translation": "heel."}, {"id": "pterna-quote1", "translation": "The heels and the under-markings of the tendons."}, {"id": "pteroes-orth1", "translation": "winged"}, {"id": "pteroes-def1", "translation": "winged."}, {"id": "pteroes-quote1", "translation": "Of the winged herdsman."}, {"id": "pteroes-quote2", "translation": "Winged creatures."}, {"id": "pteron-orth1", "translation": "wing"}, {"id": "pteron-def1", "translation": "wing."}]}