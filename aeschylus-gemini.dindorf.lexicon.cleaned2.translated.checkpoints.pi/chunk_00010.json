{"units": [{"id": "panegyris-word1", "translation": "assembly, gathering"}, {"id": "panemeros-orth1", "translation": "lasting all day"}, {"id": "panemeros-def1", "translation": "lasting all day"}, {"id": "panemeros-quote1", "translation": "an uninvited guest creeping in, all day long"}, {"id": "pantheos-orth1", "translation": "all-divine"}, {"id": "pantheos-def1", "translation": "Heimsoeth's conjecture. See under πολύθεος."}, {"id": "pantheos-word1", "translation": "of many gods"}, {"id": "panios-orth1", "translation": "inhabited by Pan"}, {"id": "panios-def1", "translation": "inhabited by Pan"}, {"id": "panios-note1", "translation": "ἐπὶ [upon] codex"}, {"id": "panios-quote1", "translation": "the glens of Pan, as from Pan"}, {"id": "panios-word1", "translation": "upon"}, {"id": "pannychos-orth1", "translation": "lasting all night"}, {"id": "pannychos-def1", "translation": "lasting all night"}, {"id": "pannychos-quote1", "translation": "all night long they made the crossing"}, {"id": "panodyrtos-orth1", "translation": "all-lamenting"}, {"id": "panodyrtos-def1", "translation": "wrongly for πάνδυρτος, which see"}, {"id": "panodyrtos-word1", "translation": "all-lamenting"}, {"id": "panoizys-orth1", "translation": "utterly wretched"}, {"id": "panoizys-def1", "translation": "utterly wretched"}, {"id": "panoizys-quote1", "translation": "alas, utterly wretched hearth"}, {"id": "panoimoi-orth1", "translation": "utterly alas"}, {"id": "panoimoi-def1", "translation": "utterly alas"}, {"id": "panoimoi-note1", "translation": "Not found elsewhere."}, {"id": "panoimoi-quote1", "translation": "alas, utterly alas, as my master is being accomplished"}, {"id": "panolbos-orth1", "translation": "all-blessed"}, {"id": "panolbos-def1", "translation": "all-blessed"}, {"id": "panolbos-quote1", "translation": "through long ages all-blessed"}, {"id": "panomili-orth1", "translation": "all together, in a body"}, {"id": "panomili-def1", "translation": "all together, in a body"}, {"id": "panomili-note1", "translation": "Thus Blomfield for πανομιλεί [all together]."}, {"id": "panomili-quote1", "translation": "for some go to the towers with all the people, all together"}, {"id": "panomili-word1", "translation": "all together"}, {"id": "panoplos-orth1", "translation": "fully armed"}, {"id": "panoplos-def1", "translation": "fully armed"}, {"id": "panoplos-quote1", "translation": "the fully armed army of the Argives"}, {"id": "panoptes-orth1", "translation": "all-seeing"}, {"id": "panoptes-def1", "translation": "all-seeing"}, {"id": "panoptes-quote1", "translation": "the all-seeing circle of the sun"}, {"id": "panoptes-quote2", "translation": "Zeus the all-seeing"}, {"id": "panoptes-quote3", "translation": "the all-seeing shepherd of sheep"}, {"id": "panos-orth1", "translation": "torch"}, {"id": "panos-def1", "translation": "torch"}, {"id": "panos-quote1", "translation": "a great torch"}, {"id": "panourgia-orth1", "translation": "villainy"}, {"id": "panourgia-def1", "translation": "villainy"}, {"id": "panourgia-note1", "translation": "Thus I corrected for πανουργίᾳ τινί [with some villainy]."}, {"id": "panourgia-quote1", "translation": "A pious man who boarded a ship with hot sailors and full of villainy"}, {"id": "panourgia-word1", "translation": "with some villainy"}, {"id": "panourgos-orth1", "translation": "ready for any deed, villainous"}, {"id": "panourgos-def1", "translation": "ready for any deed, villainous"}, {"id": "panourgos-quote1", "translation": "with the wretched and villainous hand of mortals"}, {"id": "panselenos-orth1", "translation": "full moon"}, {"id": "panselenos-def1", "translation": "full moon"}, {"id": "panselenos-quote1", "translation": "a bright full moon in the middle of the shield"}, {"id": "pansophos-orth1", "translation": "all-wise"}, {"id": "pansophos-def1", "translation": "all-wise"}, {"id": "pansophos-note1", "translation": "Thus this adjective is written in the passages of the tragedians indicated in Thes. vol. 6 p. 164: πάσσοφος [all-wise] in the books of Plato."}, {"id": "pansophos-quote1", "translation": "tell me now this all-wise name"}, {"id": "pansophos-word1", "translation": "all-wise"}, {"id": "panta-orth1", "translation": "everywhere"}, {"id": "panta-def1", "translation": "everywhere"}, {"id": "panta-note1", "translation": "Doric for πάντη [everywhere]"}, {"id": "panta-note2", "translation": "πάνται [everywhere] M"}, {"id": "panta-note3", "translation": "πάντα [everywhere] M"}, {"id": "panta-quote1", "translation": "everywhere it blazes even in darkness"}, {"id": "panta-quote2", "translation": "everywhere most honored of the gods"}, {"id": "panta-word1", "translation": "everywhere"}, {"id": "panta-word2", "translation": "everywhere"}, {"id": "panta-word3", "translation": "everywhere"}, {"id": "pantalas-orth1", "translation": "utterly wretched"}, {"id": "pantalas-def1", "translation": "utterly wretched"}, {"id": "pantalas-quote1", "translation": "shall I cry aloud utterly wretched griefs?"}, {"id": "pantarches-orth1", "translation": "all-sufficient"}, {"id": "pantarches-def1", "translation": "all-sufficient"}, {"id": "pantarches-quote1", "translation": "the aged, all-sufficient, guileless, unconquered king"}, {"id": "pantache-orth1", "translation": "in every way"}, {"id": "pantache-def1", "translation": "in every way"}, {"id": "pantache-quote1", "translation": "for having acted in you in every way, I will praise these things"}, {"id": "pantache-quote2", "translation": "in every way ill-fated"}, {"id": "pantache-quote3", "translation": "we judge that it is well for you to accomplish these things in every way"}, {"id": "panteles-orth1", "translation": "all-accomplishing"}, {"id": "panteles-def1", "translation": "all-accomplishing"}, {"id": "panteles-def2", "translation": "perfect"}, {"id": "panteles-note1", "translation": "where I emended πᾶν τέλος ὃς νέμεις [you who dispense every fulfillment]."}, {"id": "panteles-quote1", "translation": "O father Zeus, all-accomplishing, in every way"}, {"id": "panteles-quote2", "translation": "soon the all-accomplishing time will pass the gates of the house"}, {"id": "panteles-quote3", "translation": "having a complete covering"}, {"id": "panteles-quote4", "translation": "complete decrees"}, {"id": "panteles-word1", "translation": "you who dispense every fulfillment"}, {"id": "pantelos-orth1", "translation": "completely"}, {"id": "pantelos-def1", "translation": "completely"}, {"id": "pantelos-quote1", "translation": "who else but I has completely determined the honors?"}, {"id": "pantelos-quote2", "translation": "the curse of Cronus will then be completely fulfilled"}, {"id": "panteuchia-orth1", "translation": "full armor"}, {"id": "panteuchia-def1", "translation": "full armor"}, {"id": "panteuchia-quote1", "translation": "go with full armor"}, {"id": "panteuchia-quote2", "translation": "the bold bird of the rocks in full armor"}, {"id": "panteknos-orth1", "translation": "all-crafting"}, {"id": "panteknos-def1", "translation": "all-crafting"}, {"id": "panteknos-quote1", "translation": "the light of all-crafting fire"}, {"id": "pantodapos-orth1", "translation": "of every kind, various"}, {"id": "pantodapos-def1", "translation": "of every kind, various"}, {"id": "pantodapos-quote1", "translation": "fruit of every kind"}, {"id": "pantothen-orth1", "translation": "from all sides"}, {"id": "pantothen-def1", "translation": "from all sides"}, {"id": "pantothen-quote1", "translation": "I am filled with praise for her from all sides"}, {"id": "pantolmos-orth1", "translation": "all-daring, villainous"}, {"id": "pantolmos-def1", "translation": "all-daring, villainous"}, {"id": "pantolmos-quote1", "translation": "to a man all-daring in his mind"}, {"id": "pantolmos-quote2", "translation": "wretched, all-daring mother"}, {"id": "pantolmos-quote3", "translation": "all-daring loves"}, {"id": "pantomises-orth1", "translation": "hated by all"}, {"id": "pantomises-def1", "translation": "hated by all"}, {"id": "pantomises-quote1", "translation": "O beasts hated by all"}, {"id": "pantoptes-helios-orth1", "translation": "all-seeing"}, {"id": "pantoptes-helios-def1", "translation": "all-seeing"}, {"id": "pantoptes-helios-note1", "translation": "In Strabo 1 p. 33 παντεπόπτης [all-seeing], which Tyrwhitt corrected, except that he wrote παντόπτας [all-seeing]."}, {"id": "pantoptes-helios-quote1", "translation": "the father, the all-seeing one"}, {"id": "pantoptes-helios-quote2", "translation": "the all-seeing Sun"}, {"id": "pantoptes-helios-word1", "translation": "all-seeing"}, {"id": "pantoptes-helios-word2", "translation": "all-seeing"}, {"id": "pantosemnos-orth1", "translation": "revered by all"}, {"id": "pantosemnos-def1", "translation": "revered by all"}, {"id": "pantosemnos-quote1", "translation": "the fate of this man, revered by all, has been told to you"}, {"id": "pantotolmos-orth1", "translation": "all-daring, villainous"}, {"id": "pantotolmos-def1", "translation": "all-daring, villainous"}]}