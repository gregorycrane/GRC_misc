{"units": [{"id": "pater-quote23", "translation": "Not for long will the father leave it desolate"}, {"id": "pater-quote24", "translation": "father the planter"}, {"id": "pater-quote25", "translation": "father Zeus"}, {"id": "pater-quote26", "translation": "the father's words"}, {"id": "pater-quote27", "translation": "of the father's words"}, {"id": "pater-quote28", "translation": "children of father Oceanus"}, {"id": "pater-quote29", "translation": "by father Oceanus' unquenchable stream"}, {"id": "pater-quote30", "translation": "the father's name"}, {"id": "pater-quote31", "translation": "to the sisters of my father"}, {"id": "pater-quote32", "translation": "flocks and herds to my father"}, {"id": "pater-quote33", "translation": "a child mightier than his father"}, {"id": "pater-quote34", "translation": "and the curse of father Cronus"}, {"id": "pater-quote35", "translation": "the Fury of my father"}, {"id": "pater-quote36", "translation": "will adorn the house of my father"}, {"id": "pater-quote37", "translation": "now indeed the father's curses are fulfilled"}, {"id": "pater-quote38", "translation": "the wretched curse of my father"}, {"id": "pater-quote39", "translation": "the father's prayed-for Fury"}, {"id": "pater-quote40", "translation": "according to the father's prayers"}, {"id": "pater-quote41", "translation": "venerable Fury of father Oedipus"}, {"id": "pater-quote42", "translation": "from my father"}, {"id": "pater-quote43", "translation": "the curse of my father"}, {"id": "pater-quote44", "translation": "from my unhappy father"}, {"id": "pater-quote45", "translation": "to the winged hounds of my father"}, {"id": "pater-quote46", "translation": "through the halls of my father"}, {"id": "pater-quote47", "translation": "the thrice-poured, blessed life of my dear father"}, {"id": "pater-quote48", "translation": "from my father"}, {"id": "pater-quote49", "translation": "sacrifices of my father"}, {"id": "pater-quote50", "translation": "avenger of my father"}, {"id": "pater-quote51", "translation": "the upturned body of my fallen father"}, {"id": "pater-quote52", "translation": "the fate of my father"}, {"id": "pater-quote53", "translation": "in the tomb of my father"}, {"id": "pater-quote54", "translation": "the tomb of my father"}, {"id": "pater-quote55", "translation": "the grave of my father"}, {"id": "pater-quote56", "translation": "the offering of shorn locks for my father"}, {"id": "pater-quote57", "translation": "honor for my father"}, {"id": "pater-quote58", "translation": "in the house of my father"}, {"id": "pater-quote59", "translation": "will recover the house of my father"}, {"id": "pater-quote60", "translation": "the brood bereft of the eagle father"}, {"id": "pater-quote61", "translation": "the father's chicks"}, {"id": "pater-quote62", "translation": "of the father's hearth"}, {"id": "pater-quote63", "translation": "those responsible for my father"}, {"id": "pater-quote64", "translation": "the wrath of my father"}, {"id": "pater-quote65", "translation": "great grief for my father"}, {"id": "pater-quote66", "translation": "and the dishonor of my father"}, {"id": "pater-quote67", "translation": "at the tomb of my father"}, {"id": "pater-quote68", "translation": "I shall find on the throne of my father"}, {"id": "pater-quote69", "translation": "by the deed of my father"}, {"id": "pater-quote70", "translation": "the voice of my father"}, {"id": "pater-quote71", "translation": "you considered him greater than your father"}, {"id": "pater-quote72", "translation": "being of a free father"}, {"id": "pater-quote73", "translation": "the things of my father"}, {"id": "pater-quote74", "translation": "for the father's portion"}, {"id": "pater-quote75", "translation": "Loxias is the prophet of father Zeus"}, {"id": "pater-quote76", "translation": "the blood of a brother and of a common father"}, {"id": "pater-quote77", "translation": "the penalties for my father"}, {"id": "pater-quote78", "translation": "with penalties for my dearest father"}, {"id": "pater-quote79", "translation": "by the will of my father I bid you follow"}, {"id": "pater-quote80", "translation": "the murder of my father"}, {"id": "pater-quote81", "translation": "Zeus honors the fate of my father"}, {"id": "pater-quote82", "translation": "will dwell in the house of my father"}, {"id": "pater-quote83", "translation": "I am very much my father's"}, {"id": "pater-quote84", "translation": "the father of this my father"}, {"id": "pater-quote85", "translation": "having heard the words of my father"}, {"id": "pater-quote86", "translation": "the watchposts of my father"}, {"id": "pater-quote87", "translation": "by the admonitions of my father"}, {"id": "pater-quote88", "translation": "these commands of my father"}, {"id": "pater-quote89", "translation": "the blasts of my father"}, {"id": "pater-quote90", "translation": "at the setting of your father"}, {"id": "pater-quote91", "translation": "the greatest contest of my father"}, {"id": "pater-quote92", "translation": "and I dared to speak to my father"}, {"id": "pater-quote93", "translation": "to be born a faithful messenger to father Zeus"}, {"id": "pater-quote94", "translation": "a bane sharing the bed of my father"}, {"id": "pater-quote95", "translation": "bringing propitious libations for my father from his child"}, {"id": "pater-quote96", "translation": "only child to my father"}, {"id": "pater-quote97", "translation": "to my father"}, {"id": "pater-quote98", "translation": "drives out together with my unhappy father"}, {"id": "pater-quote99", "translation": "I proclaim to my father"}, {"id": "pater-quote100", "translation": "to my father"}, {"id": "pater-quote101", "translation": "how shall I pray to my father?"}, {"id": "pater-quote102", "translation": "I received Orestes for my father"}, {"id": "pater-quote103", "translation": "they conspired death for my unhappy father"}, {"id": "pater-quote104", "translation": "a bond for my unhappy father"}, {"id": "pater-quote105", "translation": "dearest of men to my father"}, {"id": "pater-quote106", "translation": "to this captain, my father"}, {"id": "pater-quote107", "translation": "having met my father"}, {"id": "pater-quote108", "translation": "my father Thyestes"}, {"id": "pater-quote109", "translation": "calling on my father"}, {"id": "pater-quote110", "translation": "it is necessary to address my father"}, {"id": "pater-quote111", "translation": "release my father for me"}, {"id": "pater-quote112", "translation": "you inquire well about my father"}, {"id": "pater-quote113", "translation": "he killed my father"}, {"id": "pater-quote114", "translation": "he bound his father, the aged Cronus"}, {"id": "pater-quote115", "translation": "the father of this my father"}, {"id": "pater-quote116", "translation": "I will teach your father"}, {"id": "pater-quote117", "translation": "our father, be of good courage"}, {"id": "pater-quote118", "translation": "O father Zeus"}, {"id": "pater-quote119", "translation": "come, gentle father, to the Darian land"}, {"id": "pater-quote120", "translation": "father Theoinus"}, {"id": "pater-quote121", "translation": "the lament of fathers and parents"}, {"id": "pater-quote122", "translation": "the great prosperity of fathers"}, {"id": "pater-word1", "translation": "father Zeus"}, {"id": "pater-word2", "translation": "father of men and gods"}, {"id": "pater-word3", "translation": "to the father"}, {"id": "pater-word4", "translation": "of the murder"}, {"id": "pater-word5", "translation": "to the father"}, {"id": "patesmos-orth1", "translation": "trampling"}, {"id": "patesmos-def1", "translation": "trampling"}, {"id": "patesmos-note1", "translation": "Not found elsewhere."}, {"id": "patesmos-quote1", "translation": "I would have prayed for the trampling of many garments"}, {"id": "patra-orth1", "translation": "fatherland"}, {"id": "patra-def1", "translation": "fatherland, a word common among epic, lyric, and tragic poets for the ordinary πατρίς [fatherland]."}, {"id": "patra-quote1", "translation": "to thrust me out of the house and fatherland"}, {"id": "patra-quote2", "translation": "and they dwelt in the fatherland"}, {"id": "patra-quote3", "translation": "a disgrace to the fatherland"}, {"id": "patra-word1", "translation": "fatherland"}, {"id": "patradelphea-orth1", "translation": "offspring of a paternal uncle"}, {"id": "patradelphea-def1", "translation": "offspring of a paternal uncle"}, {"id": "patradelphea-note1", "translation": "Thus Pauw corrected for πατραδελφίαν [offspring of a paternal uncle]."}, {"id": "patradelphea-quote1", "translation": "before ever having seized the marriage bed, which right forbids, to mount this offspring of a paternal uncle against their will"}, {"id": "patradelphea-word1", "translation": "offspring of a paternal uncle"}, {"id": "patrios-orth1", "translation": "of one's fathers, ancestral"}, {"id": "patrios-def1", "translation": "of one's fathers, ancestral"}]}