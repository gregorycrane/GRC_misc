{"units": [{"id": "perirrhytos-word3", "translation": "of sea-girt Scyros"}, {"id": "periseptos-orth1", "translation": "greatly honored"}, {"id": "periseptos-def1", "translation": "greatly honored"}, {"id": "periseptos-note1", "translation": "Thus Musgrave: in M περισέπται [greatly honored], with Ζτ. (i.e. Ζήτει [look it up]) written beside it."}, {"id": "periseptos-quote1", "translation": "greatly honored with honors and sacrifices"}, {"id": "periseptos-word1", "translation": "M περισέπται [greatly honored]"}, {"id": "periseptos-word2", "translation": "Ζτ"}, {"id": "periseptos-word3", "translation": "Ζήτει [look it up]"}, {"id": "perissos-orth1", "translation": "superfluous, useless"}, {"id": "perissos-def1", "translation": "superfluous, useless"}, {"id": "perissos-note1", "translation": "of useless toil"}, {"id": "perissos-quote1", "translation": "superfluous toil and light-minded folly"}, {"id": "perissos-quote2", "translation": "I bid you not to proclaim superfluous things to me"}, {"id": "perissophron-orth1", "translation": "exceedingly wise"}, {"id": "perissophron-def1", "translation": "exceedingly wise"}, {"id": "perissophron-quote1", "translation": "Do you not know precisely that you are exceedingly wise?"}, {"id": "peristello-orth1", "translation": "to tend, to care for"}, {"id": "peristello-def1", "translation": "to tend, to care for"}, {"id": "peristello-note1", "translation": "in spurious verses"}, {"id": "peristello-note2", "translation": "See similar things in Thes. vol. 6 p. 937."}, {"id": "peristello-quote1", "translation": "I advise you to honor that which is neither anarchic nor despotic, which the citizens tend"}, {"id": "peristichizo-orth1", "translation": "to surround with a net"}, {"id": "peristichizo-def1", "translation": "to surround with a net"}, {"id": "peristichizo-quote1", "translation": "I surround with an endless net, as for fish"}, {"id": "periphobos-orth1", "translation": "very fearful, terrified"}, {"id": "periphobos-def1", "translation": "very fearful, terrified"}, {"id": "periphobos-note1", "translation": "Portus conjectured that the adverb περιφόβως [fearfully] should be restored at Ch. 35 in place of περὶ φόβῳ [in fear]."}, {"id": "periphobos-quote1", "translation": "fear holds me terrified"}, {"id": "periphobos-word1", "translation": "περιφόβως [fearfully]"}, {"id": "periphobos-word2", "translation": "περὶ φόβῳ [in fear]"}, {"id": "periphron-orth1", "translation": "haughty, arrogant"}, {"id": "periphron-def1", "translation": "haughty, arrogant"}, {"id": "periphron-note1", "translation": "Περίφρονες δ᾽ ἄγαν [exceedingly haughty]"}, {"id": "periphron-note2", "translation": "ταν ἀνιέρω [the unholy one]. The scholiast explains it as ἀντὶ τοῦ ὑπέρφονες [instead of 'arrogant']. But Aeschylus wrote φυσίφρονες [proud by nature]: see φυσίφρων."}, {"id": "periphron-quote1", "translation": "you uttered haughty words"}, {"id": "periphron-quote2", "translation": "with unholy rage"}, {"id": "periphron-word1", "translation": "Περίφρονες δ᾽ ἄγαν [exceedingly haughty]"}, {"id": "periphron-word2", "translation": "ταν ἀνιέρω [the unholy one]"}, {"id": "periphron-word3", "translation": "ἀντὶ τοῦ ὑπέρφονες [instead of 'arrogant']"}, {"id": "periphron-word4", "translation": "φυσίφρονες [proud by nature]"}, {"id": "periphron-word5", "translation": "φυσίφρων [proud by nature]"}, {"id": "perichampta-orth1", "translation": "a corrupt word at Suppl. 856, not yet plausibly emended"}, {"id": "perichampta-def1", "translation": "a corrupt word at Suppl. 856, not yet plausibly emended"}, {"id": "periodynos-orth1", "translation": "causing pain"}, {"id": "periodynos-def1", "translation": "causing pain"}, {"id": "periodynos-quote1", "translation": "neither causing pain nor bed-ridden"}, {"id": "perraiboi-orth1", "translation": "Perrhaebi, a people of Thessaly"}, {"id": "perraiboi-def1", "translation": "Perrhaebi, a people of Thessaly, about which see Thes. vol. 6 p. 997."}, {"id": "perraiboi-def2", "translation": "Περραιβίδες [Perrhaebian Women] was the title of a tragedy by Aeschylus (fr. 183-185)."}, {"id": "perraiboi-note1", "translation": "I corrected the faulty accent Περραίβων [of the Perrhaebians]."}, {"id": "perraiboi-note2", "translation": "The correct spelling of the name is preserved in the Catalogue of plays: the dative Περραιβίσιν [to the Perrhaebian women] corrupted into περραιβοῖς [to the Perrhaebians] in Athen. 11 p. 476. 499, into περρέβην [Perrhaebian] in the codex of Hesychius s.v. ἀπαιόλη [deceit], about which I spoke in the Preface to Athen. vol. 1 p. IV."}, {"id": "perraiboi-quote1", "translation": "the land of the Perrhaebians"}, {"id": "perraiboi-word1", "translation": "Περραίβων [of the Perrhaebians]"}, {"id": "perraiboi-word2", "translation": "Περραιβίδες [Perrhaebian Women]"}, {"id": "perraiboi-word3", "translation": "Περραιβίσιν [to the Perrhaebian women]"}, {"id": "perraiboi-word4", "translation": "περραιβοῖς [to the Perrhaebians]"}, {"id": "perraiboi-word5", "translation": "περρέβην [Perrhaebian]"}, {"id": "perraiboi-word6", "translation": "ἀπαιόλη [deceit]"}, {"id": "persai-orth1", "translation": "Persians"}, {"id": "persai-def1", "translation": "Persians"}, {"id": "persai-def2", "translation": "Πέρσαι [Persians] was the title of a tragedy by Aeschylus."}, {"id": "persai-note1", "translation": "Genitive"}, {"id": "persai-note2", "translation": "Doric form"}, {"id": "persai-note3", "translation": "Dative"}, {"id": "persai-note4", "translation": "Accusative"}, {"id": "persai-note5", "translation": "Vocative"}, {"id": "persai-word1", "translation": "Πέρσαι [Persians]"}, {"id": "perseptolis-orth1", "translation": "sacker of cities"}, {"id": "perseptolis-def1", "translation": "sacker of cities"}, {"id": "perseptolis-quote1", "translation": "the city-sacking royal army"}, {"id": "perseus-orth1", "translation": "Perseus, son of Jupiter and Danaë"}, {"id": "perseus-def1", "translation": "Perseus, son of Jupiter and Danaë"}, {"id": "perseus-quote1", "translation": "having held the heart of Perseus in his thoughts"}, {"id": "persephassa-orth1", "translation": "Proserpina, daughter of Jupiter and Ceres"}, {"id": "persephassa-def1", "translation": "Proserpina, daughter of Jupiter and Ceres"}, {"id": "persephassa-note1", "translation": "On the various forms of this name see Thes. vol. 6 p. 1000."}, {"id": "persephassa-quote1", "translation": "O Persephassa"}, {"id": "persikos-orth1", "translation": "Persian"}, {"id": "persikos-def1", "translation": "Persian"}, {"id": "persikos-quote1", "translation": "of the Persian army"}, {"id": "persikos-quote2", "translation": "with Persian robes"}, {"id": "persikos-quote3", "translation": "the running of a Persian light is fitting to learn"}, {"id": "persikos-quote4", "translation": "to the Persian army"}, {"id": "persikos-quote5", "translation": "of the Persian army"}, {"id": "persikos-quote6", "translation": "to the Persian race"}, {"id": "persikos-quote7", "translation": "the Persian people"}, {"id": "persis-orth1", "translation": "Persian (feminine)"}, {"id": "persis-def1", "translation": "Persian (feminine)"}, {"id": "persis-def2", "translation": "Persian woman"}, {"id": "persis-note1", "translation": "of the land"}, {"id": "persis-note2", "translation": "ἄνθος [flower]"}, {"id": "persis-note3", "translation": "ἄνασσα [queen]"}, {"id": "persis-note4", "translation": "Περσίδων [of Persian women]"}, {"id": "persis-quote1", "translation": "the sound of the Persian tongue"}, {"id": "persis-quote2", "translation": "of the Persian land"}, {"id": "persis-quote3", "translation": "Persian land"}, {"id": "persis-quote4", "translation": "Persian women, delicate in their grief"}, {"id": "persis-quote5", "translation": "highest of Persian women"}, {"id": "persis-quote6", "translation": "many"}, {"id": "persis-quote7", "translation": "and the Persian women, delicate in their lamentation"}, {"id": "persis-word1", "translation": "ἄνθος [flower]"}, {"id": "persis-word2", "translation": "ἄνασσα [queen]"}, {"id": "persis-word3", "translation": "Περσίδων [of Persian women]"}, {"id": "personomeomai-orth1", "translation": "to be governed by Persian laws"}, {"id": "personomeomai-def1", "translation": "to be governed by Persian laws"}, {"id": "personomeomai-quote1", "translation": "and they are no longer governed by Persian laws"}, {"id": "personomos-orth1", "translation": "ruling over Persians"}, {"id": "personomos-def1", "translation": "ruling over Persians"}, {"id": "personomos-quote1", "translation": "of great Persian-ruling honor"}, {"id": "pesema-orth1", "translation": "fall, stumble"}, {"id": "pesema-def1", "translation": "fall, stumble"}, {"id": "pesema-note1", "translation": "It is found once in Sophocles Ai. 1033, more often in Euripides: see Thes. vol. 6 p. 1003."}, {"id": "pesema-quote1", "translation": "many falls of men happen before"}, {"id": "pessonomeo-orth1", "translation": "to arrange pieces, to play at draughts"}, {"id": "pessonomeo-def1", "translation": "to arrange pieces, to play at draughts"}]}