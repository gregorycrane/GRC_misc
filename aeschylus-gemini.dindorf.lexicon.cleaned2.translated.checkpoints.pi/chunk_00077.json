{"units": [{"id": "polymnestos-note1", "translation": "Τούτων θεοῖσι χρὴ πολύμνηστον [Of these things to the gods it is necessary to pay a much-remembered]"}, {"id": "polymnestos-note2", "translation": "Φορμα Δορικα [Doric form]"}, {"id": "polymnestos-note3", "translation": "Πολύμναστον [much-remembered]"}, {"id": "polymnestos-quote1", "translation": "to pay gratitude"}, {"id": "polymnestos-quote2", "translation": "you have brought upon yourself unwashed blood"}, {"id": "polymnestos-word1", "translation": "Of these things to the gods it is necessary to pay a much-remembered"}, {"id": "polymnestos-word2", "translation": "Doric form"}, {"id": "polymnestos-word3", "translation": "much-remembered"}, {"id": "polymnestor-orth1", "translation": "much-remembering, mindful"}, {"id": "polymnestor-def1", "translation": "much or well remembering"}, {"id": "polymnestor-note1", "translation": "Γενοῦ πολυμνᾶστορ, ἐφάπτορ [Become a much-remembering avenger]"}, {"id": "polymnestor-note2", "translation": "where M has πολυμνήστωρ [much-remembering], Hermann has πολυμνῆστορ [much-remembering]"}, {"id": "polymnestor-quote1", "translation": "of Io"}, {"id": "polymnestor-word1", "translation": "Become a much-remembering avenger"}, {"id": "polymnestor-word2", "translation": "πολυμνήστωρ [much-remembering] M, πολυμνῆστορ [much-remembering]"}, {"id": "polynaotes-orth1", "translation": "leading many ships"}, {"id": "polynaotes-def1", "translation": "leading many ships"}, {"id": "polynaotes-note1", "translation": "Πολύχειρ καὶ [Many-handed and]"}, {"id": "polynaotes-note2", "translation": "Σικ απρογρ. προ πολυ-ναύτης, θυο εστ εν Μ. [The scholiast in the margin has πολυ-ναύτης [many-shipped], which is in M.]"}, {"id": "polynaotes-quote1", "translation": "many-shipped"}, {"id": "polynaotes-word1", "translation": "Many-handed and"}, {"id": "polynaotes-word2", "translation": "The scholiast in the margin has πολυ-ναύτης [many-shipped], which is in M"}, {"id": "polyneikes-orth1", "translation": "much-quarreling"}, {"id": "polyneikes-def1", "translation": "much-quarreling"}, {"id": "polyneikes-note1", "translation": "Ὀρ-θῶς κατ᾽ ἐπωνυμίαν καὶ πολυνεικεῖς [Rightly according to the name and much-quarreling]"}, {"id": "polyneikes-note2", "translation": "where there is an allusion to the name of Polynices"}, {"id": "polyneikes-quote1", "translation": "they perished"}, {"id": "polyneikes-word1", "translation": "Rightly according to the name and much-quarreling"}, {"id": "polyneikes-proper-orth1", "translation": "Polynices, son of Oedipus"}, {"id": "polyneikes-proper-def1", "translation": "Polynices, son of Oedipus"}, {"id": "polyneikes-proper-note1", "translation": "Πολυνείκους [of Polynices]"}, {"id": "polyneikes-proper-note2", "translation": "Ἐπωνύμῳ δὲ κάρτα, [And very much by the name,]"}, {"id": "polyneikes-proper-note3", "translation": "σικ απρογρ.: πολυνείκει Μ [the scholiast in the margin: πολυνείκει [much-quarreling] M]"}, {"id": "polyneikes-proper-note4", "translation": "Τόνδε Πολυνείκους [This of Polynices]"}, {"id": "polyneikes-proper-note5", "translation": "Τοὺς κλάοντας [Those weeping]"}, {"id": "polyneikes-proper-quote1", "translation": "violence"}, {"id": "polyneikes-proper-quote2", "translation": "I say Polynices"}, {"id": "polyneikes-proper-quote3", "translation": "corpse"}, {"id": "polyneikes-proper-quote4", "translation": "Polynices"}, {"id": "polyneikes-proper-word1", "translation": "of Polynices"}, {"id": "polyneikes-proper-word2", "translation": "And very much by the name"}, {"id": "polyneikes-proper-word3", "translation": "the scholiast in the margin: πολυνείκει [much-quarreling] M"}, {"id": "polyneikes-proper-word4", "translation": "This of Polynices"}, {"id": "polyneikes-proper-word5", "translation": "Those weeping"}, {"id": "polyxenos-orth1", "translation": "having many guests, receiving many as guests"}, {"id": "polyxenos-def1", "translation": "having many guests, receiving many as guests"}, {"id": "polyxenos-note1", "translation": "Ζαγρεῖ τε νῦν με καὶ [And now to Zagreus me and]"}, {"id": "polyxenos-note2", "translation": "πατρί [to the father] Hermann adds"}, {"id": "polyxenos-note3", "translation": "Τὸν πολυξενώτατον [The most hospitable]"}, {"id": "polyxenos-quote1", "translation": "to rejoice in the much-hospitable"}, {"id": "polyxenos-quote2", "translation": "Zeus of the dead"}, {"id": "polyxenos-word1", "translation": "And now to Zagreus me and"}, {"id": "polyxenos-word2", "translation": "to the father"}, {"id": "polyxenos-word3", "translation": "The most hospitable"}, {"id": "polypenthes-orth1", "translation": "much-grieving, mournful"}, {"id": "polypenthes-def1", "translation": "much-grieving, mournful"}, {"id": "polypenthes-note1", "translation": "Μόρον τῶν οἰχομένων (συμπλεβι βερσυμ θυι [the fate of the departed (the complete verse which]"}, {"id": "polypenthes-note2", "translation": "εχχιδιτ, βελυτ φρενὸς ἐκ φιλίας θρηνῶν παιᾶν᾽ [he cites, but φρενὸς ἐκ φιλίας θρηνῶν παιᾶν᾽ [from a loving heart raising a mournful paean]]"}, {"id": "polypenthes-quote1", "translation": "from a loving heart raising a mournful paean) I lift up duly the much-grieving"}, {"id": "polypenthes-word1", "translation": "the fate of the departed (the complete verse which"}, {"id": "polypenthes-word2", "translation": "he cites, but φρενὸς ἐκ φιλίας θρηνῶν παιᾶν᾽ [from a loving heart raising a mournful paean]"}, {"id": "polyplagktos-orth1", "translation": "much-wandering"}, {"id": "polyplagktos-def1", "translation": "much-wandering"}, {"id": "polyplagktos-note1", "translation": "Πολύπλαγκτον ἀθλίαν [Much-wandering wretched]"}, {"id": "polyplagktos-quote1", "translation": "gadfly-driven Io"}, {"id": "polyplagktos-word1", "translation": "Much-wandering wretched"}, {"id": "polyplanetos-orth1", "translation": "much-wandering"}, {"id": "polyplanetos-def1", "translation": "much-wandering"}, {"id": "polyplanetos-note1", "translation": "Πολυπλάνητα δ᾽ ἦν ἰδεῖν ἐπασσυτεροτριβή τὰ χερός [And it was possible to see the much-wandering, constantly-rubbing hands]"}, {"id": "polyplanetos-note2", "translation": "Σικ Βλομφιελδυς προ πολύ-πλαγκτα, θυο εστ εν Μ, α μανυ σεχυνδα εν πολυπάλαγκτα μυτατυμ. [The scholiast of Blomfield has πολύ-πλαγκτα [much-wandering], which is in M, but many manuscripts have πολυπάλαγκτα [much-wandering].]"}, {"id": "polyplanetos-quote1", "translation": "stretchings"}, {"id": "polyplanetos-word1", "translation": "And it was possible to see the much-wandering, constantly-rubbing hands"}, {"id": "polyplanetos-word2", "translation": "The scholiast of Blomfield has πολύ-πλαγκτα [much-wandering], which is in M, but many manuscripts have πολυπάλαγκτα [much-wandering]"}, {"id": "polyplanos-orth1", "translation": "much-wandering, much-roaming"}, {"id": "polyplanos-def1", "translation": "much-wandering, much-roaming"}, {"id": "polyplanos-note1", "translation": "Ἄδην με πολύπλανοι πλάναι [Much-wandering wanderings have]"}, {"id": "polyplanos-note2", "translation": "πλάνοι Μ [wanderings M]"}, {"id": "polyplanos-quote1", "translation": "they have exercised"}, {"id": "polyplanos-word1", "translation": "Much-wandering wanderings have"}, {"id": "polyplanos-word2", "translation": "wanderings M"}, {"id": "polyponos-orth1", "translation": "much-toiling, calamitous"}, {"id": "polyponos-def1", "translation": "much-toiling, calamitous"}, {"id": "polyponos-def2", "translation": "causing many labors"}, {"id": "polyponos-note1", "translation": "Φύλακα [Guard]"}, {"id": "polyponos-note2", "translation": "[Πολυπονώτατοι ρεχτε εν πολυστονώτατοι μυτα-τυμ αβ Ροβορτελλο. [Πολυπονώτατοι [most toiling] is read as πολυστονώτατοι [most groaning] by Robortello.]]"}, {"id": "polyponos-note3", "translation": "Πολύπονον [Much-toiling]"}, {"id": "polyponos-quote1", "translation": "of much-toiling mortals"}, {"id": "polyponos-quote2", "translation": "wielding the spear"}, {"id": "polyponos-word1", "translation": "Guard"}, {"id": "polyponos-word2", "translation": "Πολυπονώτατοι [most toiling] is read as πολυστονώτατοι [most groaning] by Robortello"}, {"id": "polyponos-word3", "translation": "Much-toiling"}, {"id": "polyphyros-orth1", "translation": "abounding in wheat"}, {"id": "polyphyros-def1", "translation": "abounding in wheat"}, {"id": "polyphyros-note1", "translation": "Τὰν Ἀφροδίτας [The of Aphrodite]"}, {"id": "polyphyros-quote1", "translation": "wheat-rich land"}, {"id": "polyphyros-word1", "translation": "The of Aphrodite"}, {"id": "polyrrhenos-orth1", "translation": "having many sheep or much cattle"}, {"id": "polyrrhenos-def1", "translation": "having many sheep or much cattle"}, {"id": "polyrrhenos-note1", "translation": "Πολύρρηνον πατρίδα [Sheep-rich fatherland]"}, {"id": "polyrrhenos-quote1", "translation": "defending"}, {"id": "polyrrhenos-word1", "translation": "Sheep-rich fatherland"}, {"id": "polyrrothos-orth1", "translation": "much-sounding, noisy"}, {"id": "polyrrothos-def1", "translation": "much-sounding, noisy"}, {"id": "polyrrothos-note1", "translation": "Φροιμίοις [With preludes]"}]}