{"units": [{"id": "porphyroeides-word1", "translation": "And cast into the purple-dark lake the black-yoked [one]"}, {"id": "porphyroeides-word2", "translation": "purple-dark sea"}, {"id": "porphyrostrotos-orth1", "translation": "strewn with purple carpets"}, {"id": "porphyrostrotos-def1", "translation": "strewn with purple carpets"}, {"id": "porphyrostrotos-note1", "translation": "Let it be"}, {"id": "porphyrostrotos-quote1", "translation": "a path strewn with purple"}, {"id": "porphyrostrotos-word1", "translation": "Let it be"}, {"id": "poseidon-orth1", "translation": "Poseidon"}, {"id": "poseidon-def1", "translation": "Neptune"}, {"id": "poseidon-def2", "translation": "Doric form"}, {"id": "poseidon-note1", "translation": "Τρίαιναν, αἰ-χμὴν τὴν [the trident, the spear]"}, {"id": "poseidon-note2", "translation": "Ποσειδώνος [of Poseidon]"}, {"id": "poseidon-note3", "translation": "Ποντομέδων ἄναξ ἰχθυβόλῳ μαχανᾷ [lord ruling the sea with fish-catching device]"}, {"id": "poseidon-note4", "translation": "Ποσειδᾶν ὁ [Poseidon the]"}, {"id": "poseidon-note5", "translation": "Nam hic rectus est accentus, non quo editores scripserunt Ποσειδάν: v. H. L. Ahrens in Philol. vol. 23 p. 17."}, {"id": "poseidon-quote1", "translation": "of Poseidon"}, {"id": "poseidon-quote2", "translation": "power"}, {"id": "poseidon-quote3", "translation": "Poseidon"}, {"id": "poseidon-quote4", "translation": "earth-holder"}, {"id": "poseidon-word1", "translation": "the trident, the spear"}, {"id": "poseidon-word2", "translation": "of Poseidon"}, {"id": "poseidon-word3", "translation": "lord ruling the sea with fish-catching device"}, {"id": "poseidon-word4", "translation": "Poseidon the"}, {"id": "poseidon-word5", "translation": "For here the accent is correct, not as the editors wrote Ποσειδάν: see H. L. Ahrens in Philol. vol. 23 p"}, {"id": "posis-husband-orth1", "translation": "husband"}, {"id": "posis-husband-def1", "translation": "husband"}, {"id": "posis-husband-note1", "translation": "Παιδα τὸν αὑτᾶς [her child]"}, {"id": "posis-husband-note2", "translation": "Σὸν [your]"}, {"id": "posis-husband-note3", "translation": "Τὸν ἐμὸν αἰδοῖον [my revered one]"}, {"id": "posis-husband-note4", "translation": "Τοῦτ᾽ [this]"}, {"id": "posis-husband-note5", "translation": "Τὸν ὁμοδέμνιον [the one sharing the bed]"}, {"id": "posis-husband-note6", "translation": "Ἀγαμέμνων, ἐμὸς [Agamemnon, my]"}, {"id": "posis-husband-quote1", "translation": "having made him her husband"}, {"id": "posis-husband-quote2", "translation": "husband Darius"}, {"id": "posis-husband-quote3", "translation": "husband"}, {"id": "posis-husband-quote4", "translation": "announce to your husband"}, {"id": "posis-husband-quote5", "translation": "husband"}, {"id": "posis-husband-quote6", "translation": "husband"}, {"id": "posis-husband-word1", "translation": "her child"}, {"id": "posis-husband-word2", "translation": "your"}, {"id": "posis-husband-word3", "translation": "my revered one"}, {"id": "posis-husband-word4", "translation": "this"}, {"id": "posis-husband-word5", "translation": "the one sharing the bed"}, {"id": "posis-husband-word6", "translation": "Agamemnon, my"}, {"id": "posis-drink-orth1", "translation": "drink"}, {"id": "posis-drink-def1", "translation": "drink"}, {"id": "posis-drink-note1", "translation": "Ἄκρατον αἷμα πίεται [he will drink unmixed blood]"}, {"id": "posis-drink-quote1", "translation": "third drink"}, {"id": "posis-drink-word1", "translation": "he will drink unmixed blood"}, {"id": "posos-orth1", "translation": "how great?"}, {"id": "posos-def1", "translation": "how great?"}, {"id": "posos-note1", "translation": "Πόσον τι πλῆθος ἣν νεῶν Ἑλληνίδων; [How great was the number of Greek ships?]"}, {"id": "posos-note2", "translation": "Sic Turnebus pro δή"}, {"id": "posos-word1", "translation": "How great was the number of Greek ships"}, {"id": "posos-word2", "translation": "Thus Turnebus for δή"}, {"id": "potainios-orth1", "translation": "new, unexpected"}, {"id": "potainios-def1", "translation": "new, unexpected"}, {"id": "potainios-def2", "translation": "fresh"}, {"id": "potainios-note1", "translation": "Οὐδὲ μοι ποταίνιον πῆμ᾽ οὐδὲν [no new suffering to me]"}, {"id": "potainios-note2", "translation": "Πο-ταίνιον κλύουσα πάταγον ἄμμιγα, [hearing a fresh din mixed together,]"}, {"id": "potainios-note3", "translation": "ubi ποτίφα-τον κλύουσα πάταγον ἀναμίξ correxit Heimsoe-thius, ut postulat metrum versus strophici."}, {"id": "potainios-note4", "translation": "For the blood is fresh to you"}, {"id": "potainios-note5", "translation": "For being fresh, it was driven away by purifications at the hearth of the god Phoebus"}, {"id": "potainios-quote1", "translation": "will come"}, {"id": "potainios-quote2", "translation": "with hands still"}, {"id": "potainios-quote3", "translation": "that have slain swine"}, {"id": "potainios-word1", "translation": "No fresh woe to me at all"}, {"id": "potainios-word2", "translation": "hearing a fresh din mixed together"}, {"id": "potainios-word3", "translation": "where hearing a fresh din mixed together, corrected by Heimsoethius, as the meter of the strophic verse demands"}, {"id": "potainios-word4", "translation": "For the blood is fresh to you"}, {"id": "potainios-word5", "translation": "For being fresh, it was driven away by purifications at the hearth of the god Phoebus"}, {"id": "potamios-orth1", "translation": "of a river"}, {"id": "potamios-def1", "translation": "of a river"}, {"id": "potamios-note1", "translation": "It cries out by the banks"}, {"id": "potamios-quote1", "translation": "of a river"}, {"id": "potamios-word1", "translation": "It cries out by the banks"}, {"id": "potamos-orth1", "translation": "river"}, {"id": "potamos-def1", "translation": "river"}, {"id": "potamos-note1", "translation": "And of rivers"}, {"id": "potamos-note2", "translation": "From where they will one day burst forth"}, {"id": "potamos-note3", "translation": "And springs of holy-flowing streams"}, {"id": "potamos-note4", "translation": "And you will come to the insolent"}, {"id": "potamos-note5", "translation": "There"}, {"id": "potamos-note6", "translation": "There"}, {"id": "potamos-note7", "translation": "Not crossing the ford of the Halys"}, {"id": "potamos-note8", "translation": "From the lands and rivers"}, {"id": "potamos-note9", "translation": "where ποταμῶν τ᾽ [and of rivers] is suspected, for which ποθ᾽ ἑῶν [once of their own] is conjectured. χλωρῶν πετάλων ἐγρομένα [awakened from green leaves] Hermannus, which H. Bossius expressed in his German translation \"von des Hains Schatten gescheucht\"."}, {"id": "potamos-note10", "translation": "And a multitude of evils"}, {"id": "potamos-note11", "translation": "Of the earth"}, {"id": "potamos-note12", "translation": "And rivers that through the land a gentle drink"}, {"id": "potamos-note13", "translation": "River Caicus, hail first"}, {"id": "potamos-note14", "translation": "Of Inachus the Argive"}, {"id": "potamos-note15", "translation": "Spercheus"}, {"id": "potamos-note16", "translation": "Upstream"}, {"id": "potamos-note17", "translation": "a proverbial expression for things that happen contrary to expectation, as Hesychius notes."}, {"id": "potamos-quote1", "translation": "springs"}, {"id": "potamos-quote2", "translation": "rivers of fire"}, {"id": "potamos-quote3", "translation": "of rivers"}, {"id": "potamos-quote4", "translation": "river"}, {"id": "potamos-quote5", "translation": "the river breathes forth fury"}, {"id": "potamos-quote6", "translation": "the river Aethiops"}, {"id": "potamos-quote7", "translation": "of the river"}, {"id": "potamos-quote8", "translation": "being shut in"}, {"id": "potamos-quote9", "translation": "as a river comes on"}, {"id": "potamos-quote10", "translation": "ever-flowing rivers"}, {"id": "potamos-quote11", "translation": "they pour"}, {"id": "potamos-quote12", "translation": "of birds"}, {"id": "potamos-quote13", "translation": "of a river"}, {"id": "potamos-quote14", "translation": "O river"}, {"id": "potamos-quote15", "translation": "of rivers"}, {"id": "potamos-word1", "translation": "And of rivers"}, {"id": "potamos-word2", "translation": "From where they will one day burst forth"}, {"id": "potamos-word3", "translation": "And springs of holy-flowing streams"}, {"id": "potamos-word4", "translation": "And you will come to the insolent"}, {"id": "potamos-word5", "translation": "There"}, {"id": "potamos-word6", "translation": "There"}, {"id": "potamos-word7", "translation": "Not crossing the ford of the Halys"}, {"id": "potamos-word8", "translation": "From the lands and rivers"}, {"id": "potamos-word9", "translation": "and of rivers, for which once of their own is conjectured. awakened from green leaves"}, {"id": "potamos-word10", "translation": "which H. Bossius expressed in his German translation \"von des Hains Schatten gescheucht\""}, {"id": "potamos-word11", "translation": "And a multitude of evils"}, {"id": "potamos-word12", "translation": "Of the earth"}]}