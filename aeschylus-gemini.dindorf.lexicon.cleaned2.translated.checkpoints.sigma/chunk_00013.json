{"units": [{"id": "sos-quote38", "translation": "I speak of your mother."}, {"id": "sos-quote39", "translation": "these your contests"}, {"id": "sos-quote40", "translation": "I lament over your toils."}, {"id": "sos-quote41", "translation": "having seen your body"}, {"id": "sos-quote42", "translation": "about your fortunes"}, {"id": "sos-quote43", "translation": "he is not distressed at your toils."}, {"id": "sos-quote44", "translation": "your word"}, {"id": "sos-quote45", "translation": "with your loud-lamenting woes"}, {"id": "sos-quote46", "translation": "having looked upon your destructive fortunes"}, {"id": "sos-quote47", "translation": "your bed"}, {"id": "sos-quote48", "translation": "I shrink from troubling your mind."}, {"id": "sos-quote49", "translation": "your work"}, {"id": "sos-quote50", "translation": "the end of your wanderings"}, {"id": "sos-quote51", "translation": "but yours is to be silent"}, {"id": "sos-quote52", "translation": "by your haste"}, {"id": "sos-quote53", "translation": "your husband Darius"}, {"id": "sos-quote54", "translation": "to your son Xerxes"}, {"id": "sos-quote55", "translation": "persuaded by your laments"}, {"id": "sos-quote56", "translation": "revering your power, Clytemnestra"}, {"id": "sos-quote57", "translation": "master of my pledges and yours"}, {"id": "sos-quote58", "translation": "around your shores"}, {"id": "sos-quote59", "translation": "O father, of you and of your noble children (thus Auratus for 'of the')"}, {"id": "sos-quote60", "translation": "who is an accomplice in your murder"}, {"id": "sos-quote61", "translation": "the work of your hand"}, {"id": "sos-quote62", "translation": "unbearable for your life"}, {"id": "sos-quote63", "translation": "I will obey these words of yours."}, {"id": "sos-quote64", "translation": "the hearth of your house"}, {"id": "sos-quote65", "translation": "I will teach your father."}, {"id": "sos-quote66", "translation": "and your entire yoke of the balance"}, {"id": "sos-word1", "translation": "your (feminine), your (neuter)"}, {"id": "sos-word2", "translation": "about your (masculine/neuter)"}, {"id": "sos-word3", "translation": "your (Epic/Ionic)"}, {"id": "sosthanes-orth1", "translation": "Sosthanes"}, {"id": "sosthanes-def1", "translation": "Sosthanes, a Persian proper name."}, {"id": "sosthanes-note1", "translation": "where in some copies σωσθάνης [Sosthanes]."}, {"id": "sosthanes-quote1", "translation": "in anapaests: Sosthanes, driver of horses"}, {"id": "sosthanes-word1", "translation": "Sosthanes"}, {"id": "soumai-orth1", "translation": "to rush, hasten"}, {"id": "soumai-def1", "translation": "(contracted from σόομαι [to rush]) the same as σεύομαι [to rush], I am driven swiftly, I hasten."}, {"id": "soumai-note1", "translation": "σοῦται [he rushes] corrupted from οὐτῷ [to him] in M."}, {"id": "soumai-quote1", "translation": "the kings, subjects of the great king, rush."}, {"id": "soumai-quote2", "translation": "hasten, all of you, rush with full armor."}, {"id": "soumai-quote3", "translation": "rush, rush to the ship."}, {"id": "soumai-quote4", "translation": "rush, rush to the sheaves."}, {"id": "soumai-word1", "translation": "to rush"}, {"id": "soumai-word2", "translation": "to rush"}, {"id": "soumai-word3", "translation": "he rushes"}, {"id": "soumai-word4", "translation": "to him"}, {"id": "sousa-orth1", "translation": "Susa"}, {"id": "sousa-def1", "translation": "Susa, the royal city of the Persians."}, {"id": "sousa-quote1", "translation": "the citadel of Susa and Ecbatana and the ancient Cissian fortress."}, {"id": "sousa-quote2", "translation": "the city of Susa and Ecbatana."}, {"id": "sousa-quote3", "translation": "the whole city of Susa"}, {"id": "sousa-quote4", "translation": "this city of Susa"}, {"id": "sousas-orth1", "translation": "Susas"}, {"id": "sousas-def1", "translation": "Susas, a Persian proper name."}, {"id": "sousigenes-orth1", "translation": "born in Susa"}, {"id": "sousigenes-def1", "translation": "born in Susa."}, {"id": "sousigenes-quote1", "translation": "the Susa-born god of the Persians"}, {"id": "sousis-orth1", "translation": "Susa"}, {"id": "sousis-def1", "translation": "Susa."}, {"id": "sousis-note1", "translation": "where M has σουσίδες φίλος [Sousides, friend]"}, {"id": "sousis-note2", "translation": "ἄκτωρ [leader], with o written over e, one should not write Σουσίδος [of Susa], but with several copies Σουσίδαις [to the Susians], from the ethnic adjective Σουσίδης [Susian]."}, {"id": "sousis-quote1", "translation": "the great empty city of Susa"}, {"id": "sousis-word1", "translation": "M σουσίδες φίλος [Sousides, friend]"}, {"id": "sousis-word2", "translation": "leader"}, {"id": "sousis-word3", "translation": "of Susa"}, {"id": "sousis-word4", "translation": "to the Susians"}, {"id": "sousis-word5", "translation": "Susian"}, {"id": "sousiskanes-orth1", "translation": "Susiscanes"}, {"id": "sousiskanes-def1", "translation": "Susiscanes, a Persian proper name."}, {"id": "sousiskanes-note1", "translation": "in anapaests. Where the scholiast says: τινὲς διαιροῦσι Σουσισκάνης καὶ Πηγάς Ταγών [some divide Susiscanes and Pegas Tagon]. They therefore wrote Σοῦσις, Κάνης, Πηγάς, Ταγών [Susis, Canes, Pegas, Tagon], undoubtedly wrongly."}, {"id": "sousiskanes-note2", "translation": "Σουσισκάνης [Susiscanes] likewise in anapaests, see"}, {"id": "sousiskanes-quote1", "translation": "Susiscanes, Pegastagon, Egyptian-born"}, {"id": "sousiskanes-word1", "translation": "some divide Susiscanes and Pegas Tagon"}, {"id": "sousiskanes-word2", "translation": "Susis, Canes, Pegas, Tagon"}, {"id": "sousiskanes-word3", "translation": "Susiscanes"}, {"id": "sofisma-orth1", "translation": "clever device, art"}, {"id": "sofisma-def1", "translation": "clever device, art."}, {"id": "sofisma-quote1", "translation": "number, outstanding among inventions, they discovered for themselves."}, {"id": "sofisma-quote2", "translation": "I have no device by which I may escape from the present calamity."}, {"id": "sofisma-quote3", "translation": "he strengthens with a weak device."}, {"id": "sofistes-orth1", "translation": "clever contriver, inventor of pains"}, {"id": "sofistes-def1", "translation": "clever contriver, inventor of pains."}, {"id": "sofistes-quote1", "translation": "so that he may learn, being a clever contriver, that he is more foolish than Zeus."}, {"id": "sofistes-quote2", "translation": "you, the clever contriver (Prometheus), I mean."}, {"id": "sofistes-quote3", "translation": "whether then a clever contriver, a clever contriver, striking the lyre beautifully (Butler: 'very') out of tune."}, {"id": "sofos-orth1", "translation": "wise, prudent"}, {"id": "sofos-def1", "translation": "wise, prudent."}, {"id": "sofos-def2", "translation": "Comparative."}, {"id": "sofos-note1", "translation": "The reliability of these words is uncertain, about which I have spoken in the annotation. Hermann attempted to restore the metrical form: ὡς σοφοῖσι πρὸς σοφούς | ἐστὶ κηδεία [as for the wise, there is kinship with the wise]."}, {"id": "sofos-quote1", "translation": "either wise, or wise, he who first in his mind bore this."}, {"id": "sofos-quote2", "translation": "those who worship Adrasteia are wise."}, {"id": "sofos-quote3", "translation": "the wise good counsel"}, {"id": "sofos-quote4", "translation": "for it is shameful for a wise man to err."}, {"id": "sofos-quote5", "translation": "the wise seer, son of Oicles"}]}