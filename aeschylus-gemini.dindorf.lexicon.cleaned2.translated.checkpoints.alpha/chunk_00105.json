{"units": [{"id": "ataretos-quote1", "translation": "You will come to the fearless army of the Ligurians."}, {"id": "ataurotos-orth1", "translation": "unmated with a bull"}, {"id": "ataurotos-def1", "translation": "unmated with a bull"}, {"id": "ataurotos-note1", "translation": "Of a girl who has not yet known a man"}, {"id": "ataurotos-quote1", "translation": "pure and unmated with a bull."}, {"id": "atenktos-orth1", "translation": "unyielding, hard, immovable"}, {"id": "atenktos-def1", "translation": "whose heart cannot be softened, hard, immovable"}, {"id": "atenktos-quote1", "translation": "a man unyielding to consolations."}, {"id": "atekmartos-orth1", "translation": "not to be conjectured"}, {"id": "atekmartos-def1", "translation": "who cannot be grasped by conjecture"}, {"id": "atekmartos-note1", "translation": "i.e. of misfortune, whose nature and extent you cannot calculate, as Schuetz interprets it."}, {"id": "atekmartos-quote1", "translation": "having met with this most unguessable hateful fate,"}, {"id": "ateknos-orth1", "translation": "childless"}, {"id": "ateknos-def1", "translation": "lacking children"}, {"id": "ateknos-quote1", "translation": "Or shall I weep for the toiling and unfortunate childless war-chiefs?"}, {"id": "ateknos-quote2", "translation": "a leafless, childless lichen."}, {"id": "ateleia-orth1", "translation": "exemption from public burdens"}, {"id": "ateleia-def1", "translation": "exemption from public burdens"}, {"id": "ateleia-quote1", "translation": "to accomplish the gods' exemption in answer to my prayers."}, {"id": "ateleutos-orth1", "translation": "endless"}, {"id": "ateleutos-def1", "translation": "having no end"}, {"id": "ateleutos-quote1", "translation": "the fate that always brings endless sleep upon us."}, {"id": "atenes-orth1", "translation": "hard, unyielding"}, {"id": "atenes-def1", "translation": "hard"}, {"id": "atenes-quote1", "translation": "will soften the hard angers of the fireless sacrifices."}, {"id": "ater-orth1", "translation": "without"}, {"id": "ater-def1", "translation": "without"}, {"id": "ater-quote1", "translation": "guiding the bird by thought without bridles."}, {"id": "ater-quote2", "translation": "without judgment."}, {"id": "ater-quote3", "translation": "without deeds."}, {"id": "ater-quote4", "translation": "without shame."}, {"id": "ater-quote5", "translation": "without birth."}, {"id": "ater-quote6", "translation": "without blame."}, {"id": "ater-quote7", "translation": "without lamentations."}, {"id": "ater-quote8", "translation": "without evils."}, {"id": "ater-quote9", "translation": "without wings."}, {"id": "ater-quote10", "translation": "without compulsion."}, {"id": "ater-quote11", "translation": "without harm."}, {"id": "ater-quote12", "translation": "without sufferings."}, {"id": "ater-quote13", "translation": "without justice."}, {"id": "ateramnos-orth1", "translation": "hard, inexorable"}, {"id": "ateramnos-def1", "translation": "hard, inexorable"}, {"id": "ateramnos-quote1", "translation": "having laid low her unyielding anger."}, {"id": "ateramnos-quote2", "translation": "the unyielding roar of thunder."}, {"id": "aterthe-orth1", "translation": "without"}, {"id": "aterthe-def1", "translation": "without"}, {"id": "aterthe-quote1", "translation": "without wings."}, {"id": "aterthe-quote2", "translation": "to dwell apart from servants."}, {"id": "atermon-orth1", "translation": "boundless"}, {"id": "atermon-def1", "translation": "having no end"}, {"id": "atermon-note1", "translation": "which garment he called an endless net in Ag. 1382."}, {"id": "atermon-quote1", "translation": "and in a boundless, cunningly wrought robe she strikes him, having entangled him."}, {"id": "atermon-word1", "translation": "endless net"}, {"id": "aterpes-orth1", "translation": "joyless"}, {"id": "aterpes-def1", "translation": "not rejoicing"}, {"id": "aterpes-def2", "translation": "not causing joy"}, {"id": "aterpes-quote1", "translation": "a swarm of diseases — joyless."}, {"id": "aterpes-quote2", "translation": "you will guard this joyless rock."}, {"id": "ate-orth1", "translation": "ruin, harm"}, {"id": "ate-def1", "translation": "ruin, harm"}, {"id": "ate-def2", "translation": "Ate, the goddess"}, {"id": "ate-note1", "translation": "[in a verse quoted from elsewhere"}, {"id": "ate-note2", "translation": "Thus Blomfield for προσάψαι [to attach]."}, {"id": "ate-note3", "translation": "[in a spurious verse"}, {"id": "ate-note4", "translation": "Thus Hermann for εἰς ἀρκύστατα [into the nets]. And the scholiast seems to have read Ata, who appended the Homeric verse about Ate. To the same can be referred some examples mentioned above."}, {"id": "ate-quote1", "translation": "toward the waves of hateful ruin."}, {"id": "ate-quote2", "translation": "hunted toward ruin."}, {"id": "ate-quote3", "translation": "into the boundless net of ruin."}, {"id": "ate-quote4", "translation": "man-destroying plague, shield-casting ruin."}, {"id": "ate-quote5", "translation": "in the field of ruin he reaps death."}, {"id": "ate-quote6", "translation": "spirit-swelling, spear-mad ruin."}, {"id": "ate-quote7", "translation": "alas, you who are mad in ruin."}, {"id": "ate-quote8", "translation": "for hybris, flowering, produced the ear of ruin."}, {"id": "ate-quote9", "translation": "a great net of slavery, of all-catching ruin."}, {"id": "ate-quote10", "translation": "and wretched Persuasion overpowers, the unendurable child of forethought, of ruin."}, {"id": "ate-quote11", "translation": "double-pointed ruin."}, {"id": "ate-quote12", "translation": "and from the god a priest of ruin was nurtured in the house."}, {"id": "ate-quote13", "translation": "Boldness, of black ruin in the halls."}, {"id": "ate-quote14", "translation": "the storms of ruin live."}, {"id": "ate-quote15", "translation": "first-beginning ruin."}, {"id": "ate-quote16", "translation": "the penalty of secret ruin."}, {"id": "ate-quote17", "translation": "deceitful ruin."}, {"id": "ate-quote18", "translation": "the race is glued to ruin."}, {"id": "ate-quote19", "translation": "grievous ruin."}, {"id": "ate-quote20", "translation": "is not ruin unexhausted?"}, {"id": "ate-quote21", "translation": "from those who perished before, bringing the other ruin upon them."}, {"id": "ate-quote22", "translation": "discordant, bloody stroke of ruin."}, {"id": "ate-quote23", "translation": "accomplishing blameworthy ruin."}, {"id": "ate-quote24", "translation": "and ruin stands apart from friends."}, {"id": "ate-quote25", "translation": "inflicting bloody ruin."}, {"id": "ate-quote26", "translation": "the transferred might of ruin."}, {"id": "ate-quote27", "translation": "grievous ruin."}, {"id": "ate-quote28", "translation": "and having recognized ruin through deceit."}, {"id": "ate-quote29", "translation": "and I lament the ruin of my wife, heaven-conquering."}, {"id": "ate-quote30", "translation": "filling with ruin."}, {"id": "ate-quote31", "translation": "and the abysmal sea of ruin."}, {"id": "ate-quote32", "translation": "the black-yoked ruin."}, {"id": "ate-quote33", "translation": "and ruin in the mind."}, {"id": "ate-quote34", "translation": "the curse of the statue, ruin."}, {"id": "ate-quote35", "translation": "with war-destroying ruins."}, {"id": "ate-quote36", "translation": "with sea-borne ruins of friends."}, {"id": "ate-quote37", "translation": "to fence off these ruins for friends."}, {"id": "ate-quote38", "translation": "stormy ruins."}, {"id": "ate-quote39", "translation": "all-daring loves, companions of mortals' ruins."}]}