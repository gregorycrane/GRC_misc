{"units": [{"id": "agnamptos-quote1", "translation": "an unbending mind."}, {"id": "agnamptos-word1", "translation": "unbending"}, {"id": "agnamptos-word2", "translation": "unbent"}, {"id": "agnamptos-word3", "translation": "γρ [for] άκαμπον [unbending]"}, {"id": "agnamptos-word4", "translation": "unbending"}, {"id": "agnamptos-word5", "translation": "will bend"}, {"id": "agnamptos-word6", "translation": "to a corrector"}, {"id": "agnamptos-word7", "translation": "will bend"}, {"id": "agnamptos-word8", "translation": "being carded"}, {"id": "agnamptos-word9", "translation": "corrector"}, {"id": "agnamptos-word10", "translation": "being bent"}, {"id": "agnamptos-word11", "translation": "was being carded"}, {"id": "agnamptos-word12", "translation": "was being carded"}, {"id": "agnamptos-word13", "translation": "was being bent"}, {"id": "agnamptos-word14", "translation": "to card"}, {"id": "agnamptos-word15", "translation": "to bend"}, {"id": "agnamptos-word16", "translation": "to card"}, {"id": "agnamptos-word17", "translation": "to bend"}, {"id": "agnamptos-word18", "translation": "to card"}, {"id": "agnamptos-word19", "translation": "unbending"}, {"id": "agnamptos-word20", "translation": "uncarded"}, {"id": "agnamptos-word21", "translation": "uncarded"}, {"id": "agnamptos-word22", "translation": "see ἄκναπτος [uncarded]"}, {"id": "agnamptos-word23", "translation": "unbroken"}, {"id": "agnamptos-word24", "translation": "ἀκάαπτον (ἄκναπτον [uncarded])"}, {"id": "agnamptos-word25", "translation": "unbroken. uncarded garment, and unpruned (unbroken)"}, {"id": "agnamptos-word26", "translation": "uncarded garment"}, {"id": "agnamptos-word27", "translation": "unbroken"}, {"id": "agnamptos-word28", "translation": "unbending"}, {"id": "agnamptos-word29", "translation": "unbending"}, {"id": "agnamptos-word30", "translation": "unbending): unbroken, unbending"}, {"id": "agnamptos-word31", "translation": "but in your breast is a mind not to be charmed"}, {"id": "agnamptos-word32", "translation": "not to be drawn, not to be harmed, unbroken"}, {"id": "agnamptos-word33", "translation": "thorn: unbending"}, {"id": "agnamptos-word34", "translation": "uncarded: unbent"}, {"id": "agnamptos-word35", "translation": "if unpruned: unbending. the unbending mind of the gods"}, {"id": "agnamptos-word36", "translation": "has an unbending mind"}, {"id": "agnamptos-word37", "translation": "unswerving mind"}, {"id": "agnamptos-word38", "translation": "unswerving: hard. Sophocles in the Mysians, unswerving: unturned, steadfast"}, {"id": "agnamptos-word39", "translation": "unswerving: unturned and steadfast"}, {"id": "agnamptos-word40", "translation": "unswerving if"}, {"id": "agnamptos-word41", "translation": "unturned"}, {"id": "agnamptos-word42", "translation": "unchangeable"}, {"id": "agnamptos-word43", "translation": "unbending"}, {"id": "agnamptos-word44", "translation": "unbending"}, {"id": "agnamptos-word45", "translation": "unbending"}, {"id": "agneuō-orth1", "translation": "to be pure"}, {"id": "agneuō-def1", "translation": "I am pure"}, {"id": "agneuō-quote1", "translation": "How could a bird be pure after eating a bird?"}, {"id": "hagnisma-orth1", "translation": "purification offering, person who has incurred pollution"}, {"id": "hagnisma-def1", "translation": "purification offering, person who has incurred pollution"}, {"id": "hagnisma-quote1", "translation": "a mother's pollution, the lord of murder."}, {"id": "agNoeō-orth1", "translation": "to be ignorant"}, {"id": "agNoeō-def1", "translation": "I am ignorant"}, {"id": "agNoeō-quote1", "translation": "do not be ignorant of the calamity."}, {"id": "agnoia-orth1", "translation": "ignorance"}, {"id": "agnoia-def1", "translation": "ignorance"}, {"id": "agnoia-quote1", "translation": "unclear; but he, taking them at once in ignorance."}, {"id": "agnoia-quote2", "translation": "through ignorance."}, {"id": "hagnorytos-orth1", "translation": "flowing purely"}, {"id": "hagnorytos-def1", "translation": "flowing purely"}, {"id": "hagnorytos-note1", "translation": "For ἁγνόρρυτος [flowing purely] in a dactylic verse"}, {"id": "hagnorytos-quote1", "translation": "springs of purely flowing rivers."}, {"id": "hagnorytos-word1", "translation": "flowing purely"}, {"id": "hagnos-orth1", "translation": "pure, sacred"}, {"id": "hagnos-def1", "translation": "pure, sacred"}, {"id": "hagnos-note1", "translation": "Thus Wordsworth for αΐδνης διάλγος."}, {"id": "hagnos-note2", "translation": "of the temples of the gods"}, {"id": "hagnos-note3", "translation": "of Iphigenia"}, {"id": "hagnos-quote1", "translation": "the pure air"}, {"id": "hagnos-quote2", "translation": "the pure sky."}, {"id": "hagnos-quote3", "translation": "the seat of pure Asia."}, {"id": "hagnos-quote4", "translation": "the stream of pure Strymon."}, {"id": "hagnos-quote5", "translation": "the land through which pure Strymon flows."}, {"id": "hagnos-quote6", "translation": "Egypt filled with pure water (he means the water of the Nile)."}, {"id": "hagnos-quote7", "translation": "the pure end accomplished by war."}, {"id": "hagnos-quote8", "translation": "in pure houses."}, {"id": "hagnos-quote9", "translation": "having sown the pure field of his mother."}, {"id": "hagnos-quote10", "translation": "and from a pure cow, white milk good to drink."}, {"id": "hagnos-quote11", "translation": "of pure anointing oil."}, {"id": "hagnos-quote12", "translation": "pure chthonic deities."}, {"id": "hagnos-quote13", "translation": "pure Artemis."}, {"id": "hagnos-quote14", "translation": "pure Artemis."}, {"id": "hagnos-quote15", "translation": "pure daughter of Zeus."}, {"id": "hagnos-quote16", "translation": "pure Apollo."}, {"id": "hagnos-quote17", "translation": "suppliants of pure Zeus."}, {"id": "hagnos-quote18", "translation": "with pure voice."}, {"id": "hagnos-quote19", "translation": "from a pure mouth."}, {"id": "hagnos-quote20", "translation": "from pure mouths."}, {"id": "hagnos-quote21", "translation": "oracles no longer pure."}, {"id": "hagnos-quote22", "translation": "the pure majesty of Persuasion."}, {"id": "hagnos-quote23", "translation": "you did not respect the pure majesty of my thighs."}, {"id": "hagnos-quote24", "translation": "from pure seats."}, {"id": "hagnos-quote25", "translation": "he would be pure."}, {"id": "hagnos-quote26", "translation": "from a pure man."}, {"id": "hagnos-quote27", "translation": "to pure maidens."}, {"id": "hagnos-quote28", "translation": "sit in a pure place."}, {"id": "hagnos-word1", "translation": "pain of Hades"}, {"id": "agnōs-orth1", "translation": "unknown"}, {"id": "agnōs-def1", "translation": "unknown"}, {"id": "agnōs-def2", "translation": "unrecognized, not understood"}, {"id": "agnōs-quote1", "translation": "a man unknown spoke to an unknown man."}, {"id": "agnōs-quote2", "translation": "an unknown crowd."}, {"id": "agnōs-quote3", "translation": "possessing an unknown barbarian tongue."}, {"id": "agous-orth1", "translation": "unlamented"}, {"id": "agous-def1", "translation": "whom no one follows with lamentations"}, {"id": "agous-quote1", "translation": "and that wretched man goes unlamented."}, {"id": "agora-orth1", "translation": "marketplace"}, {"id": "agora-def1", "translation": "marketplace"}, {"id": "agora-quote1", "translation": "to the gods who protect the city, and to those who watch over the plains and the marketplace."}, {"id": "agoraios-orth1", "translation": "of the marketplace"}, {"id": "agoraios-def1", "translation": "guardian of the marketplace"}, {"id": "agoraios-quote1", "translation": "Zeus of the marketplace."}, {"id": "agoraios-quote2", "translation": "of the gods, both heavenly and of the marketplace."}, {"id": "agos-orth1", "translation": "pollution, curse"}, {"id": "agos-def1", "translation": "pollution, curse"}, {"id": "agos-quote1", "translation": "even in death he will incur pollution from his ancestral gods."}, {"id": "agos-quote2", "translation": "a curse (thus Victorius for algos) to be prayed away."}, {"id": "agos-quote3", "translation": "lifting a grim curse,"}, {"id": "agos-quote4", "translation": "guard against pollution (M has algos)."}, {"id": "agos-quote5", "translation": "may there be a curse upon my enemies."}, {"id": "agos_2-orth1", "translation": "grief"}, {"id": "agos_2-note1", "translation": "for achys Auratus Ag. 1251 1579. Ch. 635."}, {"id": "agos_2-word1", "translation": "grief"}, {"id": "agos_3-orth1", "translation": "leader"}, {"id": "agos_3-def1", "translation": "leader"}, {"id": "agos_3-note1", "translation": "A word frequent in Homer, of which there are no examples among the tragedians except two in Aeschylus and one in Rhesus 29 Lykion agon andron [leader of Lycian men]."}, {"id": "agos_3-quote1", "translation": "leader of the city."}, {"id": "agos_3-quote2", "translation": "leaders of the city."}, {"id": "agos_3-word1", "translation": "leader of Lycian men"}, {"id": "agra-orth1", "translation": "prey, catch"}, {"id": "agra-def1", "translation": "prey, catch"}, {"id": "agra-quote1", "translation": "the spear's prey."}, {"id": "agra-quote2", "translation": "overcome by sleep, I lost my prey."}, {"id": "agremōn-orth1", "translation": "hunter"}]}