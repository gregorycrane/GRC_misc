{"units": [{"id": "aion-quote19", "translation": "a maiden's lifetime"}, {"id": "aion-word1", "translation": "of a lifetime, to a lifetime, a lifetime"}, {"id": "aion-word2", "translation": "O lifetime"}, {"id": "aion-word3", "translation": "a lifetime"}, {"id": "aion-word4", "translation": "Zeus, ruler of unceasing lifetime"}, {"id": "aion-word5", "translation": "written: fortunes of a divinity"}, {"id": "aion-word6", "translation": "fortunes of divinities"}, {"id": "aion-word7", "translation": "a lifetime of three libations"}, {"id": "aion-word8", "translation": "a paean"}, {"id": "aion-word9", "translation": "O lifetime"}, {"id": "aion-word10", "translation": "a lifetime"}, {"id": "aion-word11", "translation": "O Poseidon"}, {"id": "aion-word12", "translation": "Poseidon"}, {"id": "aion-word13", "translation": "αἰώ [O lifetime] for αἰῶνα [a lifetime] by apocope, Aeschylus"}, {"id": "aion-word14", "translation": "and"}, {"id": "aion-word15", "translation": "and a maiden's lifetime"}, {"id": "akairos-orth1", "translation": "untimely, importunate"}, {"id": "akairos-def1", "translation": "untimely, importunate"}, {"id": "akairos-quote1", "translation": "Hermes does not seem to speak untimely words."}, {"id": "akairos_adv-orth1", "translation": "untimely, importunately"}, {"id": "akairos_adv-def1", "translation": "untimely, importunately"}, {"id": "akairos_adv-quote1", "translation": "both the one who justly and the one who untimely keeps the city of citizens"}, {"id": "akairos_adv-quote2", "translation": "and an untimely, hateful marriage"}, {"id": "akakos-orth1", "translation": "harmless, guileless"}, {"id": "akakos-def1", "translation": "from whom no evil proceeds"}, {"id": "akakos-note1", "translation": "ἀκάκης [harmless] said for the sake of the meter"}, {"id": "akakos-note2", "translation": "where the remaining Doric forms in this song suggest that ἀκάκας [harmless] should be written, which is in two copies, with η [eta] written above in one of them."}, {"id": "akakos-quote1", "translation": "come, father, harmless one."}, {"id": "akakos-quote2", "translation": "all-powerful, harmless, unconquerable king,"}, {"id": "akakos-word1", "translation": "harmless"}, {"id": "akakos-word2", "translation": "harmless"}, {"id": "akakos-word3", "translation": "eta"}, {"id": "akamatoss-orth1", "translation": "untiring"}, {"id": "akamatoss-def1", "translation": "(with the first syllable lengthened) untiring"}, {"id": "akamatoss-quote1", "translation": "and the untiring strength of men was present"}, {"id": "akamptos-orth1", "translation": "unbending, immovable"}, {"id": "akamptos-def1", "translation": "unbending, immovable"}, {"id": "akamptos-quote1", "translation": "with unbending might"}, {"id": "akantha-orth1", "translation": "thorn, spine"}, {"id": "akantha-def1", "translation": "thorn, spine"}, {"id": "akantha-quote1", "translation": "the spine of a sea creature"}, {"id": "akantha-quote2", "translation": "thorn: the backbone of the sea monster"}, {"id": "akantha-quote3", "translation": "the first spine of the sea monster"}, {"id": "akarpia-orth1", "translation": "barrenness, crop failure"}, {"id": "akarpia-def1", "translation": "barrenness, crop failure"}, {"id": "akarpia-quote1", "translation": "and do not cause barrenness"}, {"id": "akarpos-orth1", "translation": "fruitless, causing barrenness"}, {"id": "akarpos-def1", "translation": "causing barrenness"}, {"id": "akarpos-quote1", "translation": "and let no fruitless, grievous disease creep upon us"}, {"id": "akarpotos-orth1", "translation": "fruitless, unproductive"}, {"id": "akarpotos-def1", "translation": "one from whom fruit is not obtained"}, {"id": "akarpotos-note1", "translation": "Improperly"}, {"id": "akarpotos-note2", "translation": "to cause oracles to have no fulfillment"}, {"id": "akarpotos-quote1", "translation": "to make oracles fruitless,"}, {"id": "akaskaios-orth1", "translation": "gentle, calm"}, {"id": "akaskaios-def1", "translation": "gentle, calm"}, {"id": "akaskaios-note1", "translation": "i.e. ἥσυχον, μαλθακόν [quiet, soft], as the grammarians explain the adverb ἄκασκα [gently] by ἡσύχως εί μαλακῶς [quietly or softly]."}, {"id": "akaskaios-quote1", "translation": "a gentle ornament of wealth,"}, {"id": "akaskaios-word1", "translation": "quiet, soft"}, {"id": "akaskaios-word2", "translation": "gently"}, {"id": "akaskaios-word3", "translation": "quietly or softly"}, {"id": "akata-orth1", "translation": "corrupt word"}, {"id": "akata-note1", "translation": "a corrupt word Ag. 985 ψαμμίας ἀκάτα [sandy shore?], where Triclinius rashly wrote ἀκάτας [shores?] and, to make the meters equal, changed ἐξ [from] to ἀπ' [from] in the antistrophe at 999. The meter requires a trochaic dipody, such as Ahrens' conjecture ψαμμὶς ἀκτά [sandy shore] provides."}, {"id": "akata-quote1", "translation": "sandy shore,"}, {"id": "akata-word1", "translation": "shores"}, {"id": "akata-word2", "translation": "from"}, {"id": "akata-word3", "translation": "from"}, {"id": "akata-word4", "translation": "sandy shore"}, {"id": "akeleustos-orth1", "translation": "unbidden, uncommanded"}, {"id": "akeleustos-def1", "translation": "unbidden, uncommanded"}, {"id": "akeleustos-quote1", "translation": "he prepared a feast unbidden."}, {"id": "akeleustos-quote2", "translation": "and she prophesies unbidden, unpaid, a song."}, {"id": "akeraunos-orth1", "translation": "unthunderstruck"}, {"id": "akeraunos-def1", "translation": "not struck by lightning"}, {"id": "akeraunos-quote1", "translation": "Capaneus unthunderstruck."}, {"id": "akeraunos-word1", "translation": "lightning-struck"}, {"id": "akesma-orth1", "translation": "remedy, cure"}, {"id": "akesma-def1", "translation": "remedy, cure"}, {"id": "akesma-quote1", "translation": "mixtures of gentle remedies"}, {"id": "akedeo-orth1", "translation": "to neglect, not care for"}, {"id": "akedeo-def1", "translation": "I do not care for"}, {"id": "akedeo-quote1", "translation": "but you neglected yourself in your misfortune."}, {"id": "akeratos-orth1", "translation": "pure, undefiled"}, {"id": "akeratos-def1", "translation": "pure, undefiled"}, {"id": "akeratos-def2", "translation": "untouched, intact"}, {"id": "akeratos-quote1", "translation": "and a pure drink from a wild mother"}, {"id": "akeratos-quote2", "translation": "an undefiled vessel"}, {"id": "akitharis-orth1", "translation": "without the lyre, joyless"}, {"id": "akitharis-def1", "translation": "lacking the lyre, not rejoicing"}, {"id": "akitharis-quote1", "translation": "the chorusless, lyreless, tear-causing Ares."}, {"id": "akikys-orth1", "translation": "weak, feeble"}, {"id": "akikys-def1", "translation": "(i) weak, feeble"}, {"id": "akikys-quote1", "translation": "feeble weakness"}, {"id": "akichetos-orth1", "translation": "unattainable, inexorable"}, {"id": "akichetos-def1", "translation": "whom we cannot reach, inexorable"}, {"id": "akichetos-quote1", "translation": "for his ways are unattainable and his heart unpersuadable."}, {"id": "aklagges-orth1", "translation": "not barking, silent"}, {"id": "aklagges-def1", "translation": "not barking, silent"}]}