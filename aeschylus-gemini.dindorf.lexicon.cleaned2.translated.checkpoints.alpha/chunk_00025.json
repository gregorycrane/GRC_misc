{"units": [{"id": "aitherios-quote2", "translation": "ethereal dust."}, {"id": "aithēr-orth1", "translation": "ether, upper air"}, {"id": "aithēr-def1", "translation": "ether, upper air"}, {"id": "aithēr-note1", "translation": "of the stars"}, {"id": "aithēr-quote1", "translation": "O divine ether."}, {"id": "aithēr-quote2", "translation": "O ether, common light of all, rolling around."}, {"id": "aithēr-quote3", "translation": "And the ether whistles softly with light beats of wings."}, {"id": "aithēr-quote4", "translation": "Having left her seat and the pure ether."}, {"id": "aithēr-quote5", "translation": "The smooth path of the ether."}, {"id": "aithēr-quote6", "translation": "Let the ether be provoked by thunder."}, {"id": "aithēr-quote7", "translation": "The ether is confounded with the sea."}, {"id": "aithēr-quote8", "translation": "The spear-shaken ether rages."}, {"id": "aithēr-quote9", "translation": "With auspicious hands the ether bristled."}, {"id": "aithēr-quote10", "translation": "May darkness seize the precinct of the ether."}, {"id": "aithēr-quote11", "translation": "Bright lords conspicuous in the ether."}, {"id": "aithēr-quote12", "translation": "The opinions of men, even under the ether, are august."}, {"id": "aithēr-quote13", "translation": "From where would the throne of the ether come to me?"}, {"id": "aithēr-quote14", "translation": "On the Idaean hill is the altar of ancestral Zeus in the ether."}, {"id": "aithēr-quote15", "translation": "Zeus is ether."}, {"id": "aithiopis-orth1", "translation": "Aethiopian (woman)"}, {"id": "aithiopis-def1", "translation": "Aethiopian (woman)"}, {"id": "aithiopis-quote1", "translation": "Of the Aethiopian land."}, {"id": "aithiops-orth1", "translation": "Aethiopian"}, {"id": "aithiops-def1", "translation": "Aethiopian"}, {"id": "aithiops-def2", "translation": "Aethiopian, name of a river"}, {"id": "aithiops-quote1", "translation": "Among the Aethiopians who dwell near the city."}, {"id": "aithiops-quote2", "translation": "The all-nourishing lake of the Aethiopians."}, {"id": "aithiops-quote3", "translation": "Will some Aethiopian woman appear?"}, {"id": "aithiops-quote4", "translation": "An Aethiopian voice."}, {"id": "aithiops-quote5", "translation": "Where the river Aethiops is."}, {"id": "aithō-orth1", "translation": "to kindle, burn"}, {"id": "aithō-def1", "translation": "to kindle, burn"}, {"id": "aithō-note1", "translation": "erroneously for καταίθουσα [burning down]."}, {"id": "aithō-quote1", "translation": "As long as Aegisthus kindles fire on my hearth."}, {"id": "aithō-quote2", "translation": "and burning"}, {"id": "aithō-word1", "translation": "burning down"}, {"id": "aithōn-orth1", "translation": "fiery, fierce"}, {"id": "aithōn-def1", "translation": "fiery, fierce"}, {"id": "aithōn-quote1", "translation": "A fiery man is set over him in spirit."}, {"id": "aikēs-orth1", "translation": "unseemly, shameful"}, {"id": "aikēs-note1", "translation": "See ἀεικής [unseemly, shameful]."}, {"id": "aikēs-word1", "translation": "unseemly, shameful"}, {"id": "aikia-orth1", "translation": "outrage, maltreatment"}, {"id": "aikia-def1", "translation": "outrage, maltreatment"}, {"id": "aikia-note1", "translation": "(middle syllable lengthened)"}, {"id": "aikia-quote1", "translation": "Worn down by such outrages."}, {"id": "aikia-quote2", "translation": "And to pay penalties for this outrage."}, {"id": "aikia-quote3", "translation": "With fasting outrages of leaping."}, {"id": "aikizomai-orth1", "translation": "to maltreat, outrage"}, {"id": "aikizomai-def1", "translation": "to maltreat, outrage"}, {"id": "aikizomai-def2", "translation": "Passive"}, {"id": "aikizomai-quote1", "translation": "On what charge has Zeus seized you and thus maltreats you?"}, {"id": "aikizomai-quote2", "translation": "The charge on which he maltreats me."}, {"id": "aikizomai-quote3", "translation": "On such charges Zeus maltreats you."}, {"id": "aikizomai-quote4", "translation": "Although I am maltreated in strong fetters."}, {"id": "aikisma-orth1", "translation": "outrage, torment"}, {"id": "aikisma-def1", "translation": "outrage, torment"}, {"id": "aikisma-quote1", "translation": "There is no outrage or device."}, {"id": "ailinos-orth1", "translation": "dirge, lament"}, {"id": "ailinos-def1", "translation": "dirge, lament"}, {"id": "ailinos-quote1", "translation": "Sing ailinon, ailinon."}, {"id": "haima-orth1", "translation": "blood"}, {"id": "haima-def1", "translation": "blood"}, {"id": "haima-def2", "translation": "slaughter, murder"}, {"id": "haima-def3", "translation": "said of blood relationship"}, {"id": "haima-note1", "translation": "(where M has from the gloss ὑφ' αἵματος νέου [by fresh blood], which Paleius corrected)."}, {"id": "haima-note2", "translation": "Thus Casaubon for δωμάτων [of the houses] from the annotation of the scholiast. Likewise"}, {"id": "haima-quote1", "translation": "For purifying blood,"}, {"id": "haima-quote2", "translation": "To accomplish the slaughter of unlawful blood."}, {"id": "haima-quote3", "translation": "Do you wish to pluck kindred blood?"}, {"id": "haima-quote4", "translation": "Black-clotted bloody gore."}, {"id": "haima-quote5", "translation": "The earth has drunk blood."}, {"id": "haima-quote6", "translation": "Of maiden blood."}, {"id": "haima-quote7", "translation": "You have caused much-remembered unwashed blood to bloom."}, {"id": "haima-quote8", "translation": "The black blood of a man,"}, {"id": "haima-quote9", "translation": "The house was defiled with blood."}, {"id": "haima-quote10", "translation": "Fat of blood upon the eyes."}, {"id": "haima-quote11", "translation": "He licked his fill of tyrant's blood."}, {"id": "haima-quote12", "translation": "He will pay the blood of former men."}, {"id": "haima-quote13", "translation": "Breathing out a sharp slaughter of blood."}, {"id": "haima-quote14", "translation": "Having drunk — mortal blood."}, {"id": "haima-quote15", "translation": "Of blood fallen to the ground."}, {"id": "haima-quote16", "translation": "But it is the law that bloody drops spilled on the ground demand other blood."}, {"id": "haima-quote17", "translation": "He mixed friendly milk with a clot of blood."}, {"id": "haima-quote18", "translation": "So as to draw a clot of blood in milk."}, {"id": "haima-quote19", "translation": "He will drink unmixed blood."}, {"id": "haima-quote20", "translation": "For someone pouring out everything in exchange for one blood."}, {"id": "haima-quote21", "translation": "Release the blood with fresh judgments."}, {"id": "haima-quote22", "translation": "Fleeing this common blood."}, {"id": "haima-quote23", "translation": "For fresh blood is still on your hands."}, {"id": "haima-quote24", "translation": "They drip hostile blood from their eyes."}, {"id": "haima-quote25", "translation": "Dripping with blood on their hands."}, {"id": "haima-quote26", "translation": "For maternal blood drives him."}, {"id": "haima-quote27", "translation": "We search for blood and dripping."}, {"id": "haima-quote28", "translation": "Maternal blood on the ground."}, {"id": "haima-quote29", "translation": "For the blood sleeps and fades from the hand."}, {"id": "haima-quote30", "translation": "Avengers of blood."}, {"id": "haima-quote31", "translation": "Slaughter of purifying blood."}, {"id": "haima-quote32", "translation": "When the dust has drunk up the blood."}, {"id": "haima-quote33", "translation": "Having poured out kindred blood on the ground."}, {"id": "haima-quote34", "translation": "Judging cases of shed blood."}, {"id": "haima-quote35", "translation": "The dust having drunk the black blood of citizens."}, {"id": "haima-quote36", "translation": "Life-giving blood."}]}