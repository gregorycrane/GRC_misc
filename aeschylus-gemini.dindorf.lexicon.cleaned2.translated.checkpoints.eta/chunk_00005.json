{"units": [{"id": "heko-quote45", "translation": "One toil is present, another will come."}, {"id": "heko-quote46", "translation": "They will come hunting a marriage that is no marriage."}, {"id": "heko-quote47", "translation": "I trust that with justice the fire-bearing thunderbolt will come upon him."}, {"id": "heko-quote48", "translation": "There is some hope that he will come back to the house."}, {"id": "heko-quote49", "translation": "You will come to the violent river."}, {"id": "heko-quote50", "translation": "You will come to the man-hating army of the Amazons."}, {"id": "heko-quote51", "translation": "You will come to the Cimmerian isthmus."}, {"id": "heko-quote52", "translation": "You will come to the Asian mainland."}, {"id": "heko-quote53", "translation": "You will come to the black race."}, {"id": "heko-quote54", "translation": "Then you will come to a most just people."}, {"id": "heko-word1", "translation": "to go"}, {"id": "heko-word2", "translation": "to come"}, {"id": "heko-word3", "translation": "to have come"}, {"id": "heko-word4", "translation": "I have come"}, {"id": "heko-word5", "translation": "they came"}, {"id": "heko-word6", "translation": "I will have come"}, {"id": "heko-word7", "translation": "they came"}, {"id": "heko-word8", "translation": "of the Palici"}, {"id": "heko-word9", "translation": "they will have come"}, {"id": "heko-word10", "translation": "you came"}, {"id": "heko-word11", "translation": "I have come"}, {"id": "heko-word12", "translation": "I will have come"}, {"id": "heko-word13", "translation": "I will lead"}, {"id": "heko-word14", "translation": "I will arrange"}, {"id": "heko-word15", "translation": "I will have come"}, {"id": "heko-word16", "translation": "he has come"}, {"id": "heko-word17", "translation": "he will come"}, {"id": "heko-word18", "translation": "he will have come"}, {"id": "heko-word19", "translation": "Abius"}, {"id": "heko-word20", "translation": "he will come"}, {"id": "elektra-orth1", "translation": "Electra"}, {"id": "elektra-def1", "translation": "Electra, daughter of Agamemnon, who comes on stage in the Choephori."}, {"id": "elektra-quote1", "translation": "I think Electra is coming."}, {"id": "elektra-quote2", "translation": "I mean Electra."}, {"id": "elektrai-orth1", "translation": "Electrae"}, {"id": "elektrai-def1", "translation": "Electrae, gate of Thebes."}, {"id": "elektrai-quote1", "translation": "Capaneus has drawn the Electran gates."}, {"id": "heliades-orth1", "translation": "Heliades"}, {"id": "heliades-def1", "translation": "was the title of a play of Aeschylus (fr. 65-68)."}, {"id": "helibatos-orth1", "translation": "steep"}, {"id": "helibatos-def1", "translation": "steep."}, {"id": "helibatos-note1", "translation": "More probably Doric ἀλιβάτοις [steep], as in Eur. Suppl. 81."}, {"id": "helibatos-quote1", "translation": "on steep rocks"}, {"id": "helibatos-word1", "translation": "steep"}, {"id": "elithios-orth1", "translation": "vain, useless"}, {"id": "elithios-def1", "translation": "vain, useless."}, {"id": "elithios-quote1", "translation": "may no vain missile fall from above the stars"}, {"id": "elithioo-orth1", "translation": "to make foolish"}, {"id": "elithioo-def1", "translation": "to make foolish."}, {"id": "elithioo-quote1", "translation": "lest the harsh roar of thunder make your minds foolish"}, {"id": "helikia-orth1", "translation": "age"}, {"id": "helikia-def1", "translation": "age."}, {"id": "helikia-note1", "translation": "of old age"}, {"id": "helikia-quote1", "translation": "seeing this age of the citizens"}, {"id": "hêlix-orth1", "translation": "of the same age"}, {"id": "hêlix-def1", "translation": "of the same age."}, {"id": "hêlix-note1", "translation": "where see the scholia."}, {"id": "hêlix-quote1", "translation": "and companions of my youth"}, {"id": "hêlix-quote2", "translation": "the bloody torch of the child, of the same age"}, {"id": "helioktypos-orth1", "translation": "struck by the sun"}, {"id": "helioktypos-def1", "translation": "struck by the sun."}, {"id": "helioktypos-note1", "translation": "Thus Wellauer for ἢ διόκτυπον [or struck by Zeus]."}, {"id": "helioktypos-quote1", "translation": "the race blackened, struck by the sun"}, {"id": "helioktypos-word1", "translation": "or struck by Zeus"}, {"id": "helios-orth1", "translation": "sun"}, {"id": "helios-def1", "translation": "(ἅλιος [sun] in Doric) sun."}, {"id": "helios-def2", "translation": "Sun god"}, {"id": "helios-note1", "translation": "ἡλίου [of the sun] Jacobs."}, {"id": "helios-quote1", "translation": "roasted by the bright flame of the sun"}, {"id": "helios-quote2", "translation": "and the morning frost the sun scatters again"}, {"id": "helios-quote3", "translation": "I call upon the all-seeing circle of the sun"}, {"id": "helios-quote4", "translation": "toward the risings of the sun"}, {"id": "helios-quote5", "translation": "which the sun does not look upon with its rays"}, {"id": "helios-quote6", "translation": "they dwell by the springs of the sun"}, {"id": "helios-quote7", "translation": "with the midday heats of the sun"}, {"id": "helios-quote8", "translation": "when the blazing sun with its rays ceases to scorch the earth"}, {"id": "helios-quote9", "translation": "when the light of the sun had perished"}, {"id": "helios-quote10", "translation": "for the bright circle of the sun blazing with rays"}, {"id": "helios-quote11", "translation": "while you looked upon the rays of the sun"}, {"id": "helios-quote12", "translation": "like some sun"}, {"id": "helios-quote13", "translation": "and hail, light of the sun"}, {"id": "helios-quote14", "translation": "so that it is fitting to boast in this light of the sun"}, {"id": "helios-quote15", "translation": "bright light of the sun"}, {"id": "helios-quote16", "translation": "if any ray of the sun observes him"}, {"id": "helios-quote17", "translation": "and I pray to the sun for the last light"}, {"id": "helios-quote18", "translation": "bright gleam of the sun"}, {"id": "helios-quote19", "translation": "we call upon the saving rays of the sun"}, {"id": "helios-quote20", "translation": "toward the setting of the sun"}, {"id": "helios-quote21", "translation": "bright light of the sun"}, {"id": "helios-quote22", "translation": "which no drop of the sun looks upon"}, {"id": "helios-quote23", "translation": "and the fiery sun shining upon the earth melts the rocky snow"}, {"id": "helios-quote24", "translation": "toward the settings of lord Helios"}, {"id": "helios-quote25", "translation": "except the sun that nourishes the nature of the earth"}, {"id": "helios-quote26", "translation": "so that the father may see, not my father, but Helios who oversees all these things"}, {"id": "helios-quote27", "translation": "the all-seeing Helios"}, {"id": "helios-word1", "translation": "sun"}, {"id": "helios-word2", "translation": "of the sun"}, {"id": "heliostibes-orth1", "translation": "trodden by the sun"}, {"id": "heliostibes-def1", "translation": "trodden by the sun"}, {"id": "heliostibes-quote1", "translation": "toward the fiery risings trodden by the sun"}, {"id": "emai-orth1", "translation": "to sit"}, {"id": "emai-def1", "translation": "to sit"}, {"id": "emai-def2", "translation": "with accusative"}, {"id": "emai-note1", "translation": "μνῆμον [mindful] Hermann."}, {"id": "emai-note2", "translation": "perhaps should be written ἡστ᾽ [he was sitting] for ἔσχ᾽ [he had]."}, {"id": "emai-note3", "translation": "ἡται [he sits] for ἄηται [he blows] restored by Porson."}, {"id": "emai-quote1", "translation": "and on the topmost peaks sits Hephaestus forging with his hammer"}, {"id": "emai-quote2", "translation": "father Zeus stands upright on the shield"}, {"id": "emai-quote3", "translation": "to sit in the house, a desolate, terrible evil"}, {"id": "emai-quote4", "translation": "but the toil of a man nourishes those sitting within"}, {"id": "emai-quote5", "translation": "then sitting on thrones"}, {"id": "emai-quote6", "translation": "sitting on thrones"}, {"id": "emai-quote7", "translation": "guarding this statue, sitting"}, {"id": "emai-quote8", "translation": "sitting on shining-throned hearths"}, {"id": "emai-quote9", "translation": "sitting near Zeus"}, {"id": "emai-quote10", "translation": "a lofty thought sitting"}, {"id": "emai-quote11", "translation": "of no one sitting above"}, {"id": "emai-quote12", "translation": "someone sitting in the house"}, {"id": "emai-quote13", "translation": "violently sitting on the holy deck"}, {"id": "emai-word1", "translation": "mindful"}, {"id": "emai-word2", "translation": "he was sitting"}]}