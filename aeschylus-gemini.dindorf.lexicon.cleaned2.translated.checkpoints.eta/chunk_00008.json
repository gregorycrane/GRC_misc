{"units": [{"id": "etor-quote1", "translation": "the heart within my limbs cries out"}, {"id": "ephaistos-orth1", "translation": "Hephaestus"}, {"id": "ephaistos-def1", "translation": "Vulcan"}, {"id": "ephaistotykes-orth1", "translation": "wrought by Hephaestus"}, {"id": "ephaistotykes-def1", "translation": "wrought by Vulcan"}, {"id": "ephaistotykes-note1", "translation": "in Athenaeus p.469f"}, {"id": "ephaistotykes-note2", "translation": "Thus Hermann corrected what is in the manuscript ήφαιστοτευχές [wrought by Hephaestus], changed by Schweighaeuser to Ἡφαιστοτυχές [wrought by Hephaestus]."}, {"id": "ephaistotykes-quote1", "translation": "a cup wrought by Hephaestus"}, {"id": "ephaistotykes-word1", "translation": "wrought by Hephaestus"}, {"id": "ephaistotykes-word2", "translation": "wrought by Hephaestus"}, {"id": "echetes-orth1", "translation": "sounding"}, {"id": "echetes-def1", "translation": "(ἀχέτας [sounding] in Doric) emitting sound"}, {"id": "echetes-quote1", "translation": "and beneath, the wax-fastened reed, sounding, resounds"}, {"id": "echetes-word1", "translation": "sounding"}, {"id": "echeo-orth1", "translation": "to sound"}, {"id": "echeo-def1", "translation": "(ἀχέω [to sound] in Doric). See ἰαχέω [to cry aloud]."}, {"id": "echeo-word1", "translation": "to sound"}, {"id": "echeo-word2", "translation": "to cry aloud"}, {"id": "eche-orth1", "translation": "sound"}, {"id": "eche-def1", "translation": "(ἀχά [sound] in Doric) sound"}, {"id": "eche-note1", "translation": "thus Elmsley for ἀχάεσσα τοὺς [sounding ...]"}, {"id": "eche-note2", "translation": "i.e. sonorously"}, {"id": "eche-quote1", "translation": "the mournful cry sends a loud sound to the ears of the house"}, {"id": "eche-quote2", "translation": "with a shout the clamor of the Greeks from the ships raised a paean"}, {"id": "eche-word1", "translation": "sound"}, {"id": "eche-word2", "translation": "sounding ..."}, {"id": "echo_sound-orth1", "translation": "echo"}, {"id": "echo_sound-def1", "translation": "(ἀχώ [echo] in Doric) echo"}, {"id": "echo_sound-quote1", "translation": "what echo, what scent flew to me, unseen?"}, {"id": "echo_sound-quote2", "translation": "for the echo of the bronze clash pierced the depths of the caves"}, {"id": "echo_sound-quote3", "translation": "and the deep echo of thunder bellows"}, {"id": "echo_sound-quote4", "translation": "the echo of the island rock cried out in response"}, {"id": "echo_sound-word1", "translation": "echo"}]}