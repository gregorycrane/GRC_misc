{"units": [{"id": "domatoo-note1", "translation": "For me too a house has been built."}, {"id": "domatoo-note2", "translation": "This word too is peculiar to Aeschylus."}, {"id": "domatoo-quote1", "translation": "And I too have been housed with no small hand,"}, {"id": "dorea-orth1", "translation": "gift"}, {"id": "dorea-def1", "translation": "gift"}, {"id": "dorea-quote1", "translation": "I boast that Zeus will give me this gift."}, {"id": "dorea-quote2", "translation": "Would you not provide me this gift?"}, {"id": "doreomai-orth1", "translation": "to give, present"}, {"id": "doreomai-def1", "translation": "to give, present"}, {"id": "doreomai-quote1", "translation": "You have given this great benefit to mortals."}, {"id": "doreomai-quote2", "translation": "I will present you with one of two words."}, {"id": "dorema-orth1", "translation": "gift"}, {"id": "dorema-def1", "translation": "gift"}, {"id": "dorema-quote1", "translation": "But I do not begrudge you this gift."}, {"id": "dorema-quote2", "translation": "I will come bringing gifts to the earth and to the dead."}, {"id": "dorema-quote3", "translation": "a gift of the army"}, {"id": "dorema-quote4", "translation": "a choice gift for the children of Theseus"}, {"id": "dorikos-orth1", "translation": "Dorian, Greek"}, {"id": "dorikos-def1", "translation": "Dorian, Greek"}, {"id": "dorikos-quote1", "translation": "One adorned in Persian robes, the other in Dorian."}, {"id": "doris-orth1", "translation": "Dorian, Greek"}, {"id": "doris-def1", "translation": "Dorian, Greek"}, {"id": "doris-quote1", "translation": "by the Dorian spear"}, {"id": "doron-orth1", "translation": "gift"}, {"id": "doron-def1", "translation": "gift"}, {"id": "doron-quote1", "translation": "It is a gift of god for mortals to prosper."}, {"id": "doron-quote2", "translation": "The altars blaze with gifts."}, {"id": "doron-quote3", "translation": "Not to think badly is the greatest gift of god."}, {"id": "doron-quote4", "translation": "Was this then a secret gift from Orestes?"}, {"id": "doron-quote5", "translation": "The gifts are less than the error."}, {"id": "doron-quote6", "translation": "having trusted in the gifts of Minos"}, {"id": "doron-quote7", "translation": "Death does not desire gifts."}, {"id": "doron-quote8", "translation": "Where are my many gifts and first-fruits?"}, {"id": "dmonyos-orth1", "translation": "of the same name"}, {"id": "dmonyos-def1", "translation": "of the same name"}, {"id": "dmonyos-note1", "translation": "The passage is corrupt."}, {"id": "dmonyos-quote1", "translation": "grievous woes of the same name"}]}