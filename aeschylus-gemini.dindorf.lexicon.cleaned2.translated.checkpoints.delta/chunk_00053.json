{"units": [{"id": "dysphronis-quote5", "translation": "I seek a remedy for a hostile marriage."}, {"id": "dysphronis-quote6", "translation": "more hateful than hostile serpents."}, {"id": "dysphronis-quote7", "translation": "Alas, alas, you hostile ones."}, {"id": "dyscharistos-orth1", "translation": "ungrateful"}, {"id": "dyscharistos-def1", "translation": "ungrateful"}, {"id": "dyscharistos-quote1", "translation": "O ungrateful one,"}, {"id": "dyscheimeros-orth1", "translation": "stormy, tempestuous"}, {"id": "dyscheimeros-def1", "translation": "exposed to storms, tossed about"}, {"id": "dyscheimeros-def2", "translation": "tossing like a storm"}, {"id": "dyscheimeros-quote1", "translation": "in a stormy ravine."}, {"id": "dyscheimeros-quote2", "translation": "a stormy sea of ruinous misery indeed."}, {"id": "dyscheimeros-quote3", "translation": "stormy calamities."}, {"id": "dyscheimeros-quote4", "translation": "having gathered together in a stormy blast."}, {"id": "dyscheres-orth1", "translation": "grievous, horrible"}, {"id": "dyscheres-def1", "translation": "grievous, horrible"}, {"id": "dyscheres-quote1", "translation": "a grievous sight."}, {"id": "dyscheres-quote2", "translation": "seeing a horrible creature, half-human."}, {"id": "dyschimos-orth1", "translation": "evil, destructive"}, {"id": "dyschimos-def1", "translation": "evil, destructive"}, {"id": "dyschimos-quote1", "translation": "an evil serpent."}, {"id": "dyschimos-quote2", "translation": "unprotected drops of a destructive flood."}, {"id": "dyschimos-quote3", "translation": "through the plains of Thrace and the destructive paths."}, {"id": "dyschimos-quote4", "translation": "mistress bride, lord of stormy mountains."}, {"id": "dodeka-orth1", "translation": "twelve"}, {"id": "dodeka-def1", "translation": "twelve"}, {"id": "dodeka-quote1", "translation": "a journey of twelve days."}, {"id": "dodonaios-orth1", "translation": "Dodonaean"}, {"id": "dodonaios-def1", "translation": "Dodonaean"}, {"id": "dodonaios-quote1", "translation": "and the Dodonaean mountains."}, {"id": "dodone-orth1", "translation": "Dodona"}, {"id": "dodone-def1", "translation": "Dodona"}, {"id": "dodone-quote1", "translation": "and to Dodona he sent frequent envoys."}, {"id": "dodone-quote2", "translation": "and around steep-ridged Dodona."}, {"id": "doma-orth1", "translation": "house"}, {"id": "doma-def1", "translation": "house"}, {"id": "doma-def2", "translation": "Of the temples of the gods"}, {"id": "doma-note1", "translation": "In the plural number"}, {"id": "doma-note2", "translation": "where the sense requires αἱμάτων [of blood], which Canterus restored from the scholia."}, {"id": "doma-quote1", "translation": "he will adorn his father's house with spoils."}, {"id": "doma-quote2", "translation": "Alas, alas, house, house, and rulers."}, {"id": "doma-quote3", "translation": "to an unexpected house, as Justice may lead."}, {"id": "doma-quote4", "translation": "the house of a perfect man who is visited."}, {"id": "doma-quote5", "translation": "to proclaim a shout to the citizens here at the house."}, {"id": "doma-quote6", "translation": "he will recover his father's house."}, {"id": "doma-quote7", "translation": "throughout the house."}, {"id": "doma-quote8", "translation": "the house is inspired, the roof revels."}, {"id": "doma-quote9", "translation": "the house lacks vinegar."}, {"id": "doma-quote10", "translation": "whenever he wishes to harm a house utterly."}, {"id": "doma-quote11", "translation": "there are many houses, both public."}, {"id": "doma-quote12", "translation": "he drove me out and shut me out of the house."}, {"id": "doma-quote13", "translation": "to exchange the hateful path of the house."}, {"id": "doma-quote14", "translation": "and the visits to my father's house."}, {"id": "doma-quote15", "translation": "destroyers of house walls."}, {"id": "doma-quote16", "translation": "of flourishing houses."}, {"id": "doma-quote17", "translation": "the dog of the house."}, {"id": "doma-quote18", "translation": "guardian of my house."}, {"id": "doma-quote19", "translation": "ruling over this house."}, {"id": "doma-quote20", "translation": "good stewards of the house."}, {"id": "doma-quote21", "translation": "dishonored of the house."}, {"id": "doma-quote22", "translation": "to pay the pollution of older houses."}, {"id": "doma-quote23", "translation": "I call this third libation of the house."}, {"id": "doma-quote24", "translation": "to the masters of the house."}, {"id": "doma-quote25", "translation": "let some woman who brings fulfillment come out of the house."}, {"id": "doma-quote26", "translation": "O curse of this house, hard to wrestle with."}, {"id": "doma-quote27", "translation": "to those who rule the house."}, {"id": "doma-quote28", "translation": "the gates of the house."}, {"id": "doma-quote29", "translation": "from within the house."}, {"id": "doma-quote30", "translation": "wealth as a ransom for the house."}, {"id": "doma-quote31", "translation": "the entrance of the house."}, {"id": "doma-quote32", "translation": "sackers of the house."}, {"id": "doma-quote33", "translation": "purifier of the house."}, {"id": "doma-quote34", "translation": "for I chose the overthrow of the house."}, {"id": "doma-quote35", "translation": "honoring guests, visits to the house."}, {"id": "doma-quote36", "translation": "a man – overseer of the house."}, {"id": "doma-quote37", "translation": "I know the keys of the house."}, {"id": "doma-quote38", "translation": "at the hearth of my house,"}, {"id": "doma-quote39", "translation": "in the house and on the ground."}, {"id": "doma-quote40", "translation": "you have spoken a great light for my house."}, {"id": "doma-quote41", "translation": "in smoky houses."}, {"id": "doma-quote42", "translation": "what Fury is this you bid to raise her cry against the house?"}, {"id": "doma-quote43", "translation": "seated at the house."}, {"id": "doma-quote44", "translation": "you do not speak of a Syrian adornment for the house."}, {"id": "doma-quote45", "translation": "divinity, who falls upon the house."}, {"id": "doma-quote46", "translation": "falling heavily upon the women's quarters."}, {"id": "doma-quote47", "translation": "O dearest darling of your father's house."}, {"id": "doma-quote48", "translation": "well-bearing for the house."}, {"id": "doma-quote49", "translation": "a remedy for these ills, staunched in the house."}, {"id": "doma-quote50", "translation": "nor would you be less dear to the house."}, {"id": "doma-quote51", "translation": "for those who obtain what is fitting in the house."}, {"id": "doma-quote52", "translation": "he will dwell in his father's house."}, {"id": "doma-quote53", "translation": "how did you dare to leave your ancestral home?"}, {"id": "doma-quote54", "translation": "where one must dwell in a house."}, {"id": "doma-quote55", "translation": "I approach the house and your image, goddess."}, {"id": "doma-quote56", "translation": "outside — from this house (of Apollo)."}, {"id": "doma-quote57", "translation": "they say that Io once became the key-holder of Hera's house."}, {"id": "doma-word1", "translation": "of blood"}, {"id": "domatitis-orth1", "translation": "of the house, domestic"}, {"id": "domatitis-def1", "translation": "domestic"}, {"id": "domatitis-note1", "translation": "The feminine is nowhere else read: the masculine Ποσειδῶν δωματίτης [Poseidon of the house] is in Pausan. 3, 14, 7."}, {"id": "domatitis-quote1", "translation": "and when you come, to the domestic hearth."}, {"id": "domatitis-word1", "translation": "Poseidon of the house"}, {"id": "domatoo-orth1", "translation": "to build a house"}, {"id": "domatoo-def1", "translation": "to build a house"}]}