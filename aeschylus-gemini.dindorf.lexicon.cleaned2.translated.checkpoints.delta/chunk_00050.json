{"units": [{"id": "dyselios-word1", "translation": "unhappy, wretched"}, {"id": "dystheatos-orth1", "translation": "ill to look upon, grim of aspect"}, {"id": "dystheatos-def1", "translation": "ill to look upon, grim of aspect"}, {"id": "dystheatos-quote1", "translation": "You see a sight hard to look upon with the eyes."}, {"id": "dystheatos-quote2", "translation": "Sufferings hard to look upon and hard to bear."}, {"id": "dystheatos-quote3", "translation": "Sufferings hard to look upon."}, {"id": "dystheos-orth1", "translation": "impious, godless"}, {"id": "dystheos-def1", "translation": "impious, godless"}, {"id": "dystheos-quote1", "translation": "The impious father of this man, Atreus."}, {"id": "dystheos-quote2", "translation": "An impious woman (or wife)."}, {"id": "dystheos-quote3", "translation": "Having acquired an impious spirit for her children."}, {"id": "dystheos-quote4", "translation": "With impious castings-out."}, {"id": "dysthroos-orth1", "translation": "uttering an ill or unlucky sound"}, {"id": "dysthroos-def1", "translation": "uttering an ill or unlucky sound"}, {"id": "dysthroos-quote1", "translation": "Grievous, ill-sounding utterances."}, {"id": "dysthroos-quote2", "translation": "All-lamenting, ill-sounding voice."}, {"id": "dysthroos-quote3", "translation": "I will send you with ill-sounding laments."}, {"id": "dysiatos-orth1", "translation": "hard to heal"}, {"id": "dysiatos-def1", "translation": "hard to heal"}, {"id": "dysiatos-quote1", "translation": "An evil unbearable to friends, hard to heal."}, {"id": "dysis-orth1", "translation": "setting"}, {"id": "dysis-def1", "translation": "setting"}, {"id": "dysis-quote1", "translation": "I showed the risings of the stars and their settings, hard to discern."}, {"id": "dysis-quote2", "translation": "Around the setting of the Pleiades."}, {"id": "dyskapnos-orth1", "translation": "smoky, full of smoke"}, {"id": "dyskapnos-def1", "translation": "smoky, full of smoke"}, {"id": "dyskapnos-note1", "translation": "which Triclinius explains as πενιχροῖς καὶ εὐτελέσι [poor and humble]."}, {"id": "dyskapnos-quote1", "translation": "But Justice shines in smoky dwellings,"}, {"id": "dyskapnos-quote2", "translation": "poor and humble"}, {"id": "dyskatapaustos-orth1", "translation": "hard to check, not easily ceasing"}, {"id": "dyskatapaustos-def1", "translation": "hard to check, not easily ceasing"}, {"id": "dyskatapaustos-quote1", "translation": "A grief hard to check."}, {"id": "dyskelados-orth1", "translation": "ill-sounding, ill-omened"}, {"id": "dyskelados-def1", "translation": "ill-sounding, ill-omened"}, {"id": "dyskelados-quote1", "translation": "The ill-sounding hymn of the Erinys."}, {"id": "dyskelos-orth1", "translation": "incurable"}, {"id": "dyskelos-def1", "translation": "incurable"}, {"id": "dyskelos-note1", "translation": "The scholiast explains it as δυσθεράπευτον [hard to heal]."}, {"id": "dyskelos-quote1", "translation": "And do not, gods, with excessive wrath against mortals, make the land incurable."}, {"id": "dyskelos-quote2", "translation": "hard to heal"}, {"id": "dysklees-orth1", "translation": "inglorious, infamous"}, {"id": "dysklees-def1", "translation": "inglorious, infamous"}, {"id": "dysklees-quote1", "translation": "An inglorious sight."}, {"id": "dysklees-quote2", "translation": "They died piteously, by a most inglorious fate."}, {"id": "dyskritos-orth1", "translation": "hard to judge or discern"}, {"id": "dyskritos-def1", "translation": "hard to judge or discern"}, {"id": "dyskritos-note1", "translation": "for which δυσκρίτους ὁδούς [hard-to-discern paths] is written in Stobaeus, Ecl. phys. 1, 1."}, {"id": "dyskritos-quote1", "translation": "The settings hard to discern."}, {"id": "dyskritos-quote2", "translation": "hard-to-discern paths"}, {"id": "dyskritos-quote3", "translation": "And I made known to them omens hard to interpret."}, {"id": "dyskritos-quote4", "translation": "The judgment of dreams hard to interpret."}, {"id": "dyskritos_adv-orth1", "translation": "obscurely"}, {"id": "dyskritos_adv-def1", "translation": "obscurely"}, {"id": "dyskritos_adv-quote1", "translation": "Oracles spoken obscurely and hard to interpret."}, {"id": "dyskymantos-orth1", "translation": "arising ill from the surging waves"}, {"id": "dyskymantos-def1", "translation": "arising ill from the surging waves"}, {"id": "dyskymantos-quote1", "translation": "In the night, evils arising ill from the surging waves were stirring."}, {"id": "dyslektos-orth1", "translation": "unpleasant to speak of, unspeakable"}, {"id": "dyslektos-def1", "translation": "unpleasant to speak of, unspeakable"}, {"id": "dyslektos-quote1", "translation": "Having spoken things unpleasant to speak of to his friends."}, {"id": "dyslophos-orth1", "translation": "heavy on the neck, hard to bear"}, {"id": "dyslophos-def1", "translation": "heavy on the neck, hard to bear"}, {"id": "dyslophos-note1", "translation": "Hesychius explains δύσλοφον [hard to bear] as δύσκολον [difficult], οὐχ ἁρμόζον [not fitting]."}, {"id": "dyslophos-quote1", "translation": "hard to bear"}, {"id": "dyslophos-quote2", "translation": "difficult"}, {"id": "dyslophos-quote3", "translation": "not fitting"}, {"id": "dyslophos-quote4", "translation": "And he will have toils even harder to bear than these."}, {"id": "dyslytos-orth1", "translation": "hard to loosen, indissoluble"}, {"id": "dyslytos-def1", "translation": "hard to loosen, indissoluble"}, {"id": "dyslytos-quote1", "translation": "With indissoluble bonds of bronze."}, {"id": "dysmatheo-orth1", "translation": "to recognize with difficulty"}, {"id": "dysmatheo-def1", "translation": "to recognize with difficulty"}, {"id": "dysmatheo-quote1", "translation": "Seeing me, you recognize me with difficulty."}, {"id": "dysmathes-orth1", "translation": "hard to learn, hard to understand"}, {"id": "dysmathes-def1", "translation": "hard to learn, hard to understand"}, {"id": "dysmathes-quote1", "translation": "Hard to understand, nevertheless."}, {"id": "dysmator-orth1", "translation": "from an evil mother"}, {"id": "dysmator-def1", "translation": "from an evil mother"}, {"id": "dysmator-quote1", "translation": "Having met with the wrath of an evil mother."}, {"id": "dysmator-word1", "translation": "evil mother"}, {"id": "dysmachos-orth1", "translation": "hard to fight against, invincible"}, {"id": "dysmachos-def1", "translation": "hard to fight against, invincible"}, {"id": "dysmachos-def2", "translation": "difficult"}, {"id": "dysmachos-quote1", "translation": "A wrestler – a monster most hard to fight against."}, {"id": "dysmachos-quote2", "translation": "It is difficult to judge."}, {"id": "dysmenes-orth1", "translation": "hostile, malevolent"}, {"id": "dysmenes-def1", "translation": "hostile, malevolent"}, {"id": "dysmenes-quote1", "translation": "A tower keeps off the crowd of enemies."}, {"id": "dysmenes-quote2", "translation": "Of a hostile superior."}, {"id": "dysmenes-quote3", "translation": "To the one trampling on enemies."}, {"id": "dysmenes-quote4", "translation": "A hostile alliance, thronged with serpents."}, {"id": "dysme-orth1", "translation": "setting"}, {"id": "dysme-def1", "translation": "setting"}, {"id": "dysme-quote1", "translation": "Toward the settings of the lord Sun's waning."}, {"id": "dysme-quote2", "translation": "At the settings of your father."}, {"id": "dysmetor_xref-orth1", "translation": "See δυσμάτωρ."}, {"id": "dysmetor_xref-note1", "translation": "See δυσμάτωρ [from an evil mother]."}, {"id": "dysmetor_xref-word1", "translation": "from an evil mother"}, {"id": "dysmechaneo-orth1", "translation": "to be at a loss, to be unable"}, {"id": "dysmechaneo-def1", "translation": "to be at a loss, to be unable"}, {"id": "dysmechaneo-quote1", "translation": "I am at a loss how to raise the dead again with words."}, {"id": "dysmoros-orth1", "translation": "unhappily"}, {"id": "dysmoros-def1", "translation": "unhappily"}, {"id": "dysmoros-note1", "translation": "Thus corrected from the apograph, since in M is read δυσφόρως [grievously]. In most apographs δυσμόρους [unhappy]."}, {"id": "dysmoros-quote1", "translation": "Hearing of the dead who died unhappily."}]}