{"units": [{"id": "de-quote120", "translation": "But he, at any rate, has strength."}, {"id": "de-quote121", "translation": "And with new laws Zeus rules without regard to them."}, {"id": "de-quote122", "translation": "And she laments, longing for him."}, {"id": "de-quote123", "translation": "And before enemies."}, {"id": "de-quote124", "translation": "What you ask, then."}, {"id": "de-quote125", "translation": "But tell me, heavy though it be."}, {"id": "de-quote126", "translation": "May it be so, then."}, {"id": "de-quote127", "translation": "He endured, then."}, {"id": "de-quote128", "translation": "May it be, then."}, {"id": "de-quote129", "translation": "If, then, any ray of the sun sees him."}, {"id": "de-quote130", "translation": "If, then, necessity is."}, {"id": "de-quote131", "translation": "If, then, you will exchange the throw."}, {"id": "de-quote132", "translation": "You, then, pursue."}, {"id": "de-quote133", "translation": "You, then, might remain."}, {"id": "de-quote134", "translation": "And I include you among these."}, {"id": "de-quote135", "translation": "And it is necessary to address her with all words of greeting."}, {"id": "de-quote136", "translation": "And I, lamenting the fate of the departed—"}, {"id": "de-quote137", "translation": "And I obtained the lot I wanted."}, {"id": "de-quote138", "translation": "And indeed there is need of one in his prime."}, {"id": "de-quote139", "translation": "Standing near and standing far off."}, {"id": "de-quote140", "translation": "And then he will go."}, {"id": "de-word1", "translation": "but"}, {"id": "de-word2", "translation": "conjunctions making a transition"}, {"id": "de-word3", "translation": "transitional conjunction"}, {"id": "de-word4", "translation": "and/but"}, {"id": "de-word5", "translation": "and"}, {"id": "de-word6", "translation": "for"}, {"id": "de-word7", "translation": "and/but"}, {"id": "de-word8", "translation": "for there is leisure"}, {"id": "de-word9", "translation": "but there is leisure"}, {"id": "de-word10", "translation": "not by force"}, {"id": "de-word11", "translation": "but by guile"}, {"id": "de-word12", "translation": "but by guile"}, {"id": "de-word13", "translation": "and/but"}, {"id": "de-word14", "translation": "and/but"}, {"id": "de-word15", "translation": "and/but"}, {"id": "de-word16", "translation": "and/but"}, {"id": "de-word17", "translation": "but my mother"}, {"id": "de-word18", "translation": "my mother at least"}, {"id": "de-word19", "translation": "the fate of Orestes"}, {"id": "de-word20", "translation": "but the fate"}, {"id": "de-word21", "translation": "and/but"}, {"id": "de-word22", "translation": "my father's new wife, and my mistress"}, {"id": "de-word23", "translation": "woman"}, {"id": "de-word24", "translation": "mistress"}, {"id": "de-word25", "translation": "and/but"}, {"id": "de-word26", "translation": "for having betrayed his own children and my mistress"}, {"id": "de-word27", "translation": "and/but"}, {"id": "de-word28", "translation": "on the one hand"}, {"id": "de-word29", "translation": "on the one hand"}, {"id": "de-word30", "translation": "and/but"}, {"id": "de-word31", "translation": "since"}, {"id": "de-word32", "translation": "and/but"}, {"id": "de-word33", "translation": "having been conquered"}, {"id": "de-word34", "translation": "but whenever"}, {"id": "de-word35", "translation": "I sob"}, {"id": "de-word36", "translation": "as"}, {"id": "de-word37", "translation": "but they themselves were struck"}, {"id": "de-word38", "translation": "help—was present"}, {"id": "de-word39", "translation": "but when it had gathered"}, {"id": "de-word40", "translation": "on the one hand"}, {"id": "de-word41", "translation": "on the one hand"}, {"id": "de-word42", "translation": "and/but"}, {"id": "de-word43", "translation": "on the one hand"}, {"id": "de-word44", "translation": "and/but"}, {"id": "de-word45", "translation": "on the one hand"}, {"id": "de-word46", "translation": "on the one hand"}, {"id": "de-word47", "translation": "and/but"}, {"id": "de-word48", "translation": "and/but"}, {"id": "de-word49", "translation": "on the one hand"}, {"id": "de-word50", "translation": "No"}, {"id": "de-word51", "translation": "on the one hand"}, {"id": "de-word52", "translation": "and/but"}, {"id": "de-word53", "translation": "on the one hand—on the other hand"}, {"id": "de-word54", "translation": "on the one hand"}, {"id": "de-word55", "translation": "and/but"}, {"id": "de-word56", "translation": "but to you, Hephaestus"}, {"id": "de-word57", "translation": "being"}, {"id": "de-word58", "translation": "so that"}, {"id": "de-word59", "translation": "and/but"}, {"id": "de-word60", "translation": "but would"}, {"id": "de-word61", "translation": "flowing from slender eyes"}, {"id": "de-word62", "translation": "for"}, {"id": "de-word63", "translation": "but again"}, {"id": "de-word64", "translation": "on the one hand"}, {"id": "de-word65", "translation": "but at least"}, {"id": "de-word66", "translation": "but—at least"}, {"id": "de-word67", "translation": "and"}, {"id": "de-word68", "translation": "grant fair strength"}, {"id": "de-word69", "translation": "and grant"}, {"id": "de-word70", "translation": "but indeed"}, {"id": "de-word71", "translation": "longing"}, {"id": "de-word72", "translation": "then"}, {"id": "de-word73", "translation": "and indeed"}, {"id": "de-word74", "translation": "and I marched out"}, {"id": "de-word75", "translation": "from afar"}, {"id": "de-word76", "translation": "and even now"}, {"id": "de-word77", "translation": "and a new"}, {"id": "dedia_dedoika-orth1", "translation": "I fear"}, {"id": "dedia_dedoika-def1", "translation": "I fear."}, {"id": "dedia_dedoika-note1", "translation": "[perfect from a present δείδω [I fear], which the grammarians invented though it is nowhere read. Aeschylus, besides these two perfect forms, used the aorist ἔδεισα [I feared]]"}, {"id": "dedia_dedoika-note2", "translation": "in words inserted by an interpolator, about which I spoke in the Preface to the London edition of Prometheus, 1866, p. XV.]"}, {"id": "dedia_dedoika-quote1", "translation": "I fear for your fortunes."}, {"id": "dedia_dedoika-quote2", "translation": "I do not fear"}, {"id": "dedia_dedoika-quote3", "translation": "I fear; a crash is owed at the gates."}, {"id": "dedia_dedoika-quote4", "translation": "I fear that the city may be subdued along with its kings."}, {"id": "dedia_dedoika-quote5", "translation": "I fear that the great toil of wealth may become the plunder of the one who came first."}, {"id": "dedia_dedoika-quote6", "translation": "I fear the crash of rain."}, {"id": "dedia_dedoika-quote7", "translation": "Who among mortals does not revere and fear these things?"}, {"id": "dedia_dedoika-quote8", "translation": "fearing nothing.]"}, {"id": "dedia_dedoika-quote9", "translation": "I fear the very foolish fate of the moth."}, {"id": "dedia_dedoika-quote10", "translation": "Fearing greater evil for house and city."}, {"id": "dedia_dedoika-quote11", "translation": "I feared when I heard the chariot-clattering din, the din."}, {"id": "dedia_dedoika-quote12", "translation": "Did you pray to the gods, fearing to do these things thus?"}, {"id": "dedia_dedoika-quote13", "translation": "For an old woman fearing nothing."}, {"id": "dedia_dedoika-quote14", "translation": "Fearing these tridents and the reverence of the gods."}, {"id": "dedia_dedoika-word1", "translation": "I fear"}, {"id": "dedia_dedoika-word2", "translation": "I feared"}, {"id": "dei-orth1", "translation": "it is necessary"}, {"id": "dei-def1", "translation": "See δέω."}, {"id": "dei-word1", "translation": "I bind"}, {"id": "deigma-orth1", "translation": "proof"}, {"id": "deigma-def1", "translation": "[Ag. 976 erroneously for δεῖμα [fear], which see]"}, {"id": "deigma-word1", "translation": "fear"}, {"id": "deido-orth1", "translation": "I fear"}, {"id": "deido-def1", "translation": "[See δέδια.]"}, {"id": "deido-word1", "translation": "I fear"}, {"id": "deiknymi-orth1", "translation": "I show"}, {"id": "deiknymi-def1", "translation": "I show, I display."}, {"id": "deiknymi-quote1", "translation": "to show the new plan"}, {"id": "deiknymi-quote2", "translation": "And I showed them the risings of the stars."}, {"id": "deiknymi-quote3", "translation": "Before I showed them mixtures of soothing remedies."}, {"id": "deiknymi-quote4", "translation": "Show, if you know."}, {"id": "deiknymi-quote5", "translation": "Show what time will be for the wretched woman."}, {"id": "deiknymi-quote6", "translation": "No god could show him clearly a way out of such toils except me."}, {"id": "deiknymi-quote7", "translation": "Show that you love the city."}, {"id": "deiknymi-quote8", "translation": "You showed me from exile."}, {"id": "deiknymi-quote9", "translation": "Show the covering of the man."}, {"id": "deiknymi-quote10", "translation": "When shall we show the strength of our mouths for Orestes?"}, {"id": "deiknymi-quote11", "translation": "I will show you a proof of this word."}, {"id": "deilaios-orth1", "translation": "wretched"}, {"id": "deilaios-def1", "translation": "wretched."}]}