{"units": [{"id": "τίς_quis-quote374", "translation": "some wrath or some resentment."}, {"id": "τίς_quis-quote375", "translation": "so that no house may prosper."}, {"id": "τίς_quis-quote376", "translation": "For if I shall see any guardian of the hearth alone."}, {"id": "τίς_quis-quote377", "translation": "some Ethiopian woman."}, {"id": "τίς_quis-quote378", "translation": "lest you create for the Danaans some adverse winds, long-lasting hindrances."}, {"id": "τίς_quis-quote379", "translation": "I hear that some strangers are speaking."}, {"id": "τίς_quis-quote380", "translation": "do not expect any end."}, {"id": "τίς_quis-quote381", "translation": "some cold fear falls upon my heart."}, {"id": "τίς_quis-quote382", "translation": "it brings some clear matter."}, {"id": "τίς_quis-quote383", "translation": "lest he add some evil to these things."}, {"id": "τίς_quis-quote384", "translation": "For if he knows some further remedy for evils."}, {"id": "τίς_quis-quote385", "translation": "some net of Hades,"}, {"id": "τίς_quis-quote386", "translation": "no wonder at all."}, {"id": "τίς_quis-quote387", "translation": "if there is any help for me."}, {"id": "τίς_quis-quote388", "translation": "if there is any dark hiding-place somewhere."}, {"id": "τίς_quis-quote389", "translation": "or is there something holy?"}, {"id": "τίς_quis-quote390", "translation": "sweet it is to stretch out a long life with bold hopes."}, {"id": "τίς_quis-quote391", "translation": "Or will you say that there is some remnant of troubles for this woman?"}, {"id": "τίς_quis-quote392", "translation": "If you have any remaining thing to tell this woman."}, {"id": "τίς_quis-quote393", "translation": "he sees something more than what is revealed."}, {"id": "τίς_quis-quote394", "translation": "if you saw anything worthless."}, {"id": "τίς_quis-quote395", "translation": "he has come to announce something new in any case."}, {"id": "τίς_quis-quote396", "translation": "say something else."}, {"id": "τίς_quis-quote397", "translation": "tell me something clear."}, {"id": "τίς_quis-quote398", "translation": "but a night-watching anxiety remains to hear something from me."}, {"id": "τίς_quis-quote399", "translation": "if you have anything superior to these things."}, {"id": "τίς_quis-quote400", "translation": "but if it is necessary to do something more deliberate."}, {"id": "τίς_quis-quote401", "translation": "something easy to learn."}, {"id": "τίς_quis-quote402", "translation": "unless you will provide something trustworthy for this expedition."}, {"id": "τίς_quis-quote403", "translation": "For if some new thing has not been planned by the gods."}, {"id": "τίς_quis-quote404", "translation": "For I will suffer no other thing greater than this."}, {"id": "τίς_quis-quote405", "translation": "but the highest is either some Apollo or Pan."}, {"id": "τίς_quis-quote406", "translation": "like some sun."}, {"id": "τίς_quis-quote407", "translation": "a two-headed serpent or some Scylla."}, {"id": "τίς_quis-quote408", "translation": "you are full of fear."}, {"id": "τίς_quis-quote409", "translation": "the sign-maker was not some cheap fellow after all."}, {"id": "τίς_quis-quote410", "translation": "or you are someone of great strength."}, {"id": "τίς_quis-quote411", "translation": "or this long-lived age has appeared as some..."}, {"id": "τίς_quis-quote412", "translation": "you are someone mad in mind."}, {"id": "τίς_quis-quote413", "translation": "some fire-kindled forethought"}, {"id": "τίς_quis-quote414", "translation": "was it some wild boar?"}, {"id": "τίς_quis-quote415", "translation": "how great a number of Greek ships was there?"}, {"id": "τίς_quis-quote416", "translation": "not many."}, {"id": "τίς_quis-quote417", "translation": "let one man cross the Lesbian wave."}, {"id": "τίς_quis-quote418", "translation": "a bow, as if someone stringing it."}, {"id": "τίς_quis-quote419", "translation": "everyone is ready."}, {"id": "τίς_quis-quote420", "translation": "for everyone is made delicate."}, {"id": "τίς_quis-quote421", "translation": "let everyone prepare."}, {"id": "τίς_quis-quote422", "translation": "for everyone bears goodwill to the weaker."}, {"id": "τίς_quis-quote423", "translation": "everyone is ready to speak."}, {"id": "τίς_quis-quote424", "translation": "everyone passing by."}, {"id": "τίς_quis-quote425", "translation": "if you also wish to toil at something."}, {"id": "τίς_quis-quote426", "translation": "if it does not harm in word."}, {"id": "τίς_quis-quote427", "translation": "lest you be harmed on the road."}, {"id": "τίς_quis-quote428", "translation": "did you perhaps advance beyond these things even further?"}, {"id": "τίς_quis-quote429", "translation": "do I seem to you to be afraid of anything?"}, {"id": "τίς_quis-quote430", "translation": "or do you blame me for some misfortune,"}, {"id": "τίς_quis-quote431", "translation": "or is your father tripped up in some plans?"}, {"id": "τίς_quis-quote432", "translation": "if one must trust in the oracles of the gods."}, {"id": "τίς_quis-quote433", "translation": "unless some ancient divinity has now changed for the army."}, {"id": "τίς_quis-quote434", "translation": "unless there is some hatred of the mind."}, {"id": "τίς_quis-quote435", "translation": "saying simply, whoever will kill in return."}, {"id": "τίς_quis-quote436", "translation": "I did not think that I would be wasted away by such punishments."}, {"id": "τίς_quis-quote437", "translation": "for it is not the same thing for a noble man to die."}, {"id": "τίς_quis-quote438", "translation": "nor does anyone sitting in the house flee the fated doom any more."}, {"id": "τίς_quis-quote439", "translation": "for you will not escape the fated thing any more."}, {"id": "τίς_quis-quote440", "translation": "I will not be caught by deceit."}, {"id": "τίς_quis-quote441", "translation": "I will never leave that man."}, {"id": "τίς_quis-word1", "translation": "of the"}, {"id": "τίς_quis-word2", "translation": "to the"}, {"id": "τίς_quis-word3", "translation": "what?"}, {"id": "τίς_quis-word4", "translation": "what from"}, {"id": "τίς_quis-word5", "translation": "what must one suspect from these things but griefs and misfortunes"}, {"id": "τίς_quis-word6", "translation": "what from"}, {"id": "τίς_quis-word7", "translation": "what then?"}, {"id": "τίς_quis-word8", "translation": "what from"}, {"id": "τίς_quis-word9", "translation": "all-lamenting"}, {"id": "τίς_quis-word10", "translation": "whither from these things?"}, {"id": "τίς_quis-word11", "translation": "for is there anything trustworthy?"}, {"id": "τίς_quis-word12", "translation": "who?"}, {"id": "τίς_quis-word13", "translation": "of what kind of thought?"}, {"id": "τίς_quis-word14", "translation": "of what kind?"}, {"id": "τίς_quis-word15", "translation": "what?"}, {"id": "τίς_quis-word16", "translation": "what?"}, {"id": "τίς_quis-word17", "translation": "what ever?"}, {"id": "τίς_quis-word18", "translation": "why?"}, {"id": "τίς_quis-word19", "translation": "what?"}, {"id": "τίς_quis-word20", "translation": "why indeed?"}, {"id": "τίς_quis-word21", "translation": "why not?"}, {"id": "τίς_quis-word22", "translation": "honor"}, {"id": "τίς_quis-word23", "translation": "why not?"}, {"id": "τίς_quis-word24", "translation": "why not?"}, {"id": "τίς_quis-word25", "translation": "what then?"}, {"id": "τίς_quis-word26", "translation": "what then does the heifer of Zeus pray for the cow?"}, {"id": "τίς_quis-word27", "translation": "who then?"}, {"id": "τίς_quis-word28", "translation": "who?"}, {"id": "τίς_quis-word29", "translation": "whoever"}, {"id": "τίς_quis-word30", "translation": "what would I become?"}, {"id": "τίς_quis-word31", "translation": "someone"}, {"id": "τίς_quis-word32", "translation": "of someone"}, {"id": "τίς_quis-word33", "translation": "to someone"}, {"id": "τίς_quis-word34", "translation": "someone"}, {"id": "τίς_quis-word35", "translation": "or of whom?"}, {"id": "τίς_quis-word36", "translation": "of no one"}, {"id": "τίς_quis-word37", "translation": "something"}, {"id": "τίς_quis-word38", "translation": "someone"}, {"id": "τίς_quis-word39", "translation": "never may a god or any man"}, {"id": "τίς_quis-word40", "translation": "human being"}, {"id": "τίς_quis-word41", "translation": "other"}, {"id": "τίς_quis-word42", "translation": "someone"}, {"id": "τίς_quis-word43", "translation": "or by some folly"}, {"id": "τίς_quis-word44", "translation": "such things as he will suffer"}, {"id": "τίς_quis-word45", "translation": "someone"}, {"id": "τίς_quis-word46", "translation": "thirst"}, {"id": "τίς_quis-word47", "translation": "full of wickedness"}, {"id": "τίς_quis-word48", "translation": "at least"}, {"id": "τίς_quis-word49", "translation": "someone"}, {"id": "τίς_quis-word50", "translation": "someone"}, {"id": "τίς_quis-word51", "translation": "fire-kindled"}, {"id": "τίς_quis-word52", "translation": "how much then?"}, {"id": "τίς_quis-word53", "translation": "something"}, {"id": "τιτάν-orth1", "translation": "Titan"}, {"id": "τιτάν-def1", "translation": "Titan"}]}