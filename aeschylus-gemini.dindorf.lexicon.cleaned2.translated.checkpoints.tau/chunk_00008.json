{"units": [{"id": "te-quote86", "translation": "over the sea and the sea-girt cities."}, {"id": "te-quote87", "translation": "among the younger and the older gods."}, {"id": "te-quote88", "translation": "with good repute and a report free from wrath."}, {"id": "te-quote89", "translation": "and from the sea."}, {"id": "te-quote90", "translation": "and the Magnesian land and to the country of the Macedonians,"}, {"id": "te-quote91", "translation": "before the eyes."}, {"id": "te-quote92", "translation": "over the sea."}, {"id": "te-quote93", "translation": "from the earth and from the sea dew."}, {"id": "te-quote94", "translation": "among the immortals and those beneath the earth."}, {"id": "te-quote95", "translation": "with inviolability from mortals."}, {"id": "te-quote96", "translation": "and always you are pitiless and full of boldness,"}, {"id": "te-quote97", "translation": "but well did he send, and well may the land receive him."}, {"id": "te-quote98", "translation": "when (sic from the copy for ὅτι τε [that]) the curved pipes sounded, and they heard the divine mouthpieces of the horse-guiding, fire-thundering bridles."}, {"id": "te-quote99", "translation": "as both the city and justice approve together."}, {"id": "te-quote100", "translation": "for he says that if a god is willing, he will sack the city, and if not willing."}, {"id": "te-quote101", "translation": "telling of the capture and the destruction of Ilium."}, {"id": "te-quote102", "translation": "and they pitied me and dear Orestes."}, {"id": "te-quote103", "translation": "my image and this stranger seated upon it, and you."}, {"id": "te-quote104", "translation": "and by force."}, {"id": "te-quote105", "translation": "and out of the house."}, {"id": "te-quote106", "translation": "and to the sweet-drinking stream of Cenchreae."}, {"id": "te-quote107", "translation": "and with a storm."}, {"id": "te-quote108", "translation": "and to the city and the gods."}, {"id": "te-quote109", "translation": "apart from foot-wipers and the embroidered things."}, {"id": "te-quote110", "translation": "around Cocytus and the Acherusian banks."}, {"id": "te-quote111", "translation": "and with the entrails."}, {"id": "te-quote112", "translation": "and from the city and the house."}, {"id": "te-quote113", "translation": "and from heaven."}, {"id": "te-quote114", "translation": "with youths and maidens."}, {"id": "te-quote115", "translation": "and in ambush."}, {"id": "te-quote116", "translation": "and of the enemies of Zeus."}, {"id": "te-quote117", "translation": "and the steep-backed one."}, {"id": "te-quote118", "translation": "and the ill-sounding hymn."}, {"id": "te-quote119", "translation": "and that of Darius and mine."}, {"id": "te-quote120", "translation": "and to the slayers."}, {"id": "te-quote121", "translation": "and the suppliant."}, {"id": "te-quote122", "translation": "and of justice (θ᾽ [and] added by Wellauer)."}, {"id": "te-quote123", "translation": "and the whole."}, {"id": "te-quote124", "translation": "and of him who rolls around the whole earth."}, {"id": "te-quote125", "translation": "and to the whole."}, {"id": "te-word1", "translation": "and"}, {"id": "te-word2", "translation": "and"}, {"id": "te-word3", "translation": "this is that which when around"}, {"id": "te-word4", "translation": "this is that when then around"}, {"id": "te-word5", "translation": "and"}, {"id": "te-word6", "translation": "of the marriage bed"}, {"id": "te-word7", "translation": "garlands and a gift"}, {"id": "te-word8", "translation": "garlands, a gift at least"}, {"id": "te-word9", "translation": "friends and"}, {"id": "te-word10", "translation": "and also"}, {"id": "te-word11", "translation": "he has fallen from the nets and is gone"}, {"id": "te-word12", "translation": "and is gone) the beast"}, {"id": "te-word13", "translation": "to remain and to send"}, {"id": "te-word14", "translation": "but) these"}, {"id": "te-word15", "translation": "and the unwomanly flesh-eating"}, {"id": "