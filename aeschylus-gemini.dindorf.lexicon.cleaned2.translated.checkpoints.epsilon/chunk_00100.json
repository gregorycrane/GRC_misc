{"units": [{"id": "euphilopais-quote1", "translation": "gentle, loving children, and pleasing to the aged"}, {"id": "euphoretos-orth1", "translation": "easily borne"}, {"id": "euphoretos-def1", "translation": "easily borne"}, {"id": "euphoretos-quote1", "translation": "a tomb easily borne for the house of a land across the sea"}, {"id": "euphorion-orth1", "translation": "Euphorion"}, {"id": "euphorion-def1", "translation": "Euphorion, father of Aeschylus"}, {"id": "euphorion-note1", "translation": "in an elegy"}, {"id": "euphorion-quote1", "translation": "Aeschylus, son of Euphorion"}, {"id": "euphraino-orth1", "translation": "to gladden"}, {"id": "euphraino-def1", "translation": "to gladden"}, {"id": "euphraino-quote1", "translation": "surely when he hears, he will gladden his heart"}, {"id": "euphraino-quote2", "translation": "you, both in word and deed, gladden my heart"}, {"id": "euphrone-orth1", "translation": "night"}, {"id": "euphrone-def1", "translation": "night"}, {"id": "euphrone-quote1", "translation": "with such dreams I, wretched, was held fast all night long"}, {"id": "euphrone-quote2", "translation": "of the night before"}, {"id": "euphrone-quote3", "translation": "by night"}, {"id": "euphrone-quote4", "translation": "bringing good news – until he should come from his mother's night"}, {"id": "euphrone-quote5", "translation": "of the night that has now given birth to this light"}, {"id": "euphrone-quote6", "translation": "they will sleep unguarded all night long"}, {"id": "euphrone-quote7", "translation": "bringing light in the night"}, {"id": "euphrone-quote8", "translation": "both day and night alike"}, {"id": "euphronos-orth1", "translation": "kindly"}, {"id": "euphronos-def1", "translation": "kindly"}, {"id": "euphronos-quote1", "translation": "but do you gently soothe him with kindly words"}, {"id": "euphronos-quote2", "translation": "you speak kindly, as befits a prudent man"}, {"id": "euphronos-quote3", "translation": "kindly we shall try to avert the pain of the disease"}, {"id": "euphrosyne-orth1", "translation": "joy"}, {"id": "euphrosyne-def1", "translation": "joy"}, {"id": "euphrosyne-quote1", "translation": "nourishing the heart with joys in the torchlight"}, {"id": "euphron-orth1", "translation": "kindly, well-disposed"}, {"id": "euphron-def1", "translation": "kindly, well-disposed"}, {"id": "euphron-def2", "translation": "pleasing, welcome"}, {"id": "euphron-def3", "translation": "well-conceived, right"}, {"id": "euphron-note1", "translation": "For thus I corrected what is in M τόσσων περ εὔφρων [so many kindly], about which I spoke in the Preface to the fifth Leipzig edition p. LXXXIV."}, {"id": "euphron-note2", "translation": "where the next verse has fallen out, in which a substantive was read joined with εὔφροσιν [kindly ones]."}, {"id": "euphron-note3", "translation": "restored for εὐθύφρονι [straight-minded] and εὐθύφρονες [straight-minded ones]."}, {"id": "euphron-note4", "translation": "εὔφρονα [kindly] corruptly for ἔμφρονα [sensible]. See ἔμφρων [sensible]."}, {"id": "euphron-quote1", "translation": "to be kindly escorts over the earth"}, {"id": "euphron-quote2", "translation": "for the god did not hate him, since he was kindly"}, {"id": "euphron-quote3", "translation": "from kindly eyes"}, {"id": "euphron-quote4", "translation": "may I hear kindly"}, {"id": "euphron-quote5", "translation": "from a kindly mind"}, {"id": "euphron-quote6", "translation": "speak, pouring forth holy words to the kindly ones"}, {"id": "euphron-quote7", "translation": "having received the best things, better for the kindly ones"}, {"id": "euphron-quote8", "translation": "for these kindly ones, always greatly honoring them, kindly ones"}, {"id": "euphron-quote9", "translation": "kindly is this company"}, {"id": "euphron-quote10", "translation": "to what kinder land than this could we come?"}, {"id": "euphron-quote11", "translation": "renew a kindly tale"}, {"id": "euphron-quote12", "translation": "they cast a kindly vote"}, {"id": "euphron-quote13", "translation": "where one must dwell and a kindly place"}, {"id": "euphron-quote14", "translation": "this kindly ordinance"}, {"id": "euphron-quote15", "translation": "with kindly escort"}, {"id": "euphron-quote16", "translation": "kindly land"}, {"id": "euphron-quote17", "translation": "kindly toil for those who have completed it well"}, {"id": "euphron-quote18", "translation": "O kindly light of the day that brings justice"}, {"id": "euphron-quote19", "translation": "how shall I speak kindly?"}, {"id": "euphron-quote20", "translation": "nor is this kindly, to dishonor these prayers"}, {"id": "euphron-word1", "translation": "M τόσσων περ εὔφρων [so many kindly]"}, {"id": "euphron-word2", "translation": "εὔφροσιν [kindly ones]"}, {"id": "euphron-word3", "translation": "εὐθύφρονι [straight-minded]"}, {"id": "euphron-word4", "translation": "εὐθύφρονες [straight-minded ones]"}, {"id": "euphron-word5", "translation": "εὔφρονα [kindly]"}, {"id": "euphron-word6", "translation": "ἔμφρονα [sensible]"}, {"id": "euphron-word7", "translation": "ἔμφρων [sensible]"}, {"id": "euphylaktos-orth1", "translation": "easy to guard"}, {"id": "euphylaktos-def1", "translation": "easy to guard"}, {"id": "euphylaktos-quote1", "translation": "tender fruit is not at all easy to guard"}, {"id": "euphonos-orth1", "translation": "having a good or sweet voice"}, {"id": "euphonos-def1", "translation": "having a good or sweet voice"}, {"id": "euphonos-quote1", "translation": "a chorus in unison, not sweet-voiced"}, {"id": "euxalkos-orth1", "translation": "well-wrought of bronze"}, {"id": "euxalkos-def1", "translation": "well-wrought of bronze"}, {"id": "euxalkos-quote1", "translation": "he leaped up from the hollow well-wrought helmet"}, {"id": "euxalkos-quote2", "translation": "with well-wrought bronze arms"}, {"id": "euxeirotos-orth1", "translation": "easy to subdue or overcome"}, {"id": "euxeirotos-def1", "translation": "easy to subdue or overcome"}, {"id": "euxeirotos-quote1", "translation": "the army of the Greeks easy to subdue"}, {"id": "euxereia-orth1", "translation": "ease, facility"}, {"id": "euxereia-def1", "translation": "ease, facility"}, {"id": "euxereia-quote1", "translation": "this deed will now easily unite all mortals"}, {"id": "euxhe-orth1", "translation": "prayer, vow"}, {"id": "euxhe-def1", "translation": "prayer, vow"}, {"id": "euxhe-quote1", "translation": "borne along according to their father's ill-fated prayers"}, {"id": "euxhe-quote2", "translation": "the father spoke to the servants after the prayer"}, {"id": "euxhe-quote3", "translation": "Zeus, fulfiller, fulfill my prayers"}, {"id": "euxhe-quote4", "translation": "to hear my prayers"}, {"id": "euxhe-quote5", "translation": "these prayers of ours"}, {"id": "euxhe-quote6", "translation": "with such prayers I pour these libations"}, {"id": "euxhe-quote7", "translation": "announcing prayers that bring fulfillment to the gods"}, {"id": "euxhe-quote8", "translation": "first with this prayer I honor the gods, Earth the first prophet"}, {"id": "euxhe-quote9", "translation": "these gods I invoke in my prayers"}, {"id": "euxhe-quote10", "translation": "let us utter good prayers for the Argives"}, {"id": "euxhe-quote11", "translation": "let a prayer that loves honor fly from our mouths"}, {"id": "euxhe-quote12", "translation": "I praise these prudent prayers"}, {"id": "euxhe-quote13", "translation": "with prayers"}, {"id": "euxhe-quote14", "translation": "may you save your masters with healing prayers"}, {"id": "euchomai-orth1", "translation": "to pray, to vow"}]}