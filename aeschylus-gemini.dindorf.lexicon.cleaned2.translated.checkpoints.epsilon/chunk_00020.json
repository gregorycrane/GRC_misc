{"units": [{"id": "eimi_sum-word4", "translation": "I am, you are, he/she/it is"}, {"id": "eimi_sum-word5", "translation": "where is"}, {"id": "eimi_sum-word6", "translation": "and is"}, {"id": "eimi_sum-word7", "translation": "to me is"}, {"id": "eimi_sum-word8", "translation": "and is"}, {"id": "eimi_sum-word9", "translation": "to me is"}, {"id": "eimi_sum-word10", "translation": "you two are"}, {"id": "eimi_sum-word11", "translation": "these are two outlines of feet"}, {"id": "eimi_sum-word12", "translation": "we are, you are, they are"}, {"id": "eimi_sum-word13", "translation": "be!"}, {"id": "eimi_sum-word14", "translation": "let it be"}, {"id": "eimi_sum-word15", "translation": "be!"}, {"id": "eimi_sum-word16", "translation": "I would be, you would be, he/she/it would be"}, {"id": "eimi_sum-word17", "translation": "being"}, {"id": "eimi_sum-word18", "translation": "to be"}, {"id": "eimi_sum-word19", "translation": "to be"}, {"id": "eimi_sum-word20", "translation": "or"}, {"id": "eimi_sum-word21", "translation": "he/she/it was present"}, {"id": "eimi_sum-word22", "translation": "you are present"}, {"id": "eimi_sum-word23", "translation": "you were, he/she/it was"}, {"id": "eimi_sum-word24", "translation": "he/she/it was"}, {"id": "eimi_sum-word25", "translation": "we were, you were, they were"}, {"id": "eimi_sum-word26", "translation": "I will be"}, {"id": "eimi_sum-word27", "translation": "you will be"}, {"id": "eimi_sum-word28", "translation": "you will be"}, {"id": "eimi_sum-word29", "translation": "or"}, {"id": "eimi_sum-word30", "translation": "he/she/it will be"}, {"id": "eimi_sum-word31", "translation": "he/she/it will be"}, {"id": "eimi_sum-word32", "translation": "he/she/it will be"}, {"id": "eimi_sum-word33", "translation": "to be about to be"}, {"id": "eimi_sum-word34", "translation": "I am"}, {"id": "eimi_sum-word35", "translation": "I am"}, {"id": "eimi_sum-word36", "translation": "if"}, {"id": "eimi_sum-word37", "translation": "I am ready, he/she/it is ready"}, {"id": "eimi_sum-word38", "translation": "I am prudent, he/she/it is prudent"}, {"id": "eimi_sum-word39", "translation": "he/she/it is"}, {"id": "eimi_sum-word40", "translation": "he/she/it is"}, {"id": "eimi_sum-word41", "translation": "but"}, {"id": "eimi_sum-word42", "translation": "this"}, {"id": "eimi_sum-word43", "translation": "if, and, not, not, as, indeed, that"}, {"id": "eimi_sum-word44", "translation": "there is someone who, there is a time when, there is a place where, there is a way how, there is a way in which"}, {"id": "eimi_sum-word45", "translation": "if, not truly"}, {"id": "eimi_sum-word46", "translation": "but, this, and, not, indeed, that"}, {"id": "eimi_sum-word47", "translation": "he/she/it would be"}, {"id": "eimi_sum-word48", "translation": "let it be"}, {"id": "eimi_sum-word49", "translation": "being"}, {"id": "eimi_sum-word50", "translation": "being"}, {"id": "eimi_sum-word51", "translation": "of those being"}, {"id": "eimi_sum-word52", "translation": "being"}, {"id": "eimi_sum-word53", "translation": "being"}, {"id": "eimi_sum-word54", "translation": "of her being"}, {"id": "eimi_sum-word55", "translation": "to be"}, {"id": "eimi_sum-word56", "translation": "he/she/it was"}, {"id": "eimi_sum-word57", "translation": "he/she/it will be"}, {"id": "eimi_sum-word58", "translation": "I am"}, {"id": "eimi_sum-word59", "translation": "you are"}, {"id": "eimi_sum-word60", "translation": "he/she/it is"}, {"id": "eimi_sum-word61", "translation": "you two are"}, {"id": "eimi_sum-word62", "translation": "we are"}, {"id": "eimi_sum-word63", "translation": "you are"}, {"id": "eimi_sum-word64", "translation": "they are"}, {"id": "eimi_sum-word65", "translation": "O"}, {"id": "eimi_sum-word66", "translation": "or"}, {"id": "eimi_sum-word67", "translation": "I would be"}, {"id": "eimi_sum-word68", "translation": "you would be"}, {"id": "eimi_sum-word69", "translation": "he/she/it would be"}, {"id": "eimi_sum-word70", "translation": "they would be"}, {"id": "eimi_sum-word71", "translation": "be!"}, {"id": "eimi_sum-word72", "translation": "let it be"}, {"id": "eimi_sum-word73", "translation": "be!"}, {"id": "eimi_sum-word74", "translation": "you are"}, {"id": "eimi_sum-word75", "translation": "being"}, {"id": "eimi_sum-word76", "translation": "to him being"}, {"id": "eimi_sum-word77", "translation": "being"}, {"id": "eimi_sum-word78", "translation": "being"}, {"id": "eimi_sum-word79", "translation": "being"}, {"id": "eimi_sum-word80", "translation": "being (fem. nom. sg.)"}, {"id": "eimi_sum-word81", "translation": "to be"}, {"id": "eimi_sum-word82", "translation": "or"}, {"id": "eimi_sum-word83", "translation": "you were"}, {"id": "eimi_sum-word84", "translation": "whom (fem. acc. sg.)"}, {"id": "eimi_sum-word85", "translation": "was"}, {"id": "eimi_sum-word86", "translation": "was (epic)"}, {"id": "eimi_sum-word87", "translation": "you were (pl.)"}, {"id": "eimi_sum-word88", "translation": "they were"}, {"id": "eimi_sum-word89", "translation": "I will be"}, {"id": "eimi_sum-word90", "translation": "you will be"}, {"id": "eimi_sum-word91", "translation": "you will be"}, {"id": "eimi_sum-word92", "translation": "he/she/it will be"}, {"id": "eimi_sum-word93", "translation": "to be going to be"}, {"id": "eimi_sum-word94", "translation": "I am"}, {"id": "eimi_sum-word95", "translation": "Chalcidian form"}, {"id": "eimi_sum-word96", "translation": "What strange thing is present for the city?"}, {"id": "eimi_sum-word97", "translation": "being present"}, {"id": "eimi_sum-word98", "translation": "more"}, {"id": "eimi_sum-word99", "translation": "being"}, {"id": "eimi_sum-word100", "translation": "again"}, {"id": "eimi_sum-word101", "translation": "of a god"}, {"id": "eimi_sum-word102", "translation": "is"}, {"id": "eimi_sum-word103", "translation": "is"}, {"id": "eimi_sum-word104", "translation": "is"}, {"id": "eimi_sum-word105", "translation": "there is no one who, there is no place where"}, {"id": "eipein_xref-orth1", "translation": "to say"}, {"id": "eipein_xref-note1", "translation": "See ἐρεῖν [to say]."}, {"id": "eipein_xref-word1", "translation": "to say"}, {"id": "eiper-orth1", "translation": "if indeed"}, {"id": "eiper-def1", "translation": "if indeed, sometimes with ye added, either with no word or one or two words interposed. It is construed with the indicative present, perfect, future."}, {"id": "eiper-def2", "translation": "With the imperfect when the matter is dealt with contrary to what is pretended"}, {"id": "eiper-def3", "translation": "With the optative"}, {"id": "eiper-note1", "translation": "where φέρει [brings] many copies."}, {"id": "eiper-quote1", "translation": "Show, if indeed you know."}, {"id": "eiper-quote2", "translation": "But if you know, tell me these things, for I am willing."}, {"id": "eiper-quote3", "translation": "And if indeed these things are so, the chosen multitude of the army is lacking."}, {"id": "eiper-quote4", "translation": "If indeed the city of Ilium has been taken."}, {"id": "eiper-quote5", "translation": "If anyone, knowing well, I have spoken this end."}, {"id": "eiper-quote6", "translation": "If indeed she is not—possessing a barbarian voice."}, {"id": "eiper-quote7", "translation": "No, if indeed it will be."}, {"id": "eiper-quote8", "translation": "And in mine, if indeed in yours."}, {"id": "eiper-quote9", "translation": "Why do you keep the suppliant from the gates, if Aegisthus knows he is abroad?"}, {"id": "eiper-quote10", "translation": "This third libation I call upon the house, if indeed it is hospitable, the might of Aegisthus."}, {"id": "eiper-quote11", "translation": "To take equal grips in return, if indeed, having been defeated, you wish to win in return."}, {"id": "eiper-quote12", "translation": "Defend against this blame, if indeed—you sit."}, {"id": "eiper-quote13", "translation": "If indeed it was cut from an enemy's head."}, {"id": "eiper-quote14", "translation": "If indeed he was a partner in affairs from the beginning."}, {"id": "eiper-quote15", "translation": "If someone bears evil without shame, let it be."}, {"id": "eiper-quote16", "translation": "You would lead, if indeed a pious word should persuade."}, {"id": "eiper-word1", "translation": "brings"}, {"id": "eirgo-orth1", "translation": "to keep away"}, {"id": "eirgo-def1", "translation": "I keep away"}, {"id": "eirgo-note1", "translation": "where στυγῶν [hating] is in M, rightly changed by Wakefield to στέγων [covering], whose gloss is εἴργων [keeping away], which is read in the copies."}, {"id": "eirgo-note2", "translation": "where Victorius has εἰργομένα [being kept away], Hermannus ἀπὸ χλωρῶν πετάλων ἐγρομένα [rising from green leaves]. The scholiast explains it by διωκομένη [being pursued]."}, {"id": "eirgo-quote1", "translation": "Justice of kindred blood greatly commands him to keep away the hostile spear from his mother who bore him."}, {"id": "eirgo-quote2", "translation": "Hating the man's violence, she will keep him away from her young like a hostile serpent."}, {"id": "eirgo-quote3", "translation": "For keeping enemies away, he chose death in the city."}, {"id": "eirgo-quote4", "translation": "To keep away the irresistible wave of the sea with strong barriers."}, {"id": "eirgo-quote5", "translation": "But if the appointed fate from the gods did not prevent fate from bringing more."}, {"id": "eirgo-quote6", "translation": "No one of those pointed at by fingers, having forbidden, keeps me away from the halls."}, {"id": "eirgo-quote7", "translation": "Of the marriage bed, which custom keeps away."}, {"id": "eirgo-quote8", "translation": "It is a grief for women to be kept away from their husband."}, {"id": "eirgo-quote9", "translation": "Being kept away from the lands and rivers."}, {"id": "eirgo-word1", "translation": "hating"}, {"id": "eirgo-word2", "translation": "covering"}, {"id": "eirgo-word3", "translation": "keeping away"}, {"id": "eirgo-word4", "translation": "being kept away"}, {"id": "eirgo-word5", "translation": "rising from green leaves"}, {"id": "eirgo-word6", "translation": "being pursued"}, {"id": "eirene-orth1", "translation": "peace"}, {"id": "eirene-def1", "translation": "peace"}, {"id": "eirene-quote1", "translation": "He made peace for all his friends."}, {"id": "heis-orth1", "translation": "one"}, {"id": "heis-def1", "translation": "one"}, {"id": "heis-note1", "translation": "where πολύς [much] is written above the line in M. I conjectured πᾶσαν εἷς κατὰ πτόλιν [one throughout the whole city]."}]}