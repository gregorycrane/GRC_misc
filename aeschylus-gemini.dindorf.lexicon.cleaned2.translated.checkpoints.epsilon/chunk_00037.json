{"units": [{"id": "ekprepes-note1", "translation": "where some copies have εὐπρεπεστάτω [most comely]."}, {"id": "ekprepes-quote1", "translation": "excellent in soul and conspicuous in noble birth."}, {"id": "ekprepes-quote2", "translation": "and in size far the most conspicuous of those now living,"}, {"id": "ekprepes-word1", "translation": "most comely"}, {"id": "ekregnymai-orth1", "translation": "to burst forth"}, {"id": "ekregnymai-def1", "translation": "to burst forth"}, {"id": "ekregnymai-quote1", "translation": "from there rivers of fire will one day burst forth."}, {"id": "ekripto-orth1", "translation": "to cast forth"}, {"id": "ekripto-def1", "translation": "to cast forth"}, {"id": "ekripto-quote1", "translation": "hurling such words."}, {"id": "eksozomai-orth1", "translation": "to save (from danger)"}, {"id": "eksozomai-def1", "translation": "to save (from danger)"}, {"id": "eksozomai-quote1", "translation": "they might save their lives by secret flight."}, {"id": "eksozomai-quote2", "translation": "when the enemy, their ships destroyed, might save themselves on the island."}, {"id": "ekteino-orth1", "translation": "to stretch out"}, {"id": "ekteino-def1", "translation": "to stretch out"}, {"id": "ekteino-def2", "translation": "Of a longer speech"}, {"id": "ekteino-quote1", "translation": "You will not kick against the goads."}, {"id": "ekteino-quote2", "translation": "Stretch him out."}, {"id": "ekteino-quote3", "translation": "I have stretched out this prelude to the gods."}, {"id": "ekteino-quote4", "translation": "For you have stretched it out at length."}, {"id": "ekteino-quote5", "translation": "the tongue of a hateful bitch, speaking and stretching out to gladden the mind."}, {"id": "ekteino-quote6", "translation": "I stretched out such a length of speech."}, {"id": "ekteino-quote7", "translation": "I stretched out this advice to my citizens."}, {"id": "ekteino-quote8", "translation": "I did not stretch out my hand."}, {"id": "ekteleutao-orth1", "translation": "to bring to an end, accomplish, complete"}, {"id": "ekteleutao-def1", "translation": "to bring to an end, accomplish, complete"}, {"id": "ekteleutao-def2", "translation": "Intransitively, to come to an end"}, {"id": "ekteleutao-quote1", "translation": "having completed a long length of time, I boasted that the gods would bring these things to completion."}, {"id": "ekteleutao-quote2", "translation": "so that he may bring these things to a good end without harm."}, {"id": "ekteleo-orth1", "translation": "to accomplish"}, {"id": "ekteleo-def1", "translation": "to accomplish"}, {"id": "ekteleo-quote1", "translation": "the good things were being accomplished."}, {"id": "ekteles-orth1", "translation": "perfect"}, {"id": "ekteles-def1", "translation": "perfect"}, {"id": "ekteles-note1", "translation": "where Auratus correctly has ἐντελέων [bringing to fulfillment]."}, {"id": "ekteles-quote1", "translation": "may the good things be brought to fulfillment for you and your children."}, {"id": "ekteles-quote2", "translation": "the auspicious power of men bringing to fulfillment."}, {"id": "ekteles-word1", "translation": "bringing to fulfillment"}, {"id": "ektenes_corrupt-orth1", "translation": "corruptly"}, {"id": "ektenes_corrupt-note1", "translation": "Corruptly Suppl. 983 πρὸς τοὺς ἐκτενεῖς φίλους [toward the zealous friends], where Heath restored ἐγγενεῖς [kinsmen]."}, {"id": "ektenes_corrupt-word1", "translation": "toward the zealous friends"}, {"id": "ektenes_corrupt-word2", "translation": "kinsmen"}, {"id": "ekteko-orth1", "translation": "to melt"}, {"id": "ekteko-def1", "translation": "to melt"}, {"id": "ekteko-note1", "translation": "Improperly"}, {"id": "ekteko-note2", "translation": "i.e. may it never slip from the mind."}, {"id": "ekteko-note3", "translation": "Similarly Critias in Athenaeus 10 p. 432e"}, {"id": "ekteko-quote1", "translation": "but may this remain with me and never melt away,"}, {"id": "ekteko-quote2", "translation": "forgetfulness melts away the memory of the mind."}, {"id": "ektino-orth1", "translation": "to pay, to atone"}, {"id": "ektino-def1", "translation": "to pay, to atone"}, {"id": "ektino-quote1", "translation": "paying fair recompense to Argos."}, {"id": "ektino-quote2", "translation": "the slayer pays."}, {"id": "ektino-quote3", "translation": "paying the penalty for the devices of a father's hand."}, {"id": "ektothen-orth1", "translation": "from outside"}, {"id": "ektothen-def1", "translation": "from outside"}, {"id": "ektothen-quote1", "translation": "and from outside the towers may Zeus strike them with his thunderbolt."}, {"id": "ektothen-quote2", "translation": "and from outside the lake."}, {"id": "ektothen-quote3", "translation": "not from others outside, but from themselves."}, {"id": "ektolypeuo-orth1", "translation": "to accomplish, to complete"}, {"id": "ektolypeuo-def1", "translation": "to accomplish, to complete"}, {"id": "ektolypeuo-quote1", "translation": "never hoping to accomplish anything timely."}, {"id": "ektos-orth1", "translation": "outside"}, {"id": "ektos-def1", "translation": "outside"}, {"id": "ektos-quote1", "translation": "being outside the statues."}, {"id": "ektos-quote2", "translation": "you are free from blame."}, {"id": "ektos-quote3", "translation": "to be free from blame | of evil."}, {"id": "ektrepo-orth1", "translation": "to turn away"}, {"id": "ektrepo-def1", "translation": "to turn away"}, {"id": "ektrepo-quote1", "translation": "turning away the spear-wrought evils upon the invaders of the land."}, {"id": "ektrepo-quote2", "translation": "do not turn your wrath upon Helen."}, {"id": "ektrepho-orth1", "translation": "to rear"}, {"id": "ektrepho-def1", "translation": "to rear"}, {"id": "ektrepho-quote1", "translation": "whom I reared, having received him from his mother."}, {"id": "ektrope-orth1", "translation": "turning aside"}, {"id": "ektrope-def1", "translation": "turning aside"}, {"id": "ektrope-note1", "translation": "Of escape"}, {"id": "ektrope-quote1", "translation": "an escape from such toils."}, {"id": "ektyphloo-orth1", "translation": "to blind"}, {"id": "ektyphloo-def1", "translation": "to blind"}, {"id": "ektyphloo-quote1", "translation": "many torches rose up, blinded by darkness."}, {"id": "ektor-orth1", "translation": "Hector"}, {"id": "ektor-def1", "translation": "Hector"}, {"id": "ektor-note1", "translation": "The Ransom of Hector or Phrygians was the title of a play of Aeschylus (fr. 254-268)."}, {"id": "ektor-quote1", "translation": "from where Hector brought you as his wife."}, {"id": "ektor-quote2", "translation": "by the fortune of Hector."}, {"id": "ektor-word1", "translation": "The Ransom of Hector"}, {"id": "ektor-word2", "translation": "Phrygians"}, {"id": "ekphanes-orth1", "translation": "visible, manifest"}, {"id": "ekphanes-def1", "translation": "visible, manifest"}, {"id": "ekphanes-quote1", "translation": "and quickly all were visible to see."}, {"id": "ekphanes-quote2", "translation": "this is a clear sign of the man."}, {"id": "ekphatos-orth1", "translation": "ineffably"}, {"id": "ekphatos-def1", "translation": "ineffably"}, {"id": "ekphatos-note1", "translation": "Others interpret it as with clear voice, Schneidewin as openly."}, {"id": "ekphatos-quote1", "translation": "honoring the bridal song ineffably."}, {"id": "ekpheugo-orth1", "translation": "to flee"}, {"id": "ekpheugo-def1", "translation": "to flee"}, {"id": "ekpheugo-note1", "translation": "as at 1044."}, {"id": "ekpheugo-quote1", "translation": "he would not escape his fate."}, {"id": "ekpheugo-quote2", "translation": "you would not escape evils,"}, {"id": "ekpheugo-quote3", "translation": "they have come having escaped."}, {"id": "ekpheugo-quote4", "translation": "we hear that the lord escaped on foot with little."}, {"id": "ekpheugo-quote5", "translation": "to escape necessity"}, {"id": "ekpheugo-quote6", "translation": "he has escaped the penalty for blood."}, {"id": "ekpheugo-quote7", "translation": "to escape the beds of men, unwedded, untamed."}, {"id": "ekphthino-orth1", "translation": "to destroy"}, {"id": "ekphthino-def1", "translation": "to destroy"}, {"id": "ekphthino-quote1", "translation": "the three-banked ships were destroyed."}]}